    <script>
      (function () {
        // #ads-agent-host is the shadow DOM host for Clarity's badge.
        // We hide it by scaling the HOST (not the internal badge) — Clarity doesn't watch host styles.
        // While chat is open we pause hiding so the user can interact normally.
        var _chatOpen = false;

        function hideHost() {
          if (_chatOpen) return;
          var host = document.getElementById('ads-agent-host');
          if (host && host.style.getPropertyValue('transform') !== 'scale(0)') {
            host.style.setProperty('transform', 'scale(0)', 'important');
            host.style.setProperty('pointer-events', 'none', 'important');
          }
        }

        hideHost();

        new MutationObserver(hideHost).observe(document.body, { childList: true });

        var _savedScrollY = 0;
        var _isMobile = window.matchMedia('(pointer: coarse)').matches;

        function lockBodyScroll() {
          _savedScrollY = window.scrollY || window.pageYOffset;
          if (_isMobile) {
            document.body.style.setProperty('position', 'fixed', 'important');
            document.body.style.setProperty('top', '-' + _savedScrollY + 'px', 'important');
            document.body.style.setProperty('width', '100%', 'important');
            document.body.style.setProperty('overflow-y', 'scroll', 'important');
          }
        }

        function unlockBodyScroll() {
          if (_isMobile) {
            document.body.style.removeProperty('position');
            document.body.style.removeProperty('top');
            document.body.style.removeProperty('width');
            document.body.style.removeProperty('overflow-y');
          }
          window.scrollTo(0, _savedScrollY);
        }

        function openClarityChat() {
          var host = document.getElementById('ads-agent-host');
          if (!host || !host.shadowRoot) return;
          var sr = host.shadowRoot;
          var ourBadge = document.getElementById('dl-clarity-badge');

          lockBodyScroll();
          _chatOpen = true;
          host.style.setProperty('transform', 'none', 'important');
          host.style.setProperty('pointer-events', 'auto', 'important');
          if (ourBadge) ourBadge.style.setProperty('display', 'none', 'important');

          var btn = sr.querySelector('[role="button"]');
          if (btn) {
            // Double rAF ensures the CSS lock is committed to the rendering engine
            // before Clarity's React processes the event and iOS can reset scroll.
            requestAnimationFrame(function() {
              requestAnimationFrame(function() {
                ['pointerdown','pointerup','click'].forEach(function(type) {
                  btn.dispatchEvent(new PointerEvent(type, { bubbles: true, cancelable: true, composed: true, view: window, isPrimary: true }));
                });
              });
            });
          }

          setTimeout(function() {
            var obs = new MutationObserver(function() {
              if (sr.querySelectorAll('[data-testid]').length <= 1) {
                obs.disconnect();
                host.style.setProperty('opacity', '0', 'important');
                setTimeout(function() {
                  _chatOpen = false;
                  unlockBodyScroll();
                  host.style.setProperty('transform', 'scale(0)', 'important');
                  host.style.setProperty('pointer-events', 'none', 'important');
                  host.style.removeProperty('opacity');
                  if (ourBadge) ourBadge.style.removeProperty('display');
                  var tab = document.getElementById('dl-concierge-tab');
                  var dismissKey = 'dl-tab-dismissed-' + window.location.pathname;
                  if (tab && window.matchMedia('(pointer: coarse)').matches && !sessionStorage.getItem(dismissKey)) {
                    tab.classList.add('dl-tab--collapsed');
                    tab.style.display = 'flex';
                    setTimeout(function() { tab.classList.add('dl-tab--visible'); }, 80);
                  }
                }, 80);
              }
            });
            obs.observe(sr, { childList: true, subtree: true });
          }, 600);
        }

        window._dlOpenChat = openClarityChat;

        var badge = document.getElementById('dl-clarity-badge');
        if (badge) badge.addEventListener('click', openClarityChat);
      })();
    </script>

    <!-- ── Mobile Concierge Pill ── -->
    <div id="dl-concierge-tab" role="button" aria-label="Your Concierge">
      <img class="dl-tab__logo" src="{{ 'Monogram_De_Leville.png' | asset_url }}" alt="" width="16" height="14">
      <span class="dl-tab__text">Your Concierge</span>
      <span class="dl-tab__close" aria-label="Dismiss">✕</span>
    </div>
    <script>
      (function () {
        if (!window.matchMedia('(pointer: coarse)').matches) return;
        var dismissKey = 'dl-tab-dismissed-' + window.location.pathname;
        if (sessionStorage.getItem(dismissKey)) return;
        var tab = document.getElementById('dl-concierge-tab');
        if (!tab) return;

        var _collapseTimer = null;

        function collapseTab() {
          if (tab.classList.contains('dl-tab--collapsed')) return;
          tab.classList.add('dl-tab--collapsed');
          if (_collapseTimer) { clearTimeout(_collapseTimer); _collapseTimer = null; }
          window.removeEventListener('scroll', onFirstScroll);
        }

        function onFirstScroll() { collapseTab(); }

        tab.style.display = 'flex';

        setTimeout(function () {
          tab.classList.add('dl-tab--visible');
          // Collapse after 3s of being visible, or on first scroll — whichever comes first
          _collapseTimer = setTimeout(collapseTab, 3000);
          window.addEventListener('scroll', onFirstScroll, { once: true, passive: true });
        }, 2500);

        tab.querySelector('.dl-tab__close').addEventListener('click', function (e) {
          e.stopPropagation();
          collapseTab(); // clean up listeners before hiding
          tab.classList.remove('dl-tab--visible');
          setTimeout(function () { tab.style.display = 'none'; }, 450);
          sessionStorage.setItem(dismissKey, '1');
        });

        tab.addEventListener('click', function (e) {
          if (e.target.classList.contains('dl-tab__close')) return;
          collapseTab(); // clean up listeners
          tab.classList.remove('dl-tab--visible');
          setTimeout(function() { tab.style.display = 'none'; }, 450);
          if (window._dlOpenChat) window._dlOpenChat();
        });
      })();
    </script>
