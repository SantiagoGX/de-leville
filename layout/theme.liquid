    <!-- De Leville: Luxury Refinements (LV-Benchmarked) -->
    <style>
    /* === FIX 1: Neutralize negative letter-spacing from fonts.css === */
    /* fonts.css sets -0.04em globally. LV uses +0.4px. We go +0.02em for Futura PT. */
    html, body, * { letter-spacing: 0.02em !important; }

    /* === FIX 2: Heading Weight — Luxury brands never shout === */
    /* LV uses weight 400 everywhere. We lighten headings only. */
    h1, h2, h3, h4, h5, h6 { font-weight: 400 !important; letter-spacing: 0.04em !important; }
    h1 { letter-spacing: 0.06em !important; }

    /* === FIX 3: Body text refinement === */
    p, li, td { line-height: 1.65 !important; }

    /* === FIX 4: Navigation — light, airy, LV-style === */
    nav a, .nav a, [class*="nav"] a, [class*="header"] a,
    header a { font-weight: 400 !important; letter-spacing: 0.03em !important; }

    /* === FIX 5: Buttons/CTAs — understated elegance === */
    button, .btn, [class*="button"], [class*="btn"],
    input[type="submit"], [class*="cta"] {
      font-weight: 400 !important;
      letter-spacing: 0.08em !important;
    }

    /* === FIX 6: Price styling — clean, confident === */
    [class*="price"], [class*="Price"] {
      font-weight: 400 !important;
      letter-spacing: 0.02em !important;
    }

    /* === FIX 7: Soft black text (LV uses rgb(26,26,26) not pure black) === */
    body { color: #1a1a1a !important; }

    /* ==========================================================
       De Leville — Mobile Pacing + Scroll Reveal (April 16, 2026)
       ========================================================== */

    /* Mobile: breathing room between sections, but the hero always sits flush.
       Strategy: apply top padding only to a content section that follows another content
       section — never to the first content section right after the header group. */
    @media (max-width: 900px) {
      /* Headers, announcement, footer wrappers — never pad. */
      .shopify-section-group-header-group,
      .shopify-section-group-footer-group,
      body > .shopify-section:first-of-type,
      body > .shopify-section.header-wrapper,
      .shopify-section[id*="header"],
      .shopify-section[id*="announcement"],
      .shopify-section[id*="footer"] {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }

      /* Every content section that FOLLOWS another content section gets breathing room. */
      body > .shopify-section + .shopify-section:not([id*="header"]):not([id*="announcement"]):not([id*="footer"]):not(.shopify-section-group-header-group):not(.shopify-section-group-footer-group) {
        padding-top: clamp(40px, 9vw, 88px);
        padding-bottom: clamp(40px, 9vw, 88px);
      }

      /* Override: if the preceding section was a header/announcement group, sit flush. */
      .shopify-section-group-header-group + .shopify-section,
      .shopify-section[id*="header"] + .shopify-section,
      .shopify-section[id*="announcement"] + .shopify-section {
        padding-top: 0 !important;
      }

      /* Typography on mobile — a touch more air. */
      h1, h2, h3 { line-height: 1.2 !important; }
      p, li { line-height: 1.7 !important; }
    }

    /* Scroll-reveal base state. JS adds .dl-in once the section is in view. */
    .dl-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 800ms cubic-bezier(.22,.61,.36,1),
                  transform 800ms cubic-bezier(.22,.61,.36,1);
      will-change: opacity, transform;
    }
    .dl-reveal.dl-in {
      opacity: 1;
      transform: translateY(0);
    }
    /* Digital Soul page: all sections are dark — disable reveal to avoid white flash between sections. */
    body.template-suffix-nft .dl-reveal,
    body.template-suffix-nft .dl-reveal.dl-in {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    /* Respect users who ask for less motion. */
    @media (prefers-reduced-motion: reduce) {
      .dl-reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    }

    /* Focus states — keyboard navigation only, invisible for mouse users */
    :focus { outline: none; }
    :focus-visible {
      outline: 1.5px solid #1a1a1a !important;
      outline-offset: 3px !important;
      border-radius: 2px;
    }
    /* Cards get a slightly thicker outline to be visible over images */
    a:focus-visible,
    button:focus-visible {
      outline-width: 2px !important;
    }

    /* PDP mobile fix: the product image was sliding behind the transparent
       header. A small offset clears the header without adding visible white space
       (the header is solid on PDP, so minimal padding is enough). */
    @media (max-width: 900px) {
      body.template-product .shopify-section:not(.shopify-section-group-header-group):not([id*="header"]):first-of-type,
      body.template-product .shopify-section[id*="pdp-hero"],
      body.template-product [data-section-type="snc-pdp-hero"],
      body.template-product .pdp-hero--root {
        padding-top: 0 !important;
      }
    }
    </style>

    <!-- De Leville: urgency/trust CSS injections removed -->

    {%- comment -%}
      De Leville · Header mode controller (April 20, 2026)
      Decides whether the header is transparent or solid based on:
      1. Page type. Pages with a dark hero at top get transparent mode when
         the hero is in view; everyone else stays solid.
      2. Scroll. Once the user scrolls past any element marked
         data-dl-dark-hero, flip to solid. Returning to the hero flips back.

      Moved into <head> (July 10, 2026): must run and set data-dl-header-mode
      on <html> BEFORE the header section (rendered in <body>) is parsed/painted.
      Previously this ran after the header, so the header's CSS fallback for a
      missing data-dl-header-mode attribute (solid white) painted first —
      causing a white flash on every page load with a dark hero.
    {%- endcomment -%}

    {%- comment -%}
      De Leville header hero-theme flag:
        'dark'   — hero image / video is mostly dark → use WHITE logo + icons when transparent
        'light'  — hero is mostly light/white → use BLACK logo + icons when transparent
        'none'   — no hero → header stays solid from the top
    {%- endcomment -%}
    {%- assign dl_hero_theme = 'none' -%}
    {%- assign dl_force_solid_header_suffixes = 'the-maison,pelletteria-di-lusso,product-care,shipping-policy,returns-and-exchanges,sizing-guide,about' | split: ',' -%}
    {%- assign dl_dark_hero_page_suffixes = 'chains,bags,classico,incontro,mezza-luna' | split: ',' -%}
    {%- assign dl_always_transparent_dark_suffixes = 'nft' | split: ',' -%}
    {%- if template.name == 'page' and dl_force_solid_header_suffixes contains template.suffix -%}
      {%- assign dl_hero_theme = 'none' -%}
    {%- elsif template.name == 'page' and dl_always_transparent_dark_suffixes contains template.suffix -%}
      {%- assign dl_hero_theme = 'always-dark' -%}
    {%- elsif template.name == 'page' and dl_dark_hero_page_suffixes contains template.suffix -%}
      {%- assign dl_hero_theme = 'dark' -%}
    {%- elsif template.name == 'index' -%}
      {%- assign dl_hero_theme = 'dark' -%}
    {%- elsif template.name == 'collection' -%}
      {%- comment -%}
        All collection templates now use snc-plp (white bg grid, no dark hero).
        Solid header from the top — black logo + icons.
      {%- endcomment -%}
      {%- assign dl_hero_theme = 'none' -%}
    {%- elsif template.name == 'list-collections' -%}
      {%- comment -%}
        /collections page uses Collections Editorial section with white background.
        Solid header from the top — black logo + icons.
      {%- endcomment -%}
      {%- assign dl_hero_theme = 'none' -%}
    {%- endif -%}

    <script>
      (function () {
        var html = document.documentElement;
        var heroTheme = {{ dl_hero_theme | json }};

        // Expose for applyAutoTheme() in snc-header.liquid so it knows which pages
        // allow scroll-driven updates to data-dl-header-mode.
        window.__dlHeroTheme = heroTheme;

        function setMode(mode) {
          if (html.getAttribute('data-dl-header-mode') !== mode) {
            html.setAttribute('data-dl-header-mode', mode);
          }
        }

        if (heroTheme === 'none') {
          setMode('solid');
          return;
        }

        // Pages that must stay transparent-dark regardless of scroll (e.g. Digital Soul).
        if (heroTheme === 'always-dark') {
          setMode('transparent-dark');
          return;
        }

        // Set initial mode only. applyAutoTheme() in snc-header.liquid owns all
        // scroll-based updates via data-dl-header-mode.
        var transparentMode = 'transparent-' + heroTheme;
        setMode(transparentMode);
      })();
    </script>
</head>

  <body class="template-{{ template.name }}{% if template.suffix != blank %} template-suffix-{{ template.suffix }}{% endif %}">

    {%- comment -%}
      De Leville — Page loader (Glow pulse).
      Appears ONLY when a page genuinely takes time to render.
      - Skipped on the homepage (IntroVideo handles the index opener).
      - On other pages: hidden initially; shown only if the page has not
        finished rendering after 200ms. Fast loads never flash the loader.
      - Fades out immediately on window.load. Safety timeout at 3500ms.
      - Respects prefers-reduced-motion.
    {%- endcomment -%}
    {%- unless template.name == 'index' -%}
    <div class="dl-site-loader" id="dlSiteLoader" aria-hidden="true">
      <img class="dl-site-loader__mark" src="{{ 'Monogram_De_Leville.png' | asset_url }}" alt="" width="60" height="54">
    </div>

    <style>
      .dl-site-loader {
        position: fixed; inset: 0; z-index: 99999;
        background: #fafaf7;
        display: flex; align-items: center; justify-content: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 400ms cubic-bezier(.22,.61,.36,1);
      }
      .dl-site-loader.is-visible {
        opacity: 1;
        visibility: visible;
      }
      .dl-site-loader.is-done {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      .dl-site-loader__mark {
        width: 60px; height: auto; display: block;
        user-select: none; pointer-events: none;
        animation: dlSiteLoaderGlow 2400ms cubic-bezier(.45,.05,.55,.95) infinite;
      }
      @keyframes dlSiteLoaderGlow {
        0%, 100% { opacity: 0.55; }
        50%      { opacity: 1; }
      }
      @media (prefers-reduced-motion: reduce) {
        .dl-site-loader__mark { animation: none; opacity: 1; }
      }
    </style>

    <script>
      (function () {
        var loader = document.getElementById('dlSiteLoader');
        if (!loader) return;
        var REVEAL_AFTER_MS = 200;   // only show if page hasn't rendered in this time
        var MAX_WAIT = 3500;
        var finished = false;
        var revealTimer = setTimeout(function () {
          if (!finished) loader.classList.add('is-visible');
        }, REVEAL_AFTER_MS);
        function hide() {
          finished = true;
          clearTimeout(revealTimer);
          loader.classList.add('is-done');
        }
        if (document.readyState === 'complete') hide();
        else window.addEventListener('load', hide);
        setTimeout(hide, MAX_WAIT);
      })();
    </script>
