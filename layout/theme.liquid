          <button type="button" class="dl-consent__btn dl-consent__btn--secondary" id="dlConsentDecline">Decline</button>
          <button type="button" class="dl-consent__btn dl-consent__btn--primary" id="dlConsentAccept">Accept</button>
        </div>
      </div>
    </div>

    <style>
      .dl-consent {
        position: fixed; left: 0; right: 0; bottom: 0;
        z-index: 99998;
        background: #ffffff;
        border-top: 1px solid #ececec;
        box-shadow: 0 -8px 28px rgba(0,0,0,0.05);
        transform: translateY(100%);
        transition: transform 500ms cubic-bezier(.22,.61,.36,1);
      }
      .dl-consent.is-visible { transform: translateY(0); }
      .dl-consent__inner {
        max-width: 1200px; margin: 0 auto;
        padding: 22px 32px;
        display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center;
      }
      .dl-consent__copy { color: #1a1a1a; }
      .dl-consent__title {
        font-family: var(--font-main);
        font-weight: 300; font-size: 22px; margin: 0 0 8px; color: #1a1a1a;
        letter-spacing: 0.005em;
      }
      .dl-consent__body {
        font-family: 'Futura PT', 'Jost', sans-serif; font-weight: 300; font-size: 14px;
        line-height: 1.6; color: #3a3a3a; margin: 0 0 6px; max-width: 640px;
      }
      .dl-consent__link { margin: 0; font-size: 12px; }
      .dl-consent__link a {
        color: #1a1a1a; text-decoration: underline; text-underline-offset: 3px;
        font-family: 'Futura PT', 'Jost', sans-serif;
      }
      .dl-consent__actions { display: flex; gap: 10px; }
      .dl-consent__btn {
        font-family: 'Futura PT', 'Jost', sans-serif; font-weight: 400;
        font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
        padding: 12px 26px; cursor: pointer; border: 1px solid #1a1a1a;
        transition: background 0.2s, color 0.2s;
      }
      .dl-consent__btn--primary { background: #1a1a1a; color: #ffffff; }
      .dl-consent__btn--primary:hover { background: #000; }
      .dl-consent__btn--secondary { background: #ffffff; color: #1a1a1a; }
      .dl-consent__btn--secondary:hover { background: #1a1a1a; color: #ffffff; }
      @media (max-width: 720px) {
        .dl-consent__inner {
          grid-template-columns: 1fr; gap: 18px; padding: 20px;
        }
        .dl-consent__actions { justify-content: flex-end; }
        .dl-consent__title { font-size: 20px; }
      }
    </style>

    <script>
      (function () {
        var banner = document.getElementById('dlConsent');
        if (!banner) return;
        var STORAGE_KEY = 'dl_consent_v1';
        var saved = null;
        try { saved = localStorage.getItem(STORAGE_KEY); } catch (e) {}

        function grantGtag(accepted) {
          if (typeof gtag !== 'function') return;
          var state = accepted ? 'granted' : 'denied';
          gtag('consent', 'update', {
            analytics_storage: state,
            ad_storage: state,
            ad_user_data: state,
            ad_personalization: state
          });
          // Fire page view only after analytics consent is granted
          if (accepted) gtag('event', 'page_view');
        }

        function applyConsent(accepted) {
          grantGtag(accepted);
          if (window.Shopify && Shopify.customerPrivacy && Shopify.customerPrivacy.setTrackingConsent) {
            Shopify.customerPrivacy.setTrackingConsent({
              analytics: accepted, marketing: accepted, preferences: accepted, sale_of_data: false
            }, function () {});
          }
        }

        function applyChoice(accepted) {
          try { localStorage.setItem(STORAGE_KEY, accepted ? 'accept' : 'decline'); } catch (e) {}
          applyConsent(accepted);
        }

        // Always load the consent API so it's ready regardless of visitor state
        if (window.Shopify && Shopify.loadFeatures) {
          Shopify.loadFeatures([{ name: 'consent-tracking-api', version: '0.1' }], function () {
            if (saved === 'accept' || saved === 'decline') {
              applyConsent(saved === 'accept');
            }
          });
        }

        // Returning visitor — re-grant immediately without showing banner
        if (saved === 'accept') { grantGtag(true); return; }
        if (saved === 'decline') return;

        setTimeout(function () {
          banner.classList.add('is-visible');
          banner.setAttribute('aria-hidden', 'false');
        }, 2000);

        document.getElementById('dlConsentAccept').addEventListener('click', function () {
          applyChoice(true); banner.classList.remove('is-visible');
        });
        document.getElementById('dlConsentDecline').addEventListener('click', function () {
          applyChoice(false); banner.classList.remove('is-visible');
        });
      })();
    </script>

