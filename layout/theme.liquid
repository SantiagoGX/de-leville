    <!-- ==========================================================
         De Leville — Scroll Reveal (April 16, 2026)
         Fades each top-level section into view as the user scrolls.
         Runs only on viewports <= 1024px to keep desktop untouched.
         ========================================================== -->
    <script>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        // Tag every top-level section so the stylesheet can hide it.
        // Target every top-level Shopify section, skip header/footer wrappers and the first visible section (hero).
        var allSections = Array.prototype.slice.call(
          document.querySelectorAll('body > .shopify-section')
        );
        var targets = allSections.filter(function (el) {
          var id = (el.id || '').toLowerCase();
          if (id.indexOf('header') > -1 || id.indexOf('announcement') > -1 || id.indexOf('footer') > -1) return false;
          if (el.classList.contains('shopify-section-group-header-group')) return false;
          if (el.classList.contains('shopify-section-group-footer-group')) return false;
          return true;
        });
        // Skip the very first visible section (hero) so there is no flash above the fold.
        for (var i = 1; i < targets.length; i++) {
          targets[i].classList.add('dl-reveal');
        }

        if (!('IntersectionObserver' in window)) {
          // Fallback: reveal everything.
          targets.forEach(function (t) { t.classList.add('dl-in'); });
          return;
        }

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('dl-in');
              io.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.12,
          rootMargin: '0px 0px -10% 0px'
        });

        targets.forEach(function (t) { io.observe(t); });
      })();
    </script>

    {%- comment -%}
      De Leville · Cookie consent banner (April 20, 2026)
