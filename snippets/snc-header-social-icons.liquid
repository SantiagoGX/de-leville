{%- comment -%}
  Renders social icons for the burger menu
  Accepts:
  - block: {Object} Block object (desktop_drawer or mobile_drawer)
{%- endcomment -%}
{%- liquid
  assign fb_url = block.settings.social_facebook_url | default: settings.social_facebook_link
  assign ig_url = block.settings.social_instagram_url | default: settings.social_instagram_link
  assign tt_url = block.settings.social_tiktok_url | default: settings.social_tiktok_link
  assign fb_icon = settings.social_facebook_icon
  assign ig_icon = settings.social_instagram_icon
  assign tt_icon = settings.social_tiktok_icon
-%}
{%- if fb_url != blank and fb_icon != blank -%}
  <a href="{{ fb_url }}" target="_blank" rel="noopener noreferrer" class="custom-header--burger-social-link" aria-label="Facebook">
    <img src="{{ fb_icon | image_url: width: 60 }}" alt="Facebook" class="custom-header--burger-social-icon-img" width="26" height="26">
  </a>
{%- endif -%}
{%- if ig_url != blank and ig_icon != blank -%}
  <a href="{{ ig_url }}" target="_blank" rel="noopener noreferrer" class="custom-header--burger-social-link" aria-label="Instagram">
    <img src="{{ ig_icon | image_url: width: 60 }}" alt="Instagram" class="custom-header--burger-social-icon-img" width="26" height="26">
  </a>
{%- endif -%}
{%- if tt_url != blank and tt_icon != blank -%}
  <a href="{{ tt_url }}" target="_blank" rel="noopener noreferrer" class="custom-header--burger-social-link" aria-label="TikTok">
    <img src="{{ tt_icon | image_url: width: 60 }}" alt="TikTok" class="custom-header--burger-social-icon-img" width="26" height="26">
  </a>
{%- endif -%}