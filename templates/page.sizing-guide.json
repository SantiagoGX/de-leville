            "eyebrow": "1 · Visit a jeweler",
            "title": "Visit a jeweler",
            "text": "<p>The most accurate way. Most jewelers will size a finger at no charge. Ask to be measured at the end of the day, when the hand is at its fullest.</p>",
            "image": ""
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "eyebrow": "2 · Measure a ring you own",
            "title": "Measure a ring you own",
            "text": "<p>Choose a ring that already fits the finger you have in mind. Lay it flat. With a ruler, measure the inside diameter in millimeters, the widest point across the empty middle of the band. Match your reading to the chart below.</p>",
            "image": ""
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "eyebrow": "3 · Measure the finger",
            "title": "Measure the finger",
            "text": "<p>Cut a thin strip of paper. Wrap it around the base of the finger, snug but not tight. Mark where the strip overlaps. Measure the length in millimeters. This is the circumference. Match it to the chart.</p>",
            "image": ""
          }
        },
