<section class="dl-page dl-page--shipping">
  <div class="dl-page-hero">
    <div class="dl-page-eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="dl-page-title">{{ section.settings.title }}</h1>
    <div class="dl-page-intro rte">{{ section.settings.intro }}</div>
  </div>

  <div class="dl-page-stats">
    <div class="dl-page-stat"><div class="dl-page-stat-num">{{ section.settings.stat_1_value }}</div><div class="dl-page-stat-label">{{ section.settings.stat_1_label }}</div></div>
    <div class="dl-page-stat"><div class="dl-page-stat-num">{{ section.settings.stat_2_value }}</div><div class="dl-page-stat-label">{{ section.settings.stat_2_label }}</div></div>
    <div class="dl-page-stat"><div class="dl-page-stat-num">{{ section.settings.stat_3_value }}</div><div class="dl-page-stat-label">{{ section.settings.stat_3_label }}</div></div>
  </div>

  <div class="dl-page-section"><h2>{{ section.settings.made_to_order_title }}</h2><div class="rte">{{ section.settings.made_to_order_text }}</div></div>
  <div class="dl-page-divider"></div>
  <div class="dl-page-section"><h2>{{ section.settings.shipping_title }}</h2><div class="rte">{{ section.settings.shipping_text }}</div></div>

  <div class="dl-page-image dl-page-image--band">
    {% if section.settings.image_1 != blank %}
      {{ section.settings.image_1 | image_url: width: 2200 | image_tag: loading: 'lazy', alt: section.settings.image_1_alt, class: 'dl-image-tag' }}
    {% endif %}
  </div>

  <div class="dl-page-section"><h2>{{ section.settings.customs_title }}</h2><div class="rte">{{ section.settings.customs_text }}</div></div>
  <div class="dl-page-divider"></div>
  <div class="dl-page-section"><h2>{{ section.settings.receive_title }}</h2><div class="rte">{{ section.settings.receive_text }}</div></div>
  <div class="dl-page-section"><h2>{{ section.settings.problems_title }}</h2><div class="rte">{{ section.settings.problems_text }}</div></div>

  <div class="dl-page-close">
    <div class="rte">{{ section.settings.close_text }}</div>
    <p><a href="mailto:{{ section.settings.concierge_email }}?subject=Shipping">{{ section.settings.concierge_email }}</a></p>
    <div class="dl-page-signature">{{ section.settings.signature }}</div>
  </div>
</section>

<style>
  .dl-page--shipping { max-width: 100%; color: #1a1a1a; font-family: 'Futura PT', 'Jost', sans-serif; font-weight: 300; line-height: 1.7; }
  .dl-page--shipping .dl-page-hero { text-align: center; padding: 80px 24px 60px; max-width: 720px; margin: 0 auto; }
  .dl-page--shipping .dl-page-eyebrow { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: #6c6c6c; margin-bottom: 18px; }
  .dl-page--shipping .dl-page-title { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-weight: 300; font-size: 46px; letter-spacing: 0.005em; line-height: 1.15; margin: 0 0 22px; color: #1a1a1a; }
  .dl-page--shipping .dl-page-intro { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-style: italic; font-size: 20px; line-height: 1.55; color: #3a3a3a; max-width: 560px; margin: 0 auto; }
  .dl-page--shipping .dl-page-section { max-width: 680px; margin: 0 auto; padding: 70px 24px; }
  .dl-page--shipping .dl-page-section h2 { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-size: 28px; margin: 0 0 24px; line-height: 1.2; font-weight: 300; }
  .dl-page--shipping .dl-page-section h3 { font-family: 'Futura PT', 'Jost', sans-serif; font-weight: 400; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; margin: 32px 0 10px; color: #1a1a1a; }
  .dl-page--shipping .dl-page-section p { font-size: 16px; margin: 0 0 16px; color: #2a2a2a; }
  .dl-page--shipping .dl-page-divider { width: 40px; height: 1px; background: #d4d4d0; margin: 0 auto; }
  .dl-page--shipping .dl-page-image { width: 100%; display: block; margin: 0 auto; background: #ffffff; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; }
  .dl-page--shipping .dl-image-tag { width: 100%; height: 100%; object-fit: contain; display: block; }
  .dl-page--shipping .dl-page-image--band { aspect-ratio: 21 / 9; max-width: 1280px; padding: 40px; box-sizing: border-box; }
  .dl-page--shipping .dl-page-stats { display: grid; grid-template-columns: repeat(3, 1fr); max-width: 960px; margin: 0 auto; padding: 40px 24px; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; }
  .dl-page--shipping .dl-page-stat { text-align: center; padding: 20px 12px; border-right: 1px solid #ececec; }
  .dl-page--shipping .dl-page-stat:last-child { border-right: none; }
  .dl-page--shipping .dl-page-stat-num { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-weight: 300; font-size: 38px; color: #1a1a1a; line-height: 1; letter-spacing: 0.01em; }
  .dl-page--shipping .dl-page-stat-label { font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: #6c6c6c; margin-top: 10px; }
  .dl-page--shipping .dl-page-close { text-align: center; padding: 80px 24px 100px; max-width: 560px; margin: 0 auto; }
  .dl-page--shipping .dl-page-close p { font-size: 16px; color: #3a3a3a; margin: 0 0 14px; }
  .dl-page--shipping .dl-page-close .dl-page-signature { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 14px; color: #6c6c6c; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 22px; }
  @media (max-width: 768px) {
    .dl-page--shipping .dl-page-hero { padding: 56px 20px 44px; }
    .dl-page--shipping .dl-page-title { font-size: 34px; }
    .dl-page--shipping .dl-page-intro { font-size: 17px; }
    .dl-page--shipping .dl-page-section { padding: 50px 20px; }
    .dl-page--shipping .dl-page-section h2 { font-size: 24px; }
    .dl-page--shipping .dl-page-image--band { aspect-ratio: 4 / 3; padding: 24px; }
    .dl-page--shipping .dl-page-close { padding: 56px 20px 80px; }
    .dl-page--shipping .dl-page-stats { grid-template-columns: 1fr; padding: 20px 20px; }
    .dl-page--shipping .dl-page-stat { border-right: none; border-bottom: 1px solid #ececec; padding: 24px 12px; }
    .dl-page--shipping .dl-page-stat:last-child { border-bottom: none; }
  }
</style>

{% schema %}
{
  "name": "SNC Shipping Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A note from the maison" },
    { "type": "text", "id": "title", "label": "Title", "default": "Shipping" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Every De Leville piece is made to order. When the order is placed, the atelier begins. When the piece is ready, it travels to you, fully insured, signed for on arrival.</p>" },
    { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "4 · 6" },
    { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Weeks to deliver" },
    { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "Worldwide" },
    { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Complimentary shipping" },
    { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "Fully" },
    { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Insured, end to end" },
    { "type": "text", "id": "made_to_order_title", "label": "Made to order title", "default": "Made to order" },
    { "type": "richtext", "id": "made_to_order_text", "label": "Made to order text", "default": "<p>No De Leville piece sits in a warehouse waiting to be sold. Each ring is made for the person who commissioned it. The moment your order is confirmed, work begins.</p><p>Delivery takes four to six weeks from the date of order. For pieces with specific stone settings or bespoke requests, we will write to you with a confirmed timeline.</p>" },
    { "type": "text", "id": "shipping_title", "label": "Shipping title", "default": "Complimentary worldwide shipping" },
    { "type": "richtext", "id": "shipping_text", "label": "Shipping text", "default": "<p>Shipping is included, everywhere. No expedited tier, no upgrade. Every piece travels through a trusted insured carrier, with full tracking from the atelier to your door.</p><h3>Signature required</h3><p>Every De Leville order requires a signature on delivery. The package will not be left without one. If nobody is home at the first attempt, the carrier will leave a notice and attempt redelivery, or hold the piece at a local collection point.</p>" },
    { "type": "image_picker", "id": "image_1", "label": "Band image" },
    { "type": "text", "id": "image_1_alt", "label": "Band image alt", "default": "De Leville ring" },
    { "type": "text", "id": "customs_title", "label": "Customs title", "default": "Customs and duties" },
    { "type": "richtext", "id": "customs_text", "label": "Customs text", "default": "<p>For international orders, duties, import taxes, and customs fees are set by the destination country and are the responsibility of the recipient. These amounts vary by country and are not included in the order total.</p><p>If you need documentation for customs clearance, write to the concierge and we will provide it before the piece ships.</p>" },
    { "type": "text", "id": "receive_title", "label": "Receive title", "default": "What you will receive" },
    { "type": "richtext", "id": "receive_text", "label": "Receive text", "default": "<h3>Order confirmation</h3><p>A confirmation email lands in your inbox within minutes of placing the order. This is the moment the atelier begins.</p><h3>Shipping confirmation</h3><p>When the piece is ready and dispatched, we send a second email with your tracking number. From this point you can follow the package door to door.</p><h3>Delivery confirmation</h3><p>Once the package is signed for, a final email confirms safe arrival.</p>" },
    { "type": "text", "id": "problems_title", "label": "Problems title", "default": "If something goes wrong" },
    { "type": "richtext", "id": "problems_text", "label": "Problems text", "default": "<p>Every shipment is fully insured for the total value of the order, from the atelier to your door. If a package is lost, damaged, or delayed beyond reasonable time, write to the concierge. We will resolve it, quickly and privately, at no cost to you.</p>" },
    { "type": "richtext", "id": "close_text", "label": "Closing text", "default": "<p>Questions about your order? Write to the concierge.</p>" },
    { "type": "text", "id": "concierge_email", "label": "Concierge email", "default": "concierge@deleville.co" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "De Leville" }
  ],
  "presets": [{ "name": "SNC Shipping Page" }]
}
{% endschema %}
