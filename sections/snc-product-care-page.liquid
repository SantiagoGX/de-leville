<section class="dl-page dl-page--care">
  <div class="dl-page-hero">
    <div class="dl-page-eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="dl-page-title">{{ section.settings.title }}</h1>
    <div class="dl-page-intro rte">{{ section.settings.intro }}</div>
  </div>

  <div class="dl-page-image dl-page-image--band">
    {% if section.settings.image_1 != blank %}
      {{ section.settings.image_1 | image_url: width: 2200 | image_tag: loading: 'lazy', alt: section.settings.image_1_alt, class: 'dl-image-tag' }}
    {% endif %}
  </div>

  <div class="dl-page-section">
    <h2>{{ section.settings.everyday_title }}</h2>
    <div class="rte">{{ section.settings.everyday_text }}</div>
  </div>

  <div class="dl-page-image dl-page-image--square">
    {% if section.settings.image_2 != blank %}
      {{ section.settings.image_2 | image_url: width: 1800 | image_tag: loading: 'lazy', alt: section.settings.image_2_alt, class: 'dl-image-tag' }}
    {% endif %}
  </div>

  <div class="dl-page-section">
    <h2>{{ section.settings.cleaning_title }}</h2>
    <div class="rte">{{ section.settings.cleaning_text }}</div>
  </div>

  <div class="dl-page-image dl-page-image--band">
    {% if section.settings.image_3 != blank %}
      {{ section.settings.image_3 | image_url: width: 2200 | image_tag: loading: 'lazy', alt: section.settings.image_3_alt, class: 'dl-image-tag' }}
    {% endif %}
  </div>

  <div class="dl-page-section">
    <h2>{{ section.settings.storage_title }}</h2>
    <div class="rte">{{ section.settings.storage_text }}</div>
  </div>

  <div class="dl-page-divider"></div>

  <div class="dl-page-section">
    <h2>{{ section.settings.servicing_title }}</h2>
    <div class="rte">{{ section.settings.servicing_text }}</div>
  </div>

  <div class="dl-page-close">
    <div class="rte">{{ section.settings.close_text }}</div>
    <p><a href="mailto:{{ section.settings.concierge_email }}?subject=Product%20care">{{ section.settings.concierge_email }}</a></p>
    <div class="dl-page-signature">{{ section.settings.signature }}</div>
  </div>
</section>

<style>
  .dl-page--care { max-width: 100%; color: #1a1a1a; font-family: 'Futura PT', 'Jost', sans-serif; font-weight: 300; line-height: 1.7; }
  .dl-page--care .dl-page-hero { text-align: center; padding: 80px 24px 60px; max-width: 720px; margin: 0 auto; }
  .dl-page--care .dl-page-eyebrow { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: #6c6c6c; margin-bottom: 18px; }
  .dl-page--care .dl-page-title { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-weight: 300; font-size: 46px; letter-spacing: 0.005em; line-height: 1.15; margin: 0 0 22px; color: #1a1a1a; }
  .dl-page--care .dl-page-intro { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-style: italic; font-size: 20px; line-height: 1.55; color: #3a3a3a; max-width: 560px; margin: 0 auto; }
  .dl-page--care .dl-page-image { width: 100%; display: block; margin: 0 auto; background: #ffffff; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; }
  .dl-page--care .dl-image-tag { width: 100%; height: 100%; object-fit: contain; display: block; }
  .dl-page--care .dl-page-image--band { aspect-ratio: 21 / 9; max-width: 1280px; padding: 40px; box-sizing: border-box; }
  .dl-page--care .dl-page-image--square { aspect-ratio: 1 / 1; max-width: 720px; padding: 50px; box-sizing: border-box; }
  .dl-page--care .dl-page-section { max-width: 680px; margin: 0 auto; padding: 70px 24px; }
  .dl-page--care .dl-page-section h2 { font-family: 'Cormorant Garamond', 'Times New Roman', serif; font-size: 28px; margin: 0 0 24px; line-height: 1.2; font-weight: 300; }
  .dl-page--care .dl-page-section h3 { font-family: 'Futura PT', 'Jost', sans-serif; font-weight: 400; font-size: 13px; letter-spacing: 0.12em; text-transform: uppercase; margin: 32px 0 10px; color: #1a1a1a; }
  .dl-page--care .dl-page-section p { font-size: 16px; margin: 0 0 16px; color: #2a2a2a; }
  .dl-page--care .dl-page-divider { width: 40px; height: 1px; background: #d4d4d0; margin: 0 auto; }
  .dl-page--care .dl-page-close { text-align: center; padding: 80px 24px 100px; max-width: 560px; margin: 0 auto; }
  .dl-page--care .dl-page-close p { font-size: 16px; color: #3a3a3a; margin: 0 0 14px; }
  .dl-page--care .dl-page-close .dl-page-signature { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 14px; color: #6c6c6c; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 22px; }
  @media (max-width: 768px) {
    .dl-page--care .dl-page-hero { padding: 56px 20px 44px; }
    .dl-page--care .dl-page-title { font-size: 34px; }
    .dl-page--care .dl-page-intro { font-size: 17px; }
    .dl-page--care .dl-page-section { padding: 50px 20px; }
    .dl-page--care .dl-page-section h2 { font-size: 24px; }
    .dl-page--care .dl-page-image--band { aspect-ratio: 4 / 3; padding: 24px; }
    .dl-page--care .dl-page-image--square { padding: 28px; }
    .dl-page--care .dl-page-close { padding: 56px 20px 80px; }
  }
</style>

{% schema %}
{
  "name": "SNC Product Care Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A guide from the maison" },
    { "type": "text", "id": "title", "label": "Title", "default": "Product Care" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Your De Leville piece is made to last. Here is how to help it age beautifully.</p>" },
    { "type": "image_picker", "id": "image_1", "label": "Top band image" },
    { "type": "text", "id": "image_1_alt", "label": "Top image alt", "default": "De Leville ring" },
    { "type": "text", "id": "everyday_title", "label": "Everyday title", "default": "Everyday care" },
    { "type": "richtext", "id": "everyday_text", "label": "Everyday text", "default": "<p>18-karat gold resists tarnish and corrosion naturally. It is built for daily wear. A few habits will keep it looking the way you first saw it.</p><h3>Put the jewelry on last</h3><p>Apply perfume, lotion, sunscreen, and hair products before the ring goes on. These products contain compounds that can dull gold over time.</p><h3>Remove before water</h3><p>Take the ring off before swimming, showering, or washing dishes. Chlorine and salt water damage gold. Occasional contact is fine. Daily contact is not.</p><h3>Remove during physical effort</h3><p>Workouts, gardening, heavy lifting. 18-karat gold is softer than 14-karat because it contains more gold, which is what gives it the warmth you chose it for. That softness also scratches more easily than 14-karat.</p>" },
    { "type": "image_picker", "id": "image_2", "label": "Square image" },
    { "type": "text", "id": "image_2_alt", "label": "Square image alt", "default": "Gold surface detail" },
    { "type": "text", "id": "cleaning_title", "label": "Cleaning title", "default": "Cleaning" },
    { "type": "richtext", "id": "cleaning_text", "label": "Cleaning text", "default": "<h3>Weekly</h3><p>Polish the ring with the soft cloth included in your De Leville box. This removes the oils and residue that everyday wear leaves behind and restores the natural shine.</p><h3>Monthly</h3><p>Soak the ring in warm water with a few drops of mild dish soap for fifteen to twenty minutes. Clean gently with a soft-bristled brush. A baby toothbrush works well, especially for the detailed areas. Rinse thoroughly and pat dry with a soft, lint-free cloth.</p><h3>Diamond pieces</h3><p>The same warm water and soap method works for diamonds. The brush helps reach the underside of the setting, which is where residue collects. The stones will read brighter after a careful wash.</p><h3>What to avoid</h3><p>No abrasive cleaners. No toothpaste, no baking soda, no ultrasonic tanks at home. Never bleach or chlorine-based products. If a piece needs professional attention, write to us.</p>" },
    { "type": "image_picker", "id": "image_3", "label": "Bottom band image" },
    { "type": "text", "id": "image_3_alt", "label": "Bottom image alt", "default": "De Leville gold ring top view" },
    { "type": "text", "id": "storage_title", "label": "Storage title", "default": "Storage" },
    { "type": "richtext", "id": "storage_text", "label": "Storage text", "default": "<p>Between wears, return the ring to the pouch or box it arrived in. The box is designed to protect the piece from surface marks and to keep it away from other jewelry.</p><p>If several pieces live together, keep them separated. Gold scratches gold. The individual compartments in your De Leville box are there for that reason.</p><p>Avoid bathrooms with standing humidity. Avoid long, direct sunlight.</p>" },
    { "type": "text", "id": "servicing_title", "label": "Servicing title", "default": "Professional servicing" },
    { "type": "richtext", "id": "servicing_text", "label": "Servicing text", "default": "<p>After years of daily wear, even the finest gold shows small signs of a life lived. Faint scratches, a softened shoulder, a quiet patina. Many of our collectors consider this part of the piece.</p><p>If you would like the ring professionally polished, inspected, or repaired, write to the concierge. We arrange servicing through a trusted network.</p><p>For pieces with diamonds, we recommend a professional check once a year to confirm the settings remain secure.</p>" },
    { "type": "richtext", "id": "close_text", "label": "Closing text", "default": "<p>Questions about your piece? Write to the concierge.</p>" },
    { "type": "text", "id": "concierge_email", "label": "Concierge email", "default": "concierge@deleville.co" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "De Leville" }
  ],
  "presets": [{ "name": "SNC Product Care Page" }]
}
{% endschema %}
