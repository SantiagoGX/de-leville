{% comment %}
  Section: Luxury Asymmetric Collections - Full Viewport
  Usage: {% section 'luxury-collections' %}
{% endcomment %}

<style>
  #shopify-section-{{ section.id }} .luxury-collections-section {
    --color-bg: {{ section.settings.bg_color }};
    --color-text: {{ section.settings.text_color }};
    --color-accent: {{ section.settings.accent_color }};
    --spacing-section: {{ section.settings.section_padding }}px;
    --row-height: {{ section.settings.row_height }}px;
    
    background-color: var(--color-bg);
    min-height: 100vh; /* Viewport completo */
    display: flex;
    flex-direction: column;
    justify-content: center; /* Centrado vertical */
    padding: var(--spacing-section) 20px;
    font-family: 'Montserrat', sans-serif;
    color: var(--color-text);
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .section-header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: {{ section.settings.header_margin }}px;
    flex-shrink: 0; /* Evita que el header se comprima */
  }

  #shopify-section-{{ section.id }} .section-label {
    font-size: {{ section.settings.label_size }}px;
    letter-spacing: {{ section.settings.label_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.label_color }};
    margin-bottom: 16px;
    display: block;
    font-weight: {{ section.settings.label_weight }};
  }

  #shopify-section-{{ section.id }} .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.5px;
  }

  #shopify-section-{{ section.id }} .section-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: {{ section.settings.subheading_size }}px;
    color: {{ section.settings.subheading_color }};
    margin-top: 12px;
    font-weight: {{ section.settings.subheading_weight }};
  }

  #shopify-section-{{ section.id }} .collections-wrapper {
    flex: 1; /* Ocupa el espacio restante */
    display: flex;
    align-items: center; /* Centrado vertical de la grilla */
    width: 100%;
  }

  #shopify-section-{{ section.id }} .collections-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: var(--row-height);
    gap: {{ section.settings.grid_gap }}px;
    max-width: {{ section.settings.container_width }}px;
    width: 100%;
    margin: 0 auto;
  }

  .collection-item {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    background: #f0f0f0;
    text-decoration: none;
    display: block;
  }

  {% if section.blocks.size == 1 %}
    .collection-item { grid-column: span 12; grid-row: span 2; }
  {% elsif section.blocks.size == 2 %}
    .collection-item:nth-child(1) { grid-column: span 7; grid-row: span 2; }
    .collection-item:nth-child(2) { grid-column: span 5; grid-row: span 2; }
  {% elsif section.blocks.size == 3 %}
    .collection-item:nth-child(1) { grid-column: span 6; grid-row: span 2; }
    .collection-item:nth-child(2) { grid-column: span 6; }
    .collection-item:nth-child(3) { grid-column: span 6; }
  {% elsif section.blocks.size == 4 %}
    .collection-item:nth-child(1) { grid-column: span 6; grid-row: span 2; }
    .collection-item:nth-child(2) { grid-column: span 6; }
    .collection-item:nth-child(3) { grid-column: span 6; }
    .collection-item:nth-child(4) { grid-column: span 6; grid-row: span 2; }
  {% elsif section.blocks.size == 5 %}
    .collection-item:nth-child(1) { grid-column: span 6; grid-row: span 2; }
    .collection-item:nth-child(2) { grid-column: span 6; }
    .collection-item:nth-child(3) { grid-column: span 4; grid-row: span 2; }
    .collection-item:nth-child(4) { grid-column: span 4; }
    .collection-item:nth-child(5) { grid-column: span 4; }
  {% else %}
    .collection-item:nth-child(1) { grid-column: span 5; grid-row: span 2; }
    .collection-item:nth-child(2) { grid-column: span 4; }
    .collection-item:nth-child(3) { grid-column: span 3; grid-row: span 2; }
    .collection-item:nth-child(4) { grid-column: span 4; }
    .collection-item:nth-child(5) { grid-column: span 3; }
    .collection-item:nth-child(6) { grid-column: span 5; }
  {% endif %}

  {% for block in section.blocks %}
    {% if block.settings.custom_position and block.settings.column_span != blank %}
      #shopify-section-{{ section.id }} .collection-item[data-block-id="{{ block.id }}"] {
        grid-column: span {{ block.settings.column_span }};
        {% if block.settings.row_span != blank %}
          grid-row: span {{ block.settings.row_span }};
        {% endif %}
      }
    {% endif %}
  {% endfor %}

  .collection-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform {{ section.settings.hover_speed }}ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
    filter: brightness({{ section.settings.image_brightness }}%);
  }

  .collection-item:hover .collection-image {
    transform: scale({{ section.settings.hover_zoom }});
    filter: brightness({{ section.settings.image_brightness | plus: 10 }}%);
  }

  .collection-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 40%,
      rgba(0,0,0,0.4) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 40px;
    transition: background {{ section.settings.hover_speed }}ms ease;
  }

  .collection-item:hover .collection-overlay {
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(0,0,0,0.1) 40%,
      rgba(0,0,0,0.6) 100%
    );
  }

  .collection-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: {{ section.settings.title_size }}px;
    color: {{ section.settings.overlay_text_color }};
    margin: 0 0 8px 0;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: 1px;
    transform: translateY(20px);
    opacity: 0;
    transition: all {{ section.settings.hover_speed }}ms cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .collection-count {
    font-size: {{ section.settings.count_size }}px;
    letter-spacing: {{ section.settings.count_spacing }}px;
    text-transform: uppercase;
    color: {{ section.settings.overlay_text_color | color_modify: 'alpha', 0.8 }};
    transform: translateY(20px);
    opacity: 0;
    transition: all {{ section.settings.hover_speed }}ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.1s;
    font-weight: {{ section.settings.count_weight }};
  }

  .collection-item:hover .collection-name,
  .collection-item:hover .collection-count {
    transform: translateY(0);
    opacity: 1;
  }

  .luxury-indicator {
    position: absolute;
    top: 30px;
    right: 30px;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: all {{ section.settings.hover_speed }}ms ease;
    backdrop-filter: blur(2px);
  }

  .collection-item:hover .luxury-indicator {
    opacity: 1;
  }

  .luxury-indicator::after {
    content: '{{ section.settings.arrow_icon | default: '→' }}';
    color: {{ section.settings.overlay_text_color }};
    font-size: 14px;
    font-weight: 300;
  }

  /* Responsive - Tablet */
  @media (max-width: {{ section.settings.mobile_breakpoint }}px) {
    #shopify-section-{{ section.id }} .luxury-collections-section {
      min-height: auto; /* En tablet y móvil vuelve a altura natural */
      padding: 60px 20px;
    }
    
    #shopify-section-{{ section.id }} .collections-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: calc(var(--row-height) * 0.8);
    }
    
    .collection-item {
      grid-column: span 1 !important;
      grid-row: span 1 !important;
    }
    
    #shopify-section-{{ section.id }} .collection-item:nth-child(1),
    #shopify-section-{{ section.id }} .collection-item:nth-child(3) {
      grid-row: span 2 !important;
    }
  }

  @media (max-width: 576px) {
    #shopify-section-{{ section.id }} .collections-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    
    .collection-item {
      grid-row: span 1 !important;
    }
    
    .collection-overlay {
      padding: 24px;
    }
    
    .collection-name {
      opacity: 1;
      transform: translateY(0);
    }
    
    .collection-count {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #shopify-section-{{ section.id }} .collection-item {
    animation: fadeInUp 1s ease-out forwards;
    opacity: 0;
  }

  {% for block in section.blocks %}
    #shopify-section-{{ section.id }} .collection-item:nth-child({{ forloop.index }}) {
      animation-delay: {{ forloop.index | times: 0.1 }}s;
    }
  {% endfor %}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Montserrat:wght@200;300;400;500;600&display=swap" rel="stylesheet">

<section class="luxury-collections-section" id="shopify-section-{{ section.id }}">
  <div class="section-header">
    {% if section.settings.label != blank %}
      <span class="section-label">{{ section.settings.label }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="section-subtitle">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="collections-wrapper">
    <div class="collections-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        {% if collection != blank or block.settings.image != blank %}
          <a 
            href="{{ collection.url | default: block.settings.custom_link }}" 
            class="collection-item" 
            data-block-id="{{ block.id }}"
            {{ block.shopify_attributes }}
          >
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 1200 | image_tag: 
                class: "collection-image",
                loading: "lazy",
                alt: block.settings.custom_title | default: collection.title
              }}
            {% elsif collection.image != blank %}
              {{ collection.image | image_url: width: 1200 | image_tag: 
                class: "collection-image",
                loading: "lazy",
                alt: collection.title
              }}
            {% elsif collection.products.first.featured_image != blank %}
              {{ collection.products.first.featured_image | image_url: width: 1200 | image_tag: 
                class: "collection-image",
                loading: "lazy",
                alt: collection.title
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-image' }}
            {% endif %}

            <div class="collection-overlay">
              <h3 class="collection-name">
                {{ block.settings.custom_title | default: collection.title }}
              </h3>
              {% if section.settings.show_count %}
                <span class="collection-count">
                  {{ collection.products_count | default: 0 }} {{ section.settings.count_text }}
                </span>
              {% endif %}
            </div>
            
            <div class="luxury-indicator"></div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Luxury Collections",
  "tag": "section",
  "class": "section-luxury-collections",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
