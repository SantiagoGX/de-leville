      "default": true,
      "info": "Makes the section occupy 100% of the screen height"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Top label",
      "default": "Discover",
      "info": "Small text above the main heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Collections"
    },
    {
