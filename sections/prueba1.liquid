      "min": 9,
      "max": 16,
      "step": 1,
      "default": 11,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "label_weight",
      "label": "Label font weight",
      "options": [
        {
          "value": "300",
          "label": "Light (300)"
        },
        {
          "value": "400",
          "label": "Normal / Regular (400)"
        },
        {
          "value": "500",
          "label": "Medium (500)"
        }
      ],
      "default": "300"
    },
    {
