<section class="dl-page dl-page--pelletteria">
  <div class="dl-page-hero">
    <div class="dl-page-eyebrow">{{ section.settings.eyebrow }}</div>
    <h1 class="dl-page-title">{{ section.settings.title }}</h1>
    <div class="dl-page-intro rte">{{ section.settings.intro }}</div>
  </div>

  <div class="dl-page-image dl-page-image--band">
    {% if section.settings.hero_image != blank %}
      {{ section.settings.hero_image | image_url: width: 2200 | image_tag: loading: 'lazy', alt: section.settings.hero_image_alt, class: 'dl-image-tag' }}
    {% endif %}
  </div>

  <div class="dl-page-section">
    <h2>{{ section.settings.section_one_title }}</h2>
    <div class="rte">{{ section.settings.section_one_text }}</div>
  </div>

  <div class="dl-page-divider"></div>

  <div class="dl-page-section dl-page-section--center">
    <h2>{{ section.settings.waitlist_title }}</h2>
    <div class="rte">{{ section.settings.waitlist_text }}</div>
    <div class="dl-waitlist">
      <form method="post" action="/contact#pelletteria-waitlist" id="pelletteria-waitlist">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="pelletteria-waitlist">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.waitlist_placeholder }}" required>
        <button type="submit">{{ section.settings.waitlist_button }}</button>
      </form>
    </div>
  </div>

  <div class="dl-page-close">
    <div class="rte">{{ section.settings.close_text }}</div>
    <p><a href="mailto:{{ section.settings.concierge_email }}?subject=Pelletteria">{{ section.settings.concierge_email }}</a></p>
    <div class="dl-page-sig">{{ section.settings.signature }}</div>
  </div>
</section>

<style>
  .dl-page--pelletteria { color: #1a1a1a; font-family: 'Futura PT', 'Jost', sans-serif; font-weight: 300; line-height: 1.7; }
  .dl-page--pelletteria .dl-page-hero { text-align: center; padding: 80px 24px 40px; max-width: 720px; margin: 0 auto; }
  .dl-page--pelletteria .dl-page-eyebrow { font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: #6c6c6c; margin-bottom: 18px; }
  .dl-page--pelletteria .dl-page-title { font-family: 'Futura PT', sans-serif; font-weight: 300; font-size: 46px; letter-spacing: 0.005em; line-height: 1.15; margin: 0 0 22px; color: #1a1a1a; }
  .dl-page--pelletteria .dl-page-intro { font-family: 'Futura PT', sans-serif; font-style: italic; font-size: 20px; line-height: 1.55; color: #3a3a3a; max-width: 560px; margin: 0 auto; }
  .dl-page--pelletteria .dl-page-image { width: 100%; display: block; margin: 0 auto; background: #ffffff; border-top: 1px solid #ececec; border-bottom: 1px solid #ececec; }
  .dl-page--pelletteria .dl-image-tag { width: 100%; height: 100%; object-fit: cover; display: block; }
  .dl-page--pelletteria .dl-page-image--band { max-width: 1280px; aspect-ratio: 21/9; overflow: hidden; }
  .dl-page--pelletteria .dl-page-section { max-width: 680px; margin: 0 auto; padding: 70px 24px; }
  .dl-page--pelletteria .dl-page-section--center { text-align: center; }
  .dl-page--pelletteria .dl-page-section h2 { font-family: 'Futura PT', sans-serif; font-size: 28px; margin: 0 0 24px; line-height: 1.2; font-weight: 300; }
  .dl-page--pelletteria .dl-page-section p { font-size: 16px; margin: 0 0 16px; color: #2a2a2a; }
  .dl-page--pelletteria .dl-page-divider { width: 40px; height: 1px; background: #d4d4d0; margin: 0 auto; }
  .dl-page--pelletteria .dl-page-close { text-align: center; padding: 80px 24px 100px; max-width: 560px; margin: 0 auto; }
  .dl-page--pelletteria .dl-page-close p { font-size: 16px; color: #3a3a3a; margin: 0 0 14px; }
  .dl-page--pelletteria .dl-page-close .dl-page-sig { font-family: 'Futura PT', sans-serif; font-style: normal; font-size: 14px; color: #6c6c6c; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 22px; }
  .dl-page--pelletteria .dl-waitlist { max-width: 520px; margin: 20px auto 0; text-align: center; }
  .dl-page--pelletteria .dl-waitlist input[type=email] { width: 100%; padding: 14px 18px; border: 1px solid #1a1a1a; background: transparent; font-family: inherit; font-size: 14px; box-sizing: border-box; }
  .dl-page--pelletteria .dl-waitlist button { width: 100%; margin-top: 10px; padding: 14px 18px; background: #1a1a1a; color: #fafaf7; border: none; font-family: inherit; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; }
  .dl-page--pelletteria .dl-waitlist button:hover { background: #000; }
  @media (max-width: 768px) {
    .dl-page--pelletteria .dl-page-hero { padding: 56px 20px 32px; }
    .dl-page--pelletteria .dl-page-title { font-size: 34px; }
    .dl-page--pelletteria .dl-page-intro { font-size: 17px; }
    .dl-page--pelletteria .dl-page-section { padding: 50px 20px; }
    .dl-page--pelletteria .dl-page-image--band { aspect-ratio: 4/3; }
  }
</style>

{% schema %}
{
  "name": "SNC Pelletteria Page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "In preparation" },
    { "type": "text", "id": "title", "label": "Title", "default": "Pelletteria di Lusso" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>A new collection in leather. In the atelier now. Opening soon.</p>" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt", "default": "Pelletteria di Lusso" },
    { "type": "text", "id": "section_one_title", "label": "Section title", "default": "Leather, soon" },
    { "type": "richtext", "id": "section_one_text", "label": "Section text", "default": "<p>After the gold, the leather. The next De Leville collection will be pelletteria di lusso: small pieces shaped for the way a life is actually carried. Wallets, card holders, a bag of considered proportion.</p><p>Every piece will be made in the same spirit as the rings. 18-karat hardware. Full-grain leather. Made to order, delivered in a few weeks.</p>" },
    { "type": "text", "id": "waitlist_title", "label": "Waitlist title", "default": "The waitlist" },
    { "type": "richtext", "id": "waitlist_text", "label": "Waitlist text", "default": "<p>Leave your name. When the collection opens, the list is offered the pieces first, before the site.</p>" },
    { "type": "text", "id": "waitlist_placeholder", "label": "Waitlist input placeholder", "default": "Your email" },
    { "type": "text", "id": "waitlist_button", "label": "Waitlist button text", "default": "Join the waitlist" },
    { "type": "richtext", "id": "close_text", "label": "Closing text", "default": "<p>Questions about the collection? Write to the concierge.</p>" },
    { "type": "text", "id": "concierge_email", "label": "Concierge email", "default": "concierge@deleville.co" },
    { "type": "text", "id": "signature", "label": "Signature", "default": "De Leville · Since 1975" }
  ],
  "presets": [{ "name": "SNC Pelletteria Page" }]
}
{% endschema %}
