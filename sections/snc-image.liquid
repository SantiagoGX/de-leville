{% schema %}
{
  "name": "SNC Image",
  "class": "section--snc-image",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Top spacing",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 250,
      "step": 5,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "image_height",
      "min": 200,
      "max": 900,
      "step": 20,
      "unit": "px",
      "label": "Image height",
      "default": 500
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Dark overlay opacity",
      "default": 20
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Ownership Is Not Possession. It Is Stewardship"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 22
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "label": "Font size (Mobile)",
      "default": 16
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "400"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 200,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "label": "Max text width",
      "default": 500
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_position_h",
      "label": "Horizontal position",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_position_v",
      "label": "Vertical position",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Bottom" }
      ],
      "default": "center"
    }
  ],
  "presets": [
    {
      "name": "SNC Image"
    }
  ]
}
{% endschema %}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    overflow: visible !important;
    max-width: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .snc-image-wrapper[data-section-id="{{ section.id }}"] {
    position: relative;
    width: 100vw;
    left: 50%;
    transform: translateX(-50%);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .snc-image[data-section-id="{{ section.id }}"] {
    position: relative;
    width: 100%;
    height: {{ section.settings.image_height }}px;
    overflow: hidden;
    display: flex;
    align-items: {{ section.settings.text_position_v }};
    justify-content: {{ section.settings.text_position_h }};
  }

  .snc-image[data-section-id="{{ section.id }}"] .snc-image__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .snc-image[data-section-id="{{ section.id }}"] .snc-image__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  }

  .snc-image[data-section-id="{{ section.id }}"] .snc-image__text {
    position: relative;
    z-index: 2;
    max-width: {{ section.settings.max_width }}px;
    padding: 0 20px;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.font_size }}px;
    font-weight: {{ section.settings.font_weight }};
    font-family: var(--font-main, var(--font-heading-family, serif));
    text-align: {{ section.settings.text_align }};
    line-height: 1.3;
    margin: 0;
  }

  @media (max-width: 768px) {
    .snc-image[data-section-id="{{ section.id }}"] .snc-image__text {
      font-size: {{ section.settings.font_size_mobile }}px;
    }
  }
</style>

<div class="snc-image-wrapper" data-section-id="{{ section.id }}">
  <div class="snc-image" data-section-id="{{ section.id }}">

    {% if section.settings.image != blank %}
      <img
        class="snc-image__bg"
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ section.settings.text | escape }}"
        loading="lazy"
      >
    {% else %}
      <div class="snc-image__bg" style="background: #1a1a1a;"></div>
    {% endif %}

    <div class="snc-image__overlay"></div>

    {% if section.settings.text != blank %}
      <p class="snc-image__text">{{ section.settings.text }}</p>
    {% endif %}

  </div>
</div>
