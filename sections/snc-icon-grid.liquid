{% comment %}
  New section: SNC Icon Grid
  Allows for a title, description, and a grid of up to 6 icons with their own text.
  Also includes a final CTA button and link.
{% endcomment %}

{% schema %}
{
  "name": "SNC Icon Grid",
  "class": "section--snc-icon-grid",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "id": "section_border_radius",
      "label": "Section border radius",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "¿CÓMO GANAR PUNTOS?"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Earn points through purchases, registrations, social follows and more. Then redeem them for vouchers.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Header Styles"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size",
      "min": 16, "max": 48, "step": 1, "unit": "px", "default": 24
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "label": "Title font weight",
      "min": 100, "max": 900, "step": 100, "default": 700
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description color",
      "default": "#666"
    },
    {
      "type": "range",
      "id": "description_font_size",
      "label": "Description font size",
      "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16
    },
    {
      "type": "range",
      "id": "description_font_weight",
      "label": "Description font weight",
      "min": 100, "max": 900, "step": 100, "default": 400
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Horizontal gap between icons",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "grid_row_gap",
      "label": "Vertical gap between rows",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Text Styles (Icons)"
    },
    {
      "type": "color",
      "id": "kicker_color",
      "label": "Kicker color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "kicker_font_size",
      "label": "Kicker font size",
      "min": 10, "max": 24, "step": 1, "unit": "px", "default": 16
    },
    {
      "type": "range",
      "id": "kicker_font_weight",
      "label": "Kicker font weight",
      "min": 100, "max": 900, "step": 100, "default": 700
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#666"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Body text font size",
      "min": 10, "max": 20, "step": 1, "unit": "px", "default": 14
    },
    {
      "type": "range",
      "id": "text_font_weight",
      "label": "Body text font weight",
      "min": 100, "max": 900, "step": 100, "default": 400
    },
    {
      "type": "header",
      "content": "Final Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "REGÍSTRATE AHORA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "button_border_color",
      "label": "Border color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "button_border_width",
      "label": "Border width",
      "min": 0, "max": 5, "step": 1, "unit": "px", "default": 0
    },
    {
      "type": "range",
      "id": "button_padding_vertical",
      "label": "Vertical padding",
      "min": 5, "max": 30, "step": 1, "unit": "px", "default": 14
    },
    {
      "type": "range",
      "id": "button_padding_horizontal",
      "label": "Horizontal padding",
      "min": 10, "max": 60, "step": 1, "unit": "px", "default": 40
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Border radius",
      "min": 0, "max": 50, "step": 1, "unit": "px", "default": 30
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 10, "max": 24, "step": 1, "unit": "px", "default": 14
    },
    {
      "type": "range",
      "id": "button_font_weight",
      "label": "Font weight",
      "min": 100, "max": 900, "step": 100, "default": 700
    },
    {
      "type": "header",
      "content": "Final Button (Hover)"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Button background (Hover)",
      "default": "#1e3326"
    },
    {
      "type": "color",
      "id": "button_hover_text_color",
      "label": "Button text (Hover)",
      "default": "#fff"
    },
    {
      "type": "color",
      "id": "button_hover_border_color",
      "label": "Button border (Hover)",
      "default": "#1e3326"
    },
    {
      "type": "header",
      "content": "Final Link"
    },
    {
      "type": "text",
      "id": "final_link_text",
      "label": "Final link text",
      "default": "Already have an account?"
    },
    {
      "type": "url",
      "id": "final_link_url",
      "label": "Final link URL"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "icon_item",
      "name": "Icon item",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Kicker",
          "default": "Compra cualquier producto"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Main text",
          "default": "<p>1 punto cada vez que gastes 1MXN</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC Icon Grid",
      "blocks": [
        { "type": "icon_item" },
        { "type": "icon_item" },
        { "type": "icon_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
  .snc-icon-grid {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    border-radius: {{ section.settings.section_border_radius }}px;
    {%- if section.settings.full_width -%}
      width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
    {%- else -%}
      max-width: 1512px;
      margin-left: auto;
      margin-right: auto;
      width: calc(100% - 40px);
    {%- endif -%}
  }
  .snc-icon-grid--container {
    max-width: 1512px;
    margin: 0 auto;
    padding: 0 20px;
  }
  .snc-icon-grid--header {
    text-align: {{ section.settings.header_alignment }};
    margin-bottom: 50px;
  }
  .snc-icon-grid--title {
    font-family: var(--font-main);
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    margin: 0 0 15px 0;
  }
  .snc-icon-grid--description {
    font-family: var(--font-main);
    font-size: {{ section.settings.description_font_size }}px;
    font-weight: {{ section.settings.description_font_weight }};
    color: {{ section.settings.description_color }};
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto;
  }
  .snc-icon-grid--description p {
    margin: 0;
  }
  .snc-icon-grid--grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    column-gap: {{ section.settings.grid_gap }}px;
    row-gap: {{ section.settings.grid_row_gap | default: 50 }}px;
    margin-bottom: 50px;
  }
  .snc-icon-grid--item {
    text-align: center;
  }
  .snc-icon-grid--icon-holder {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    margin: 0 auto 20px auto;
  }
  .snc-icon-grid--icon-holder img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .snc-icon-grid--kicker {
    font-family: var(--font-main);
    font-size: var(--kicker-size);
    font-weight: var(--kicker-weight);
    color: var(--kicker-color);
    margin: 0 0 8px 0;
  }
  .snc-icon-grid--text {
    font-family: var(--font-main);
    font-size: var(--text-size);
    font-weight: var(--text-weight);
    color: var(--text-color);
    line-height: 1.5;
  }
  .snc-icon-grid--text p {
    margin: 0;
  }
  .snc-icon-grid--footer {
    text-align: center;
  }
  .snc-icon-grid--button {
    display: inline-block;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    padding: {{ section.settings.button_padding_vertical }}px {{ section.settings.button_padding_horizontal }}px;
    border-radius: {{ section.settings.button_border_radius }}px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    text-decoration: none;
    font-family: var(--font-main);
    font-weight: {{ section.settings.button_font_weight }};
    font-size: {{ section.settings.button_font_size }}px;
    transition: all 0.2s ease;
    margin-bottom: 15px;
  }
  .snc-icon-grid--button:hover {
    background-color: {{ section.settings.button_hover_bg_color }};
    color: {{ section.settings.button_hover_text_color }};
    border-color: {{ section.settings.button_hover_border_color }};
  }
  .snc-icon-grid--final-link {
    font-family: var(--font-main);
    font-size: 14px;
    color: #666;
    text-decoration: underline;
  }
  .snc-icon-grid--final-link:hover {
    color: #000000;
  }

  @media (max-width: 768px) {
    .snc-icon-grid--grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }
</style>

<div class="snc-icon-grid" style="
  --kicker-color: {{ section.settings.kicker_color }};
  --kicker-size: {{ section.settings.kicker_font_size }}px;
  --kicker-weight: {{ section.settings.kicker_font_weight }};
  --text-color: {{ section.settings.text_color }};
  --text-size: {{ section.settings.text_font_size }}px;
  --text-weight: {{ section.settings.text_font_weight }};
">
  <div class="snc-icon-grid--container">
    <div class="snc-icon-grid--header">
      {%- if section.settings.title != blank -%}
        <h2 class="snc-icon-grid--title">{{ section.settings.title }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="snc-icon-grid--description rte">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="snc-icon-grid--grid">
        {%- for block in section.blocks -%}
          <div class="snc-icon-grid--item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="snc-icon-grid--icon-holder">
                <img src="{{ block.settings.icon | image_url: width: 100 }}" alt="{{ block.settings.kicker | escape }}" loading="lazy">
              </div>
            {%- endif -%}
            {%- if block.settings.kicker != blank -%}
              <h3 class="snc-icon-grid--kicker">{{ block.settings.kicker }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="snc-icon-grid--text rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="snc-icon-grid--footer">
      {%- if section.settings.button_text != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="snc-icon-grid--button">
          {{ section.settings.button_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.final_link_text != blank -%}
        <div>
          <a href="{{ section.settings.final_link_url | default: '#' }}" class="snc-icon-grid--final-link">
            {{ section.settings.final_link_text }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>