{% comment %}
  404.liquid - De Leville Full Viewport Error Page
  Occupies 100% screen, no white borders, white text
{% endcomment %}

<section 
  id="error-404-section"
  class="error-404"
  data-section-id="{{ section.id }}"
  style="
    --bg-color: {{ section.settings.background_color | default: '#000000' }};
    --text-color: {{ section.settings.text_color | default: '#ffffff' }};
    --accent-color: {{ section.settings.accent_color | default: '#c9a961' }};
  "
>
  <div class="error-404__container">
    
    {% comment %} Ambient glow {% endcomment %}
    <div class="error-404__ambient">
      <div class="ambient-glow ambient-glow--1"></div>
      <div class="ambient-glow ambient-glow--2"></div>
    </div>

    {% comment %} Main content {% endcomment %}
    <div class="error-404__content">
      
      {% comment %} 404 Code {% endcomment %}
      <div class="error-404__code-wrapper">
        <h1 class="error-404__code">
          <span class="digit" data-digit="4">4</span>
          <span class="digit digit--icon">
            {% if section.settings.custom_icon != blank %}
              <span class="custom-icon">{{ section.settings.custom_icon }}</span>
            {% else %}
              <svg class="luxury-icon" viewBox="0 0 100 100" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M50 15 L85 40 L50 85 L15 40 Z" />
                <path d="M15 40 L85 40" />
                <path d="M50 15 L50 40" />
                <path d="M30 25 L50 40 L70 25" />
                <circle cx="50" cy="60" r="3" fill="currentColor" stroke="none"/>
              </svg>
            {% endif %}
          </span>
          <span class="digit" data-digit="4">4</span>
        </h1>
      </div>

      {% comment %} Text Content {% endcomment %}
      <div class="error-404__text">
        <h2 class="error-404__title">{{ section.settings.heading | default: 'Page not found' | escape }}</h2>
        <p class="error-404__subtitle">{{ section.settings.subtext | default: "Sorry, we couldn't find what you're looking for. It might have been moved or no longer exists." | escape }}</p>
      </div>

      {% comment %} Single CTA {% endcomment %}
      <div class="error-404__actions">
        <a href="{{ routes.root_url }}" class="error-404__link">
          <span class="link-text">{{ section.settings.button_home | default: 'Back to Home' | escape }}</span>
          <span class="link-line"></span>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* Reset any inherited margins */
  #error-404-section,
  #error-404-section * {
    box-sizing: border-box;
  }
  
  .error-404 {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-color);
    color: var(--text-color);
    overflow: hidden;
    margin: 0;
    padding: 0;
    z-index: 1;
  }

  .error-404__container {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Remove any page-width constraints */
  .error-404 .page-width {
    max-width: 100%;
    padding: 0;
    margin: 0;
  }

  .error-404__content {
    text-align: center;
    position: relative;
    z-index: 20;
    width: 100%;
    max-width: 900px;
    padding: 2rem;
  }

  /* Ambient glow - subtle */
  .error-404__ambient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.2;
    background: var(--accent-color);
  }

  .ambient-glow--1 {
    width: 50vw;
    height: 50vw;
    max-width: 600px;
    max-height: 600px;
    top: 10%;
    right: 10%;
    animation: drift 20s infinite ease-in-out;
  }

  .ambient-glow--2 {
    width: 40vw;
    height: 40vw;
    max-width: 500px;
    max-height: 500px;
    bottom: 10%;
    left: 10%;
    background: var(--accent-color);
    opacity: 0.1;
    animation: drift 25s infinite ease-in-out reverse;
  }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-30px, 30px) scale(1.1); }
  }

  /* 404 Code */
  .error-404__code-wrapper {
    position: relative;
    display: inline-block;
    margin-bottom: 3rem;
  }

  .error-404__code {
    font-size: clamp(7rem, 15vw, 14rem);
    font-weight: 300;
    line-height: 1;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    letter-spacing: 0.05em;
    font-family: var(--font-heading-family), 'Helvetica Neue', Arial, sans-serif;
    color: var(--text-color);
  }

  .digit {
    display: inline-block;
    opacity: 0;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .digit[data-digit="4"]:first-child { animation-delay: 0.2s; }
  .digit[data-digit="4"]:last-child { animation-delay: 0.6s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Center icon */
  .digit--icon {
    width: clamp(4rem, 10vw, 8rem);
    height: clamp(4rem, 10vw, 8rem);
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    animation: fadeInRotate 2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.4s;
  }

  @keyframes fadeInRotate {
    from {
      opacity: 0;
      transform: rotate(-180deg) scale(0.5);
    }
    to {
      opacity: 1;
      transform: rotate(0deg) scale(1);
    }
  }

  .luxury-icon {
    width: 100%;
    height: 100%;
    animation: slowRotate 30s linear infinite;
    filter: drop-shadow(0 0 15px rgba(201, 169, 97, 0.4));
  }

  @keyframes slowRotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Text styling - WHITE and visible */
  .error-404__text {
    margin-bottom: 4rem;
    opacity: 0;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 0.8s;
  }

  .error-404__title {
    font-size: clamp(1.25rem, 3vw, 2rem);
    font-weight: 400;
    margin: 0 0 1.5rem;
    font-family: var(--font-heading-family), 'Helvetica Neue', Arial, sans-serif;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #ffffff;
  }

  .error-404__subtitle {
    font-size: clamp(0.875rem, 2vw, 1.125rem);
    color: #ffffff;
    opacity: 0.9;
    max-width: 500px;
    margin: 0 auto;
    line-height: 1.8;
    font-weight: 300;
    letter-spacing: 0.02em;
  }

  /* Elegant Link */
  .error-404__actions {
    opacity: 0;
    animation: fadeInUp 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: 1s;
  }

  .error-404__link {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: #ffffff;
    position: relative;
    padding: 1rem 0;
    transition: color 0.4s ease;
  }

  .link-text {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .link-line {
    width: 100%;
    height: 1px;
    background: #ffffff;
    margin-top: 0.5rem;
    position: relative;
    overflow: hidden;
    transition: background 0.4s ease;
  }

  .link-line::after {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: var(--accent-color);
    transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .error-404__link:hover {
    color: var(--accent-color);
  }

  .error-404__link:hover .link-line::after {
    left: 0;
  }

  /* Responsive */
  @media screen and (max-width: 749px) {
    .error-404__content {
      padding: 1.5rem;
    }
    
    .error-404__code {
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .digit, .luxury-icon, .error-404__text, .error-404__actions {
      animation: none !important;
      opacity: 1 !important;
    }
  }
</style>

<script>
  (function() {
    'use strict';
    
    document.addEventListener('DOMContentLoaded', function() {
      const section = document.getElementById('error-404-section');
      if (!section) return;
      
      const digits = section.querySelectorAll('.digit');
      
      // Force full viewport coverage
      document.body.style.margin = '0';
      document.body.style.padding = '0';
      document.documentElement.style.margin = '0';
      document.documentElement.style.padding = '0';
      
      // Parallax effect
      if (window.matchMedia('(pointer: fine)').matches) {
        const code = section.querySelector('.error-404__code');
        document.addEventListener('mousemove', function(e) {
          const xPos = (e.clientX / window.innerWidth - 0.5) * 20;
          const yPos = (e.clientY / window.innerHeight - 0.5) * 20;
          if (code) code.style.transform = `translate(${xPos}px, ${yPos}px)`;
        });
      }
    });
  })();
</script>

{% schema %}
{
  "name": "404 Page",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#c9a961"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Page not found"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Description",
      "default": "Sorry, we couldn't find what you're looking for. It might have been moved or no longer exists."
    },
    {
      "type": "html",
      "id": "custom_icon",
      "label": "Custom center icon (SVG)"
    },
    {
      "type": "text",
      "id": "button_home",
      "label": "Home link text",
      "default": "Back to Home"
    }
  ],
  "presets": [
    {
      "name": "404 Page"
    }
  ]
}
{% endschema %}