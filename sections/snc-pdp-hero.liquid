  {%- comment -%}
    De Leville · PDP breadcrumb (Tiffany / Cartier convention — anchored at
    the bottom of the page, after any related-products block). When a future
    "You may also like" section is added, the breadcrumb naturally sits below it.
  {%- endcomment -%}
  {%- if product and section.settings.show_breadcrumb != false -%}

    {%- comment -%} Family: prefer Shopify collection assignment, fall back to title parsing. {%- endcomment -%}
    {%- assign bc_family = '' -%}
    {%- assign bc_family_url = '/collections/all' -%}
    {%- if product.collections.size > 0 -%}
      {%- assign bc_family = product.collections.first.title -%}
      {%- assign bc_family_url = product.collections.first.url -%}
    {%- endif -%}

    {%- assign bc_parts = product.title | split: ',' -%}
    {%- assign bc_left = bc_parts[0] | strip -%}
    {%- assign bc_color = bc_parts[1] | default: '' | strip -%}

    {%- if bc_family == blank -%}
      {%- if bc_left contains 'Mezza Luna' -%}
        {%- assign bc_family = 'Mezza Luna' -%}
        {%- assign bc_family_url = '/collections/mezza-luna' -%}
      {%- elsif bc_left contains ' ' -%}
        {%- assign bc_words = bc_left | split: ' ' -%}
        {%- assign bc_family = bc_words | first -%}
        {%- assign bc_family_url = '/collections/' | append: bc_family | downcase -%}
      {%- else -%}
        {%- assign bc_family = bc_left -%}
      {%- endif -%}
    {%- endif -%}

    {%- assign bc_sub = bc_left | remove_first: bc_family | strip -%}
    {%- assign bc_type_singular = product.type | default: '' | strip -%}
    {%- if bc_type_singular != blank -%}
      {%- assign bc_sub = bc_sub | remove: bc_type_singular | strip -%}
      {%- assign bc_type_plural = bc_type_singular | append: 's' -%}
      {%- assign bc_sub = bc_sub | remove: bc_type_plural | strip -%}
    {%- endif -%}

    {%- assign bc_type = '' -%}
    {%- if bc_type_singular != blank -%}
      {%- assign bc_last_char = bc_type_singular | slice: -1 -%}
      {%- if bc_last_char == 's' -%}
        {%- assign bc_type = bc_type_singular -%}
      {%- else -%}
        {%- assign bc_type = bc_type_singular | append: 's' -%}
      {%- endif -%}
    {%- endif -%}

    {%- assign bc_type_handle = bc_type | downcase -%}
    {%- assign bc_type_url = '' -%}
    {%- if bc_type_handle != blank and collections[bc_type_handle] != blank -%}
      {%- assign bc_type_url = '/collections/' | append: bc_type_handle -%}
    {%- endif -%}

    {%- assign bc_current = '' -%}
    {%- if bc_sub != blank and bc_color != blank -%}
      {%- assign bc_current = bc_sub | append: ', ' | append: bc_color -%}
    {%- elsif bc_sub != blank -%}
      {%- assign bc_current = bc_sub -%}
    {%- elsif bc_color != blank -%}
      {%- assign bc_current = bc_color -%}
    {%- endif -%}
    <nav class="pdp-hero--breadcrumb pdp-hero--breadcrumb--bottom" data-pdp-breadcrumb aria-label="Breadcrumb">
      <a href="{{ routes.root_url | default: '/' }}">Home</a>
      {%- if bc_family != blank -%}
        <span class="pdp-hero--breadcrumb-sep" aria-hidden="true">/</span>
        <a href="{{ bc_family_url }}">{{ bc_family }}</a>
      {%- endif -%}
      {%- if bc_current != blank -%}
        <span class="pdp-hero--breadcrumb-sep" aria-hidden="true">/</span>
        <span aria-current="page">{{ bc_current }}</span>
      {%- endif -%}
    </nav>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ shop.url }}/" },
        { "@type": "ListItem", "position": 2, "name": "Collections", "item": "{{ shop.url }}/collections" }
        {%- assign bc_pos = 2 -%}
        {%- if bc_family != blank -%}
          {%- assign bc_pos = bc_pos | plus: 1 -%}
        , { "@type": "ListItem", "position": {{ bc_pos }}, "name": "{{ bc_family | escape }}", "item": "{{ shop.url }}{{ bc_family_url }}" }
        {%- endif -%}
        {%- if bc_type != blank -%}
          {%- assign bc_pos = bc_pos | plus: 1 -%}
        , { "@type": "ListItem", "position": {{ bc_pos }}, "name": "{{ bc_type | escape }}"{% if bc_type_url != blank %}, "item": "{{ shop.url }}{{ bc_type_url }}"{% endif %} }
        {%- endif -%}
        {%- if bc_sub != blank -%}
          {%- assign bc_pos = bc_pos | plus: 1 -%}
        , { "@type": "ListItem", "position": {{ bc_pos }}, "name": "{{ bc_sub | escape }}" }
        {%- endif -%}
        {%- if bc_color != blank -%}
          {%- assign bc_pos = bc_pos | plus: 1 -%}
        , { "@type": "ListItem", "position": {{ bc_pos }}, "name": "{{ bc_color | escape }}" }
        {%- endif -%}
      ]
    }
    </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "@id": "{{ shop.url }}{{ product.url }}#product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncate: 300 | json }},
    "brand": { "@type": "Brand", "name": "De Leville" },
    "url": "{{ shop.url }}{{ product.url }}"
    {%- if product.featured_image -%}
    ,"image": "https:{{ product.featured_image | image_url: width: 1200 }}"
    {%- endif -%}
    {%- if product.variants.size > 0 -%}
    ,"hasVariant": [
      {%- for variant in product.variants -%}
      {
        "@type": "Product",
        "name": {{ variant.title | json }},
        "sku": {{ variant.sku | json }},
        "offers": {
          "@type": "Offer",
          "price": "{{ variant.price | money_without_currency | remove: ',' }}",
          "priceCurrency": "{{ cart.currency.iso_code }}",
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": "{{ shop.url }}{{ product.url }}?variant={{ variant.id }}"
        }
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
    {%- endif -%}
  }
  </script>
  {%- endif -%}

<script>
(function () {
  'use strict';

  var PDPAjax = {
    pending: false,
    cache: {},

    init: function () {
      /* Prefetch on hover/touchstart so content is ready before click */
      document.addEventListener('mouseover', function (e) {
        var pill = e.target.closest('.pdp-variant-selector__pill');
        if (!pill || pill.classList.contains('is-active')) return;
        PDPAjax.prefetch(pill.getAttribute('href'));
      });
      document.addEventListener('touchstart', function (e) {
        var pill = e.target.closest('.pdp-variant-selector__pill');
        if (!pill || pill.classList.contains('is-active')) return;
        PDPAjax.prefetch(pill.getAttribute('href'));
      }, { passive: true });

      document.addEventListener('click', function (e) {
        var pill = e.target.closest('.pdp-variant-selector__pill');
        if (!pill || pill.classList.contains('is-active')) return;
        e.preventDefault();
        PDPAjax.navigate(pill.getAttribute('href'));
      });
      window.addEventListener('popstate', function (e) {
        if (e.state && e.state.pdpAjax) PDPAjax.navigate(location.href, true);
      });
    },

    prefetch: function (url) {
      if (!url || PDPAjax.cache[url]) return;
      PDPAjax.cache[url] = fetch(url).then(function (r) { return r.text(); });
    },

    navigate: function (url, isPop) {
      if (PDPAjax.pending) return;
      PDPAjax.pending = true;
      var root = document.querySelector('[data-section-type="snc-pdp-hero"]');
      if (!root) { window.location.href = url; return; }

      /* Instant dim — no slow fade-out wait */
      root.style.transition = 'none';
      root.style.opacity = '0.5';
      root.style.pointerEvents = 'none';

      var fetchPromise = PDPAjax.cache[url] || fetch(url).then(function (r) { return r.text(); });
      PDPAjax.cache[url] = fetchPromise;

      fetchPromise
        .then(function (html) {
          PDPAjax.swap(root, html);
          if (!isPop) history.pushState({ pdpAjax: true }, document.title, url);
        })
        .catch(function () { window.location.href = url; })
        .finally(function () {
          PDPAjax.pending = false;
          root.style.transition = 'opacity 0.12s ease';
          root.style.opacity = '1';
          root.style.pointerEvents = '';
          setTimeout(function () { root.style.transition = ''; }, 150);
        });
    },

    swap: function (root, html) {
      var doc = new DOMParser().parseFromString(html, 'text/html');
      document.title = doc.title;

      PDPAjax.zone(root, doc, '[data-pdp-images]');
      PDPAjax.zone(root, doc, '[data-pdp-title]');
      PDPAjax.zone(root, doc, '[data-pdp-price]');
      PDPAjax.zone(root, doc, '[data-pdp-size-zone]');
      PDPAjax.zone(root, doc, '[data-pdp-breadcrumb]');

      /* Variant selector — swap outerHTML to update active pill */
      var oldSel = root.querySelector('.pdp-variant-selector');
      var newSel = doc.querySelector('.pdp-variant-selector');
      if (oldSel && newSel) oldSel.outerHTML = newSel.outerHTML;

      /* data-initial-variant-id */
      var newRoot = doc.querySelector('[data-section-type="snc-pdp-hero"]');
      if (newRoot) root.setAttribute('data-initial-variant-id', newRoot.getAttribute('data-initial-variant-id') || '');

      /* Reset size selection */
      PDPAjax.resetSize(root);

      /* Mobile: reset image strip scroll + update progress bar */
      var imgWrap = root.querySelector('[data-pdp-images]');
      var bar = root.querySelector('.pdp-hero--mobile-progress-bar');
      if (imgWrap) {
        imgWrap.scrollLeft = 0;
        if (bar) {
          var n = imgWrap.querySelectorAll('img').length || 1;
          bar.style.width = (100 / n) + '%';
        }
      }
      var imgCont = root.querySelector('.pdp-hero--image-container');
      if (imgCont) imgCont.scrollLeft = 0;

      /* Sticky bar */
      PDPAjax.syncEl('.pdp-sticky-bar--title', doc, '.pdp-sticky-bar--title');
      PDPAjax.syncEl('[data-pdp-sticky-price]', doc, '[data-pdp-sticky-price]');

      /* Close open accordions */
      root.querySelectorAll('.pdp-hero--accordion.is-open').forEach(function (a) { a.classList.remove('is-open'); });
    },

    zone: function (root, doc, sel) {
      var a = root.querySelector(sel);
      var b = doc.querySelector(sel);
      if (a && b) a.innerHTML = b.innerHTML;
    },

    syncEl: function (selA, doc, selB) {
      var a = document.querySelector(selA);
      var b = doc.querySelector(selB);
      if (a && b) a.innerHTML = b.innerHTML;
    },

    resetSize: function (root) {
      root.querySelectorAll('.pdp-hero--size-pill').forEach(function (p) {
        p.classList.remove('is-selected');
        p.setAttribute('aria-checked', 'false');
      });
      root.querySelectorAll('.pdp-hero--size-button.is-selected').forEach(function (b) { b.classList.remove('is-selected'); });
      var ri = root.querySelector('[data-ring-size]');
      if (ri) ri.value = '';
      var tl = root.querySelector('[data-size-trigger-label]');
      if (tl) tl.textContent = 'Select a size';
      var trigger = root.querySelector('[data-size-trigger]');
      if (trigger) {
        trigger.setAttribute('aria-expanded', 'false');
        trigger.classList.add('is-placeholder');
      }
      var panel = root.querySelector('[data-size-panel]');
      if (panel) { panel.classList.remove('is-open'); panel.setAttribute('aria-hidden', 'true'); }
    }
  };

  PDPAjax.init();
}());
</script>

<!-- De Leville: Atelier Consultation Modal -->
<div id="dl-atelier-modal" class="dl-atelier-modal" role="dialog" aria-modal="true" aria-label="Speak with our atelier" hidden>
  <div class="dl-atelier-modal__overlay" data-close-modal></div>
  <div class="dl-atelier-modal__panel">
    <button class="dl-atelier-modal__close" data-close-modal aria-label="Close">&#10005;</button>

    <div class="dl-atelier-modal__head">
      <p class="dl-atelier-modal__eyebrow">De Leville Atelier</p>
      <h2 class="dl-atelier-modal__title">Speak with our atelier</h2>
      <p class="dl-atelier-modal__subtitle">Our team in Rome is available to guide you through any question — from sizing to personalization.</p>
    </div>

    <form class="dl-atelier-modal__form" id="dlAtelierForm" novalidate>
      <input type="hidden" name="form_type" value="contact">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="contact[tags]" value="atelier-consultation">
      <input type="hidden" name="contact[subject]" id="dlAtelierSubject" value="Atelier Consultation Request — {{ product.title | escape }}">

      <div class="dl-atelier-modal__field">
        <label for="dlAtelierName">Your name</label>
        <input type="text" id="dlAtelierName" name="contact[name]" autocomplete="name" required placeholder="Isabella M.">
        <span class="dl-atelier-modal__error" data-error="name"></span>
      </div>

      <div class="dl-atelier-modal__field">
        <label for="dlAtelierEmail">Email address</label>
        <input type="email" id="dlAtelierEmail" name="contact[email]" autocomplete="email" required placeholder="you@email.com">
        <span class="dl-atelier-modal__error" data-error="email"></span>
      </div>

      <div class="dl-atelier-modal__field">
        <label for="dlAtelierMessage">How can we help you? <span class="dl-atelier-modal__optional">(optional)</span></label>
        <textarea id="dlAtelierMessage" name="contact[body]" rows="4" placeholder="I'm interested in the {{ product.title | escape }}…"></textarea>
      </div>

      <button type="submit" class="dl-atelier-modal__submit" id="dlAtelierSubmit">
        <span class="dl-atelier-modal__submit-label">Send to the atelier</span>
        <span class="dl-atelier-modal__submit-spinner" aria-hidden="true"></span>
      </button>
    </form>

    <div class="dl-atelier-modal__success" id="dlAtelierSuccess" hidden>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
      <p class="dl-atelier-modal__success-title">Message received</p>
      <p class="dl-atelier-modal__success-body">We'll be in touch within one business day.</p>
    </div>

  </div>
</div>

<style>
  .dl-atelier-modal {
    position: fixed; inset: 0; z-index: 100000;
    display: flex; align-items: center; justify-content: center;
  }
  .dl-atelier-modal[hidden] { display: none; }
  .dl-atelier-modal__overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.55);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    cursor: pointer;
  }
  .dl-atelier-modal__panel {
    position: relative; z-index: 1;
    background: #fff;
    width: min(520px, calc(100vw - 32px));
    max-height: calc(100dvh - 40px);
    overflow-y: auto;
    padding: 48px 44px 44px;
    overscroll-behavior: contain;
    animation: dlModalIn 280ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  @keyframes dlModalIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .dl-atelier-modal__close {
    position: absolute; top: 20px; right: 22px;
    background: none; border: none; cursor: pointer;
    font-size: 14px; color: #999; padding: 6px;
    line-height: 1; transition: color 0.2s;
  }
  .dl-atelier-modal__close:hover { color: #111; }
  .dl-atelier-modal__eyebrow {
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 9px; font-weight: 400; letter-spacing: 0.26em;
    text-transform: uppercase; color: #999; margin: 0 0 14px;
  }
  .dl-atelier-modal__title {
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 22px; font-weight: 400; letter-spacing: 0.02em;
    color: #111; margin: 0 0 10px; line-height: 1.2;
  }
  .dl-atelier-modal__subtitle {
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 13px; font-weight: 300; line-height: 1.65;
    color: #666; margin: 0 0 32px;
  }
  .dl-atelier-modal__form { display: flex; flex-direction: column; gap: 20px; }
  .dl-atelier-modal__field { display: flex; flex-direction: column; gap: 7px; }
  .dl-atelier-modal__field label {
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 10px; font-weight: 400; letter-spacing: 0.14em;
    text-transform: uppercase; color: #444;
  }
  .dl-atelier-modal__optional { color: #aaa; font-size: 9px; text-transform: none; letter-spacing: 0; }
  .dl-atelier-modal__field input,
  .dl-atelier-modal__field textarea {
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 14px; font-weight: 300; color: #111;
    background: #fafaf8; border: 1px solid #e8e8e4;
    padding: 13px 16px; outline: none;
    transition: border-color 0.2s; resize: none; width: 100%;
    border-radius: 0;
    -webkit-appearance: none;
  }
  .dl-atelier-modal__field input:focus,
  .dl-atelier-modal__field textarea:focus { border-color: #111; }
  .dl-atelier-modal__field input.is-invalid,
  .dl-atelier-modal__field textarea.is-invalid { border-color: #c0392b; }
  .dl-atelier-modal__error {
    font-size: 11px; color: #c0392b; min-height: 14px;
    font-family: 'Futura PT', var(--font-main), sans-serif;
  }
  .dl-atelier-modal__submit {
    margin-top: 8px;
    background: #111; color: #fff; border: none; cursor: pointer;
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 10px; font-weight: 400; letter-spacing: 0.18em;
    text-transform: uppercase; padding: 16px 32px;
    border-radius: 999px; display: flex; align-items: center;
    justify-content: center; gap: 10px;
    transition: background 0.2s, opacity 0.2s;
  }
  .dl-atelier-modal__submit:hover { background: #000; }
  .dl-atelier-modal__submit:disabled { opacity: 0.5; cursor: default; }
  .dl-atelier-modal__submit-spinner {
    display: none; width: 14px; height: 14px;
    border: 1.5px solid rgba(255,255,255,0.3);
    border-top-color: #fff; border-radius: 50%;
    animation: dlSpin 0.7s linear infinite;
  }
  .dl-atelier-modal__submit.is-loading .dl-atelier-modal__submit-label { display: none; }
  .dl-atelier-modal__submit.is-loading .dl-atelier-modal__submit-spinner { display: block; }
  @keyframes dlSpin { to { transform: rotate(360deg); } }
  .dl-atelier-modal__success {
    display: flex; flex-direction: column; align-items: center;
    gap: 12px; padding: 20px 0; text-align: center;
  }
  .dl-atelier-modal__success svg {
    width: 36px; height: 36px; color: #111;
  }
  .dl-atelier-modal__success-title {
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 18px; font-weight: 400; color: #111; margin: 0;
  }
  .dl-atelier-modal__success-body {
    font-family: 'Futura PT', var(--font-main), sans-serif;
    font-size: 13px; font-weight: 300; color: #888; margin: 0;
  }
  @media (max-width: 600px) {
    .dl-atelier-modal__panel { padding: 40px 24px 32px; }
  }
</style>

<script>
(function () {
  var modal = document.getElementById('dl-atelier-modal');
  var form  = document.getElementById('dlAtelierForm');
  var success = document.getElementById('dlAtelierSuccess');
  if (!modal) return;

  function openModal() {
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    modal.querySelector('.dl-atelier-modal__panel').focus();
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-open-atelier-modal]').forEach(function (el) {
    el.addEventListener('click', openModal);
  });

  modal.querySelectorAll('[data-close-modal]').forEach(function (el) {
    el.addEventListener('click', closeModal);
  });

  document.addEventListener('keydown', function (e) {
    if (!modal.hidden && e.key === 'Escape') closeModal();
  });

  if (!form) return;

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var valid = true;

    var nameEl  = document.getElementById('dlAtelierName');
    var emailEl = document.getElementById('dlAtelierEmail');

    [nameEl, emailEl].forEach(function (el) {
      el.classList.remove('is-invalid');
      var errEl = form.querySelector('[data-error="' + el.id.replace('dlAtelier','').toLowerCase() + '"]');
      if (errEl) errEl.textContent = '';
    });

    if (!nameEl.value.trim()) {
      nameEl.classList.add('is-invalid');
      var e1 = form.querySelector('[data-error="name"]');
      if (e1) e1.textContent = 'Please enter your name.';
      valid = false;
    }
    if (!emailEl.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailEl.value)) {
      emailEl.classList.add('is-invalid');
      var e2 = form.querySelector('[data-error="email"]');
      if (e2) e2.textContent = 'Please enter a valid email address.';
      valid = false;
    }
    if (!valid) return;

    var btn = document.getElementById('dlAtelierSubmit');
    btn.disabled = true;
    btn.classList.add('is-loading');

    var params = new URLSearchParams(new FormData(form)).toString();

    fetch('/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params
    })
    .then(function (res) {
      if (res.ok || res.redirected) {
        form.hidden = true;
        success.hidden = false;
        modal.querySelector('.dl-atelier-modal__head').hidden = true;
      } else {
        throw new Error('server error');
      }
    })
    .catch(function () {
      btn.disabled = false;
      btn.classList.remove('is-loading');
      alert('Something went wrong. Please try again or email us at concierge@deleville.co');
    });
  });
}());
</script>

