          {%- assign accordion_background = block.settings.background_color | default: '#FAFAFA' -%}
        {%- assign accordion_border_radius = block.settings.border_radius | default: 5 -%}
        {%- assign accordion_border_color = block.settings.border_color | default: '#E5E5E5' -%}
        {%- assign accordion_border_width = block.settings.border_width | default: 1 -%}
        {%- assign accordion_margin_top = block.settings.margin_top | default: 0 -%}
          {%- assign border_position = block.settings.border_position | default: 'both' -%}
          {%- assign border_top_width = 0 -%}
          {%- assign border_bottom_width = 0 -%}
          {%- if border_position == 'both' or border_position == 'top' -%}
            {%- assign border_top_width = accordion_border_width -%}
          {%- endif -%}
          {%- if border_position == 'both' or border_position == 'bottom' -%}
            {%- assign border_bottom_width = accordion_border_width -%}
          {%- endif -%}
          {%- assign title_size = block.settings.title_size | default: 16 -%}
          {%- assign title_weight = block.settings.title_weight | default: 600 -%}
          {%- assign title_color = block.settings.title_color | default: '#000000' -%}
          {%- assign button_padding_vertical = block.settings.button_padding_vertical | default: 20 -%}
          {%- assign button_padding_horizontal = block.settings.button_padding_horizontal | default: 20 -%}
          {%- assign content_padding_vertical = block.settings.content_padding_vertical | default: 20 -%}
          {%- assign content_padding_horizontal = block.settings.content_padding_horizontal | default: 20 -%}

          {%- assign use_metafield = block.settings.use_metafield | default: false -%}
          {%- assign metafield_content = product.metafields.custom.specifications -%}

          {%- capture accordion_style -%}
            --accordion-background: {{ accordion_background }};
            --accordion-border-radius: {{ accordion_border_radius }}px;
            --accordion-border-color: {{ accordion_border_color }};
            --accordion-border-top-width: {{ border_top_width }}px;
            --accordion-border-bottom-width: {{ border_bottom_width }}px;
            --accordion-margin-top: {{ accordion_margin_top }}px;
            --accordion-title-hover-bg: {{ block.settings.title_hover_bg_color | default: '#F0F0F0' }};
          {%- endcapture -%}
          {%- capture button_style -%}
            --accordion-title-size: {{ title_size }}px;
            --accordion-title-weight: {{ title_weight }};
            --accordion-title-color: {{ title_color }};
            --accordion-button-padding-vertical: {{ button_padding_vertical }}px;
            --accordion-button-padding-horizontal: {{ button_padding_horizontal }}px;
            --accordion-title-transform: {{ block.settings.title_text_transform | default: 'none' }};
          {%- endcapture -%}
          {%- capture content_style -%}
            --accordion-content-padding-vertical: {{ content_padding_vertical }}px;
            --accordion-content-padding-horizontal: {{ content_padding_horizontal }}px;
          {%- endcapture -%}

          {%- if use_metafield and metafield_content != blank -%}
            {%- assign accordion_content = metafield_content -%}
            {%- assign accordion_title = block.settings.title | default: 'Specifications' -%}
          {%- else -%}
            {%- assign accordion_content = block.settings.content -%}
            {%- assign accordion_title = block.settings.title | default: 'More information' -%}
          {%- endif -%}

          {%- if use_metafield == false or metafield_content != blank or block.settings.content != blank -%}
            <div class="pdp-hero--accordion" data-accordion data-accordion-id="{{ block.id }}" style="{{ accordion_style | strip_newlines }}">
              <button type="button" class="pdp-hero--accordion-button" data-accordion-toggle style="{{ button_style | strip_newlines }}">
                <span>{{ accordion_title }}</span>
                <span class="pdp-hero--accordion-arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" role="presentation" focusable="false">
                    <path d="M3.5 5.5L8 10l4.5-4.5"></path>
                  </svg>
                </span>
              </button>
              <div class="pdp-hero--accordion-content" style="{{ content_style | strip_newlines }}">
                <div class="pdp-hero--accordion-text">
                  {%- comment -%} De Leville: if pulling from a multi_line metafield, render each line as its own row. Otherwise, render rich text as-is. {%- endcomment -%}
                  {%- if use_metafield and metafield_content != blank -%}
                    <ul class="pdp-hero--spec-list">
                      {%- assign _spec_lines = metafield_content | newline_to_br | split: '<br />' -%}
                      {%- for _line in _spec_lines -%}
                        {%- assign _trimmed = _line | strip -%}
                        {%- if _trimmed != blank -%}
                          {%- assign _parts = _trimmed | split: ':' -%}
                          {%- if _parts.size > 1 -%}
                            <li><span class="pdp-hero--spec-label">{{ _parts[0] | strip }}</span><span class="pdp-hero--spec-value">{{ _parts | slice: 1, 99 | join: ':' | strip }}</span></li>
                          {%- else -%}
                            <li><span class="pdp-hero--spec-value">{{ _trimmed }}</span></li>
                          {%- endif -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  {%- else -%}
                    {{ accordion_content }}
                  {%- endif -%}
                  {%- comment -%} De Leville: Reference (SKU) at the bottom of the Specifications accordion only {%- endcomment -%}
                  {%- if use_metafield and current_variant.sku != blank -%}
                    <div class="pdp-hero--spec-ref">Reference &middot; {{ current_variant.sku }}</div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
          {% when 'complementary' %}
            {%- if block.settings.products != blank -%}
              {%- assign comp_bg = block.settings.background_color | default: '#FAFAFA' -%}
              {%- assign comp_padding = block.settings.padding | default: 20 -%}
              {%- assign comp_radius = block.settings.border_radius | default: 8 -%}
              {%- assign comp_title_color = block.settings.title_color | default: '#000000' -%}
              {%- assign comp_title_weight = block.settings.title_font_weight | default: 400 -%}
              {%- assign comp_title_size = block.settings.title_font_size | default: 16 -%}
              {%- assign comp_prod_title_color = block.settings.product_title_color | default: '#000000' -%}
              {%- assign comp_prod_title_weight = block.settings.product_title_font_weight | default: 700 -%}
              {%- assign comp_prod_price_color = block.settings.product_price_color | default: '#666666' -%}
              {%- assign comp_btn_bg = block.settings.add_btn_bg | default: '#ffffff' -%}
              {%- assign comp_btn_color = block.settings.add_btn_color | default: '#000000' -%}
              {%- assign comp_btn_hover_bg = block.settings.add_btn_hover_bg | default: '#000000' -%}
              {%- assign comp_btn_hover_color = block.settings.add_btn_hover_color | default: '#ffffff' -%}

              <div class="pdp-hero--complementary" style="background-color: {{ comp_bg }}; padding: {{ comp_padding }}px; border-radius: {{ comp_radius }}px; --comp-btn-bg: {{ comp_btn_bg }}; --comp-btn-color: {{ comp_btn_color }}; --comp-btn-hover-bg: {{ comp_btn_hover_bg }}; --comp-btn-hover-color: {{ comp_btn_hover_color }};">
                <h3 class="pdp-hero--complementary-title" style="color: {{ comp_title_color }}; font-weight: {{ comp_title_weight }}; font-size: {{ comp_title_size }}px;">{{ block.settings.title | escape }}</h3>
                <div class="pdp-hero--complementary-grid">
                  {%- for product in block.settings.products -%}
                    {%- if product.available -%}
                    <div class="pdp-hero--complementary-item">
                      <a href="{{ product.url }}" class="pdp-hero--complementary-image">
                        <img src="{{ product.featured_image | image_url: width: 140 }}" loading="lazy" alt="{{ product.title | escape }}">
                      </a>
                      <div class="pdp-hero--complementary-info">
                        <a href="{{ product.url }}" class="pdp-hero--complementary-link">
                          <p class="pdp-hero--complementary-name" style="color: {{ comp_prod_title_color }}; font-weight: {{ comp_prod_title_weight }};">{{ product.title | capitalize }}</p>
                          <p class="pdp-hero--complementary-price" style="color: {{ comp_prod_price_color }};">{{ product.price | money_without_trailing_zeros }}</p>
                        </a>
                        <div class="pdp-hero--complementary-actions">
                        {%- unless product.has_only_default_variant -%}
                          <select class="pdp-hero--complementary-select" aria-label="Select variant">
                            {%- for variant in product.variants -%}
                              <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} {% if variant == product.selected_or_first_available_variant %}selected{% endif %}>{{ variant.title }}</option>
                            {%- endfor -%}
                          </select>
                        {%- endunless -%}
                          <button class="pdp-hero--complementary-add" type="button" aria-label="Add {{ product.title }}" data-quick-add="{{ product.selected_or_first_available_variant.id }}">
                            {%- if global_icon_plus != blank -%}
                              <img src="{{ global_icon_plus | image_url: width: 28 }}" alt="Add" width="14" height="14" style="display: block; object-fit: contain;">
                            {%- else -%}
                              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            {%- endif -%}
                          </button>
                        </div>
                      </div>
                    </div>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {% endcase %}
        {%- endfor -%}
      </div>

    </div>
  </div>



</div>

<script>
(function() {
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section) return;
  
  // De Leville: Read More — event-delegated so it survives section re-renders
  // and works regardless of how many description blocks exist.
  section.addEventListener('click', function(e) {
    var btn = e.target.closest('[data-read-more-btn]');
    if (!btn) return;
    var wrap = btn.closest('[data-description-wrap]');
    if (!wrap) return;
    var readMoreText = btn.getAttribute('data-read-more-text') || 'Read More';
    var readLessText = btn.getAttribute('data-read-less-text') || 'Read Less';
    if (wrap.classList.contains('is-collapsed')) {
      wrap.classList.remove('is-collapsed');
      btn.textContent = readLessText;
      btn.setAttribute('aria-expanded', 'true');
    } else {
      wrap.classList.add('is-collapsed');
      btn.textContent = readMoreText;
      btn.setAttribute('aria-expanded', 'false');
    }
  });
})();
</script>

<script>
(function() {
  var section = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!section || section.dataset.scrollBridgeBound === 'true') return;
  section.dataset.scrollBridgeBound = 'true';

  var desktopQuery = window.matchMedia('(min-width: 1025px)');
  var imageContainer = section.querySelector('.pdp-hero--image-container');
  var infoCard = section.querySelector('.pdp-hero--info-card');
  if (!imageContainer || !infoCard) return;

  function canScroll(el) {
    return el && (el.scrollHeight - el.clientHeight) > 1;
  }

  function consumeDelta(el, delta) {
    if (!canScroll(el)) return delta;
    var maxScroll = el.scrollHeight - el.clientHeight;
    var start = el.scrollTop;
    var next = Math.min(maxScroll, Math.max(0, start + delta));
    if (next !== start) el.scrollTop = next;
    return delta - (next - start);
  }

  function atBottom(el) {
    return !canScroll(el) || (el.scrollTop + el.clientHeight >= el.scrollHeight - 1);
  }

  function atTop(el) {
    return !canScroll(el) || el.scrollTop <= 1;
  }

  function onWheel(e) {
    if (!desktopQuery.matches) return;
    if (e.defaultPrevented || e.ctrlKey || Math.abs(e.deltaY) < Math.abs(e.deltaX)) return;
    if (!section.contains(e.target)) return;

    var scrollingDown = e.deltaY > 0;
    var bothAtLimit = scrollingDown
      ? (atBottom(infoCard) && atBottom(imageContainer))
      : (atTop(infoCard) && atTop(imageContainer));

    if (bothAtLimit) return;

    var targetInInfo = !!e.target.closest('.pdp-hero--info-card');
    var primary = targetInInfo ? infoCard : imageContainer;
    var secondary = targetInInfo ? imageContainer : infoCard;
    var remaining = e.deltaY;

    e.preventDefault();

    remaining = consumeDelta(primary, remaining);
    if (Math.abs(remaining) > 0.1) {
      remaining = consumeDelta(secondary, remaining);
    }

    if (Math.abs(remaining) > 0.1) {
      window.scrollBy(0, remaining);
    }
  }

  section.addEventListener('wheel', onWheel, { passive: false });
})();
</script>

{%- comment -%} Sticky Mini Product Bar (appears on scroll past hero) {%- endcomment -%}
<div class="pdp-sticky-bar" data-pdp-sticky-bar aria-hidden="true">
  <div class="pdp-sticky-bar--inner">
    <a href="{{ product.url }}" class="pdp-sticky-bar--left">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48" class="pdp-sticky-bar--thumb" loading="lazy">
      {%- endif -%}
      <div class="pdp-sticky-bar--info">
        <div class="pdp-sticky-bar--title">{{ product.title }}</div>
        <div class="pdp-sticky-bar--price" data-pdp-sticky-price>{{ product.selected_or_first_available_variant.price | money }}</div>
      </div>
    </a>
    <button type="button" class="pdp-sticky-bar--cta" data-pdp-sticky-add-to-cart>Add to Bag</button>
  </div>
</div>

<style>
  .pdp-sticky-bar {
    position: fixed;
    /* Sit directly under the header (Cartier / Bulgari pattern).
       --custom-header-total-height is written by the header JS at runtime;
       falls back to 108px if unavailable. */
    top: var(--custom-header-total-height, 108px);
    left: 0;
    right: 0;
    z-index: 999;          /* below header (1000) so header's shadow wins */
    background: #ffffff;
    border-bottom: 1px solid #e5e5e5;
    transform: translateY(-100%);
    transition: transform 0.3s ease;
    pointer-events: none;
    visibility: hidden;
  }
  .pdp-sticky-bar.is-visible {
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }
  .pdp-sticky-bar--inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 40px;
    max-width: 100%;
    box-sizing: border-box;
  }
  .pdp-sticky-bar--left {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    color: #000;
    min-width: 0;
    flex: 1 1 auto;
  }
  .pdp-sticky-bar--thumb {
    width: 48px;
    height: 48px;
    object-fit: cover;
    border-radius: 0;
    background: #f6f6f6;
    flex: 0 0 48px;
  }
  .pdp-sticky-bar--info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .pdp-sticky-bar--title {
    font-family: 'Futura PT', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #000;
    letter-spacing: 0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pdp-sticky-bar--price {
    font-family: 'Futura PT', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: #6c6c6c;
  }
  .pdp-sticky-bar--cta {
    font-family: 'Futura PT', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #ffffff;
    background: #000;
    border: none;
    padding: 12px 28px;
    border-radius: 999px;
    cursor: pointer;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: opacity 0.2s ease;
    flex: 0 0 auto;
  }
  .pdp-sticky-bar--cta:hover { opacity: 0.85; }
  .pdp-sticky-bar--cta:disabled { opacity: 0.5; cursor: not-allowed; }

  @media (max-width: 767px) {
    .pdp-sticky-bar--inner { padding: 10px 16px; gap: 10px; }
    .pdp-sticky-bar--thumb { display: none; }
    .pdp-sticky-bar--title { font-size: 13px; }
    .pdp-sticky-bar--price { font-size: 12px; }
    .pdp-sticky-bar--cta { padding: 10px 18px; font-size: 12px; }
  }

  /* Keep main header visible when sticky bar is active — Cartier/Bulgari pattern.
     The sticky bar sits directly under the header instead of replacing it. */

  /* ════════════════════════════════════════════════════════
     PDP Lightbox — LV-style full-screen image zoom
     ════════════════════════════════════════════════════════ */
  .pdp-hero--main-image { cursor: zoom-in; }

  /* "Click to zoom" hint — appears on hover over image container, desktop only */
  .pdp-lbx-hint {
    position: absolute;
    bottom: 20px;
    left: 20px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px 7px 10px;
    background: rgba(255,255,255,0.90);
    backdrop-filter: blur(6px);
    border-radius: 999px;
    font-family: 'Futura PT', var(--font-main, sans-serif);
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #1a1a1a;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 4;
    user-select: none;
  }
  .pdp-hero--image-container:hover .pdp-lbx-hint { opacity: 1; }
  @media (pointer: coarse), (max-width: 768px) { .pdp-lbx-hint { display: none; } }

  /* Lightbox overlay */
  .pdp-lbx {
    position: fixed;
    inset: 0;
    z-index: 10000;
    background: #f5f5f3;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }
  .pdp-lbx.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  /* Image stage */
  .pdp-lbx__stage {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 70px 100px;
    box-sizing: border-box;
  }
  .pdp-lbx__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .pdp-lbx__img.is-loaded { opacity: 1; }

  /* Image counter */
  .pdp-lbx__counter {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Futura PT', var(--font-main, sans-serif);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: rgba(0,0,0,0.38);
    text-transform: uppercase;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Close button — black circle top-right */
  .pdp-lbx__close {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #1a1a1a;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: background 0.18s ease;
    flex-shrink: 0;
  }
  .pdp-lbx__close:hover { background: #000; }

  /* Nav arrows — white circles on sides */
  .pdp-lbx__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #fff;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 2px 12px rgba(0,0,0,0.10);
    transition: box-shadow 0.2s ease;
    flex-shrink: 0;
  }
  .pdp-lbx__nav:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.16); }
  .pdp-lbx__nav:disabled { opacity: 0.28; cursor: default; pointer-events: none; }
  .pdp-lbx__nav--prev { left: 24px; }
  .pdp-lbx__nav--next { right: 24px; }

  /* Zoom icon — bottom-left, interactive */
  .pdp-lbx__zoom-btn {
    position: absolute;
    bottom: 20px;
    left: 20px;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(0,0,0,0.055);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: background 0.18s ease;
    flex-shrink: 0;
  }
  .pdp-lbx__zoom-btn:hover { background: rgba(0,0,0,0.10); }

  /* Zoom/pan cursor states */
  .pdp-lbx__stage { overflow: hidden; cursor: zoom-in; }
  .pdp-lbx.is-zoomed .pdp-lbx__stage { cursor: grab; }
  .pdp-lbx.is-dragging .pdp-lbx__stage { cursor: grabbing !important; }
  .pdp-lbx__img { will-change: transform; user-select: none; -webkit-user-drag: none; }
  .pdp-lbx.is-zoomed .pdp-lbx__nav { display: none; }

  @media (max-width: 768px) {
    .pdp-lbx__stage { padding: 56px 56px; }
    .pdp-lbx__nav { width: 38px; height: 38px; }
    .pdp-lbx__nav--prev { left: 14px; }
    .pdp-lbx__nav--next { right: 14px; }
    .pdp-lbx__counter { top: 16px; font-size: 10px; }
    .pdp-lbx__close { top: 14px; right: 14px; width: 38px; height: 38px; }
    .pdp-lbx__zoom-btn { bottom: 14px; left: 14px; width: 38px; height: 38px; }
  }
</style>

<script>
(function() {
  // Sticky bar HTML lives as a sibling of .pdp-hero--root, so query the
  // document globally — not the section subtree.
  var bar = document.querySelector('[data-pdp-sticky-bar]');
  if (!bar) return;
  var section = document.querySelector('.pdp-hero--root[data-section-id="{{ section.id }}"]')
             || document.querySelector('.pdp-hero--root');
  if (!section) return;
  var barCta = bar.querySelector('[data-pdp-sticky-add-to-cart]');
  var primaryAtc = section.querySelector('[data-add-to-cart]');
  if (!primaryAtc) return;

  // Forward sticky-bar click to main Add to Bag button so all existing logic runs.
  if (barCta) {
    barCta.addEventListener('click', function() { primaryAtc.click(); });
  }

  // Mirror disabled state + label from the primary button.
  function syncState() {
    barCta.disabled = primaryAtc.disabled;
    barCta.textContent = primaryAtc.disabled ? (primaryAtc.textContent || 'Unavailable') : 'Add to Bag';
  }
  var obs = new MutationObserver(syncState);
  obs.observe(primaryAtc, { attributes: true, childList: true, subtree: true });
  syncState();

  function show() {
    bar.classList.add('is-visible');
    bar.setAttribute('aria-hidden', 'false');
    document.body.classList.add('pdp-sticky-active');
  }
  function hide() {
    bar.classList.remove('is-visible');
    bar.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('pdp-sticky-active');
  }

  // Compute the document-relative Y position of the Add to Bag button on load.
  // If user has scrolled past it (by > 80px, so the button is reasonably out of sight),
  // show the sticky bar. This works identically in both mobile single-column and desktop
  // sticky-rail layouts, because we compare to the button's ORIGINAL document offset,
  // not its live viewport position (which may stay pinned in a sticky container).
  var initialAtcTop = 0;
  function measure() {
    var rect = primaryAtc.getBoundingClientRect();
    initialAtcTop = rect.top + window.scrollY;
  }
  measure();
  // Re-measure when layout changes (image loaded, fonts swapped, resize).
  window.addEventListener('load', measure);
  window.addEventListener('resize', measure);

  function onScroll() {
    // Show when the Add to Bag button is near the top edge of the viewport
    // (i.e. the user has scrolled close to or past it).
    // Math.min ensures we also show after 50% viewport scroll on desktop
    // where the info card is sticky and initialAtcTop grows with scrollY.
    var triggerY = Math.max(
      Math.min(initialAtcTop - window.innerHeight * 0.7, window.innerHeight * 0.5),
      60
    );
    if (window.scrollY > triggerY) {
      show();
    } else {
      hide();
    }
  }
  var ticking = false;
  window.addEventListener('scroll', function() {
    if (!ticking) {
      requestAnimationFrame(function() { onScroll(); ticking = false; });
      ticking = true;
    }
  }, { passive: true });
  onScroll();
})();
</script>

{%- comment -%} Lightbox JS {%- endcomment -%}
<script>
document.addEventListener('DOMContentLoaded', function() {
  var lbx = document.getElementById('pdp-lbx-{{ section.id }}');
  if (!lbx) return;
  var sectionEl = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!sectionEl) return;

  var lbxStage   = lbx.querySelector('.pdp-lbx__stage');
  var lbxImg     = lbx.querySelector('.pdp-lbx__img');
  var lbxClose   = lbx.querySelector('.pdp-lbx__close');
  var lbxPrev    = lbx.querySelector('.pdp-lbx__nav--prev');
  var lbxNext    = lbx.querySelector('.pdp-lbx__nav--next');
  var lbxCount   = lbx.querySelector('.pdp-lbx__counter');
  var lbxZoomBtn = lbx.querySelector('.pdp-lbx__zoom-btn');
  var lbxZoomVert = lbxZoomBtn ? lbxZoomBtn.querySelector('.pdp-lbx__zoom-vert') : null;

  var images = Array.from(sectionEl.querySelectorAll('.pdp-hero--main-image'));
  var srcs   = images.map(function(img) {
    return { zoom: img.dataset.zoomSrc || img.src, alt: img.alt || '' };
  });
  var total = srcs.length, current = 0;

  if (total <= 1) {
    if (lbxPrev) lbxPrev.style.display = 'none';
    if (lbxNext) lbxNext.style.display = 'none';
  }

  // ── Zoom / pan state ──────────────────────────────────────────────
  var zScale = 1, pX = 0, pY = 0;
  var TARGET_ZOOM = 2.5, MAX_ZOOM = 4;

  function applyT(animated) {
    lbxImg.style.transition = animated ? 'transform 0.28s cubic-bezier(0.25,0.1,0.25,1)' : 'none';
    lbxImg.style.transform = 'scale(' + zScale + ') translate(' + pX + 'px, ' + pY + 'px)';
    var zoomed = zScale > 1.05;
    lbx.classList.toggle('is-zoomed', zoomed);
    if (lbxZoomBtn) lbxZoomBtn.setAttribute('aria-label', zoomed ? 'Zoom out' : 'Zoom in');
    if (lbxZoomVert) lbxZoomVert.style.display = zoomed ? 'none' : '';
  }

  // CSS transforms don't affect offsetWidth/offsetHeight (layout dimensions),
  // so we can use them directly even while image is scaled.
  function clampPan() {
    var iw = lbxImg.offsetWidth;
    var ih = lbxImg.offsetHeight;
    var sw = lbxStage.clientWidth;
    var sh = lbxStage.clientHeight;
    var mX = Math.max(0, iw / 2 - sw / (2 * zScale));
    var mY = Math.max(0, ih / 2 - sh / (2 * zScale));
    pX = Math.max(-mX, Math.min(mX, pX));
    pY = Math.max(-mY, Math.min(mY, pY));
  }

  // Zoom at a specific screen point, keeping that point stationary.
  // Uses getBoundingClientRect() which reflects visual (post-transform) position.
  function zoomAt(screenX, screenY, newScale) {
    var rect = lbxImg.getBoundingClientRect();
    var visualCX = rect.left + rect.width / 2;
    var visualCY = rect.top  + rect.height / 2;
    // Recover layout center from visual center
    var layoutCX = visualCX - zScale * pX;
    var layoutCY = visualCY - zScale * pY;
    var dx = screenX - layoutCX;
    var dy = screenY - layoutCY;
    // Keep the tapped/clicked point at same screen position after scale change
    pX = dx * (1 / newScale - 1 / zScale) + pX;
    pY = dy * (1 / newScale - 1 / zScale) + pY;
    zScale = newScale;
    clampPan();
    applyT(true);
  }

  function zoomToggle(cx, cy) {
    if (zScale > 1.05) {
      zScale = 1; pX = 0; pY = 0; applyT(true);
    } else {
      var stageRect = lbxStage.getBoundingClientRect();
      var focusX = (cx !== undefined) ? cx : stageRect.left + stageRect.width / 2;
      var focusY = (cy !== undefined) ? cy : stageRect.top  + stageRect.height / 2;
      zoomAt(focusX, focusY, TARGET_ZOOM);
    }
  }

  function resetZoom() { zScale = 1; pX = 0; pY = 0; applyT(false); }

  // ── Image loading ─────────────────────────────────────────────────
  function updateNav() {
    if (lbxPrev) lbxPrev.disabled = current === 0;
    if (lbxNext) lbxNext.disabled = current === total - 1;
    if (lbxCount) lbxCount.textContent = total > 1 ? (current + 1) + ' / ' + total : '';
  }

  function loadImage(index) {
    current = index;
    resetZoom();
    lbxImg.classList.remove('is-loaded');
    var entry = srcs[index];
    lbxImg.alt = entry.alt;
    var tmp = new Image();
    tmp.onload = function() { lbxImg.src = entry.zoom; lbxImg.classList.add('is-loaded'); };
    tmp.src = entry.zoom;
    updateNav();
  }

  function open(index) {
    loadImage(index);
    lbx.classList.add('is-open');
    lbx.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function close() {
    lbx.classList.remove('is-open');
    lbx.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    resetZoom();
  }

  function prev() { if (current > 0) loadImage(current - 1); }
  function next() { if (current < total - 1) loadImage(current + 1); }

  // ── Gallery: click to open + hover preload ────────────────────────
  var preloaded = {};
  function preloadZoom(i) {
    if (preloaded[i]) return; preloaded[i] = true;
    var e = srcs[i]; if (e && e.zoom) { var p = new Image(); p.src = e.zoom; }
  }
  images.forEach(function(img, i) {
    img.addEventListener('mouseenter', function() { preloadZoom(i); });
    img.addEventListener('touchstart', function() { preloadZoom(i); }, { passive: true });
    img.addEventListener('click', function() { open(i); });
  });

  // ── Desktop: click to zoom at point, drag to pan ──────────────────
  var isDragging = false, dragMoved = false, dragPX = 0, dragPY = 0;

  lbxStage.addEventListener('mousedown', function(e) {
    if (e.button !== 0) return;
    isDragging = true; dragMoved = false;
    dragPX = e.clientX; dragPY = e.clientY;
    lbx.classList.add('is-dragging');
    e.preventDefault();
  });

  window.addEventListener('mousemove', function(e) {
    if (!isDragging) return;
    var dx = e.clientX - dragPX, dy = e.clientY - dragPY;
    if (Math.abs(dx) > 4 || Math.abs(dy) > 4) dragMoved = true;
    if (dragMoved && zScale > 1.05) {
      pX += dx / zScale; pY += dy / zScale;
      clampPan(); applyT(false);
    }
    dragPX = e.clientX; dragPY = e.clientY;
  });

  window.addEventListener('mouseup', function(e) {
    if (!isDragging) return;
    var wasDrag = dragMoved;
    isDragging = false; dragMoved = false;
    lbx.classList.remove('is-dragging');
    // A click (no drag) → toggle zoom at cursor position
    if (!wasDrag) zoomToggle(e.clientX, e.clientY);
  });

  // ── Zoom button ───────────────────────────────────────────────────
  if (lbxZoomBtn) {
    lbxZoomBtn.addEventListener('click', function(e) {
      e.stopPropagation(); zoomToggle();
    });
  }

  // ── Close / nav buttons ───────────────────────────────────────────
  lbxClose.addEventListener('click', function(e) { e.stopPropagation(); close(); });
  if (lbxPrev) lbxPrev.addEventListener('click', function(e) { e.stopPropagation(); prev(); });
  if (lbxNext) lbxNext.addEventListener('click', function(e) { e.stopPropagation(); next(); });

  // ── Keyboard ──────────────────────────────────────────────────────
  document.addEventListener('keydown', function(e) {
    if (!lbx.classList.contains('is-open')) return;
    if (e.key === 'Escape') { close(); return; }
    if (zScale <= 1.05) {
      if (e.key === 'ArrowLeft')  prev();
      if (e.key === 'ArrowRight') next();
    }
  });

  // ── Mobile: pinch-to-zoom + drag to pan + swipe to navigate ──────
  var touchStartX = 0, touchStartY = 0;
  var tPrevX = 0, tPrevY = 0;
  var touchMoved = false, isPinching = false;
  var pinchStartDist = 0, pinchStartScale = 1;

  lbx.addEventListener('touchstart', function(e) {
    if (e.touches.length === 2) {
      isPinching = true;
      pinchStartDist = Math.hypot(
        e.touches[1].clientX - e.touches[0].clientX,
        e.touches[1].clientY - e.touches[0].clientY
      );
      pinchStartScale = zScale;
      e.preventDefault();
    } else if (e.touches.length === 1) {
      touchStartX = tPrevX = e.touches[0].clientX;
      touchStartY = tPrevY = e.touches[0].clientY;
      touchMoved = false;
    }
  }, { passive: false });

  lbx.addEventListener('touchmove', function(e) {
    if (e.touches.length === 2 && isPinching) {
      var dist = Math.hypot(
        e.touches[1].clientX - e.touches[0].clientX,
        e.touches[1].clientY - e.touches[0].clientY
      );
      zScale = Math.min(MAX_ZOOM, Math.max(1, pinchStartScale * dist / pinchStartDist));
      clampPan(); applyT(false);
      e.preventDefault();
    } else if (e.touches.length === 1 && !isPinching) {
      var dx = e.touches[0].clientX - tPrevX;
      var dy = e.touches[0].clientY - tPrevY;
      var totalDX = Math.abs(e.touches[0].clientX - touchStartX);
      var totalDY = Math.abs(e.touches[0].clientY - touchStartY);
      if (totalDX > 8 || totalDY > 8) touchMoved = true;
      if (zScale > 1.05 && touchMoved) {
        pX += dx / zScale; pY += dy / zScale;
        clampPan(); applyT(false);
        e.preventDefault();
      }
      tPrevX = e.touches[0].clientX;
      tPrevY = e.touches[0].clientY;
    }
  }, { passive: false });

  lbx.addEventListener('touchend', function(e) {
    if (isPinching) {
      isPinching = false;
      if (zScale < 1.1) resetZoom();
      return;
    }
    var endX = e.changedTouches[0].clientX;
    var endY = e.changedTouches[0].clientY;
    var dx = endX - touchStartX;
    var dy = endY - touchStartY;
    var isHorizSwipe = Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5;

    if (!touchMoved) {
      // Tap → toggle zoom at tap point
      zoomToggle(touchStartX, touchStartY);
    } else if (isHorizSwipe && zScale <= 1.05) {
      // Swipe → navigate
      if (dx < 0) next(); else prev();
    }
  }, { passive: true });

  // ── Variant switcher sync ─────────────────────────────────────────
  document.addEventListener('snc:pdp-image-changed', function(e) {
    if (!lbx.classList.contains('is-open')) return;
    var mediaId = e.detail && e.detail.mediaId;
    if (!mediaId) return;
    var idx = -1;
    for (var i = 0; i < images.length; i++) {
      if (images[i].dataset.mediaId == mediaId) { idx = i; break; }
    }
    if (idx >= 0) loadImage(idx);
  });
});
</script>

