{%- liquid
  assign announcement_enabled = section.settings.announcement-enabled
  assign announcement_blocks = section.blocks | where: 'type', 'announcement'
  assign logo_to_use = settings.logo_dark
  if section.settings.logo_version == 'light'
    assign logo_to_use = settings.logo_light
  endif
  assign logo_sticky = settings.logo_dark
  if section.settings.logo_version_sticky == 'light'
    assign logo_sticky = settings.logo_light
  endif
  assign locale_label = section.settings['locale-label'] | default: 'ES'
  assign currency_label = section.settings['currency-label'] | default: 'MEX$'
  assign sticky_enabled = section.settings.sticky-enabled
  assign force_sticky_style = false
  # De Leville: force_light_theme controls dark-icon + white-bg header.
  # Applied on all collection pages (all use snc-plp — white bg, no dark hero)
  # and the list-collections page.
  assign force_light_theme = false
  if request.page_type == 'list-collections'
    assign force_light_theme = true
  elsif request.page_type == 'collection'
    assign force_light_theme = true
  endif
  assign smooth_scroll_enabled = section.settings.smooth_scroll_enabled
  assign smooth_scroll_duration = section.settings.smooth_scroll_duration | default: 1.5
  
  assign burger_block = section.blocks | where: 'type', 'burger_menu' | first
  assign burger_menu = blank
  if burger_block and burger_block.settings.menu != blank
    assign burger_menu = linklists[burger_block.settings.menu]
  endif

  assign has_mega_menu = false
  if burger_menu != blank and burger_menu.links.size > 0
    assign has_mega_menu = true
  endif
  
  assign burger_menu_gap = burger_block.settings.menu_gap | default: 10
  assign mobile_drawer_block = section.blocks | where: 'type', 'mobile_drawer' | first
  assign mobile_drawer_menu = blank
  if mobile_drawer_block and mobile_drawer_block.settings.mobile_menu != blank
    assign mobile_drawer_menu = linklists[mobile_drawer_block.settings.mobile_menu]
  endif
  assign mobile_drawer_menu_gap = 10
  if mobile_drawer_block
    assign mobile_drawer_menu_gap = mobile_drawer_block.settings.menu_gap | default: 10
  endif

  assign locale_enabled = false
  if section.settings.show-locale-selector and localization.available_languages.size > 1
    assign locale_enabled = true
  endif

  assign region_enabled = false
  if section.settings.show-region-selector and localization.available_countries.size > 1
    assign region_enabled = true
  endif

  assign cart_title_t = 'cart.title' | t
  assign search_t = 'general.search.search' | t
  assign account_t = 'layout.header.account_view_link' | t
 
  assign icon_version_setting = section.settings.icon_version | default: 'dark'
  assign icon_version_sticky_setting = section.settings.icon_version_sticky | default: 'dark'

  if icon_version_setting == 'light'
    assign icon_burger = settings.global_icon_burger_light
    assign icon_search = settings.global_icon_search_light
    assign icon_account = settings.global_icon_account_light
    assign icon_wishlist = settings.global_icon_wishlist_light
    assign icon_cart = settings.global_icon_cart_light
  else
    assign icon_burger = settings.global_icon_burger_dark
    assign icon_search = settings.global_icon_search_dark
    assign icon_account = settings.global_icon_account_dark
    assign icon_wishlist = settings.global_icon_wishlist_dark
    assign icon_cart = settings.global_icon_cart_dark
  endif

  if icon_version_sticky_setting == 'light'
    assign icon_burger_sticky = settings.global_icon_burger_light
    assign icon_search_sticky = settings.global_icon_search_light
    assign icon_account_sticky = settings.global_icon_account_light
    assign icon_wishlist_sticky = settings.global_icon_wishlist_light
    assign icon_cart_sticky = settings.global_icon_cart_light
  else
    assign icon_burger_sticky = settings.global_icon_burger_dark
    assign icon_search_sticky = settings.global_icon_search_dark
    assign icon_account_sticky = settings.global_icon_account_dark
    assign icon_wishlist_sticky = settings.global_icon_wishlist_dark
    assign icon_cart_sticky = settings.global_icon_cart_dark
  endif

  assign show_burger_desktop = section.settings.show_burger_desktop

  assign wishlist_url = section.settings.wishlist_url | default: '/pages/wishlist'

  if icon_wishlist != blank
    if icon_wishlist.format == 'svg' or icon_wishlist.src contains '.svg'
      assign cart_wishlist_icon_url = icon_wishlist | image_url
    else
      assign cart_wishlist_icon_url = icon_wishlist | image_url: width: 40
    endif
  else
    assign cart_wishlist_icon_url = 'favorite.svg' | asset_url
  endif

  assign search_block = section.blocks | where: 'type', 'search_overlay' | first

  assign wishlist_bg_enabled = settings.global_wishlist_bg_enabled
  assign wishlist_bg_color = settings.global_wishlist_bg_color | default: '#FFFFFF'
  assign wishlist_radius = settings.global_wishlist_radius | default: 0
  assign wishlist_padding = settings.global_wishlist_padding | default: 8
  assign wishlist_size = settings.global_wishlist_size | default: 40
-%}

{%- comment -%}
  Header Principal con Barra de Anuncio
{%- endcomment -%}
<div class="custom-header--announcement-section">
  {%- if announcement_enabled -%}
    <div 
      class="custom-header--announcement" 
      data-announcement-bar
      {% if announcement_marquee %}data-marquee="true"{% endif %}
    >
      <div class="custom-header--announcement-content">
        {%- if announcement_blocks.size > 0 -%}
          <div class="custom-header--announcement-slider-wrapper">
            {%- if announcement_blocks.size > 1 -%}
              <button class="custom-header--announcement-arrow prev" aria-label="Previous">
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 9L1 5L5 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            {%- endif -%}
            
            <div class="custom-header--announcement-slider" data-autoplay-speed="5000">
              {%- for block in announcement_blocks -%}
                <div class="custom-header--announcement-slide {% if forloop.first %}active{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
                  {%- else -%}
                    <p>{{ block.settings.text | escape }}</p>
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </div>

            {%- if announcement_blocks.size > 1 -%}
              <button class="custom-header--announcement-arrow next" aria-label="Next">
                <svg width="6" height="10" viewBox="0 0 6 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 9L5 5L1 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="custom-header--announcement-play-pause" aria-label="Pause" data-state="playing">
                <svg class="icon-pause" width="8" height="10" viewBox="0 0 8 10" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M7 1V9" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <svg class="icon-play" width="8" height="10" viewBox="0 0 8 10" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none;"><path d="M1 1L7 5L1 9V1Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <header
    class="custom-header--root{% if force_sticky_style %} force-sticky-style{% endif %}{% if force_light_theme %} force-light-theme{% endif %}"
    data-sticky="{{ sticky_enabled }}"
    data-section-id="{{ section.id }}"
  >
  <div class="custom-header--wrapper">
    
    {%- comment -%} Lado Izquierdo - Desktop {%- endcomment -%}
    <div class="custom-header--left">
      {%- comment -%} Menú Hamburguesa {%- endcomment -%}
      <button 
        class="custom-header--menu-toggle"
        {% unless show_burger_desktop %}style="display: none;"{% endunless %}
        aria-label="{{ 'layout.header.toggle_drawer' | t }}"
        aria-haspopup="menu"
        type="button"
        {% if mobile_drawer_block == blank %}data-burger-inactive="true"{% endif %}
      >
        {%- if icon_burger != blank -%}
          {%- if icon_burger.format == 'svg' or icon_burger.src contains '.svg' -%}
            {%- assign icon_burger_url = icon_burger | image_url -%}
          {%- else -%}
            {%- assign icon_burger_url = icon_burger | image_url: width: 44 -%}
          {%- endif -%}
          <img 
            src="{{ icon_burger_url }}" 
            alt="Menu" 
            class="custom-header--burger-icon no-filter icon-static"
            width="22"
            height="15"
            loading="eager"
          >
        {%- else -%}
          <img
            src="{{ 'Vector_Hamb_De_Leville.svg' | asset_url }}"
            alt="Menu"
            class="custom-header--burger-icon no-filter icon-static"
            width="22"
            height="15"
            loading="eager"
          >
        {%- endif -%}
        {%- if icon_burger_sticky != blank -%}
          {%- if icon_burger_sticky.format == 'svg' or icon_burger_sticky.src contains '.svg' -%}
            {%- assign icon_burger_sticky_url = icon_burger_sticky | image_url -%}
          {%- else -%}
            {%- assign icon_burger_sticky_url = icon_burger_sticky | image_url: width: 44 -%}
          {%- endif -%}
          <img src="{{ icon_burger_sticky_url }}" alt="Menu" class="custom-header--burger-icon no-filter icon-sticky" width="22" height="15" loading="eager">
        {%- else -%}
          <img src="{{ 'Vectorinvertido.svg' | asset_url }}" alt="Menu" class="custom-header--burger-icon no-filter icon-sticky" width="22" height="15" loading="eager">
        {%- endif -%}
      </button>

      {%- comment -%} Navegación primaria - configurable desde el editor {%- endcomment -%}
      <div class="custom-header--nav-links custom-header--desktop-only" data-mega-nav>
        {%- assign header_items = section.blocks | where: 'type', 'header_item' -%}
        {%- if header_items.size > 0 -%}
          {%- for block in header_items -%}
            <div class="custom-header--nav-item" {{ block.shopify_attributes }}>
              <a 
                href="{{ block.settings.url }}" 
                class="custom-header--nav-link"
                {% if block.settings.enable_mega %}data-mega-trigger="{{ block.id }}"{% endif %}
              >
                <span>{{ block.settings.title | escape }}</span>
                {%- if block.settings.enable_mega -%}
                  <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--arrow-icon">
                    <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </a>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Centro - Logo {%- endcomment -%}
    <div class="custom-header--center">
      {%- if request.page_type == 'index' -%}
        <h1 class="custom-header--logo">
          <a href="{{ routes.root_url }}" style="text-decoration: none; color: inherit;">
            <img src="{{ 'Logo_Oficialinvertido.svg' | asset_url }}" alt="{{ shop.name }}" class="custom-header--logo-image logo-sticky" loading="eager" width="{{ settings.logo_width | default: 135 }}">
            <img src="{{ 'Logo_Oficial_De_Leville.svg' | asset_url }}" alt="{{ shop.name }}" class="custom-header--logo-image logo-static" loading="eager" width="{{ settings.logo_width | default: 135 }}">
          </a>
        </h1>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="custom-header--logo">
          <img src="{{ 'Logo_Oficialinvertido.svg' | asset_url }}" alt="{{ shop.name }}" class="custom-header--logo-image logo-sticky" loading="eager" width="{{ settings.logo_width | default: 135 }}">
          <img src="{{ 'Logo_Oficial_De_Leville.svg' | asset_url }}" alt="{{ shop.name }}" class="custom-header--logo-image logo-static" loading="eager" width="{{ settings.logo_width | default: 135 }}">
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Lado Derecho {%- endcomment -%}
    <div class="custom-header--right">
      {%- comment -%} Contenido Desktop {%- endcomment -%}
      <div class="custom-header--desktop-only custom-header--right-desktop">
        {%- if section.settings['show-locale-selector'] or section.settings['show-region-selector'] -%}
          <div class="custom-header--right-meta">
            {%- if section.settings['show-locale-selector'] -%}
              <span class="custom-header--right-label">{{ locale_label }}</span>
            {%- endif -%}
            {%- if section.settings['show-region-selector'] -%}
              <span class="custom-header--right-label custom-header--right-currency">{{ currency_label }}</span>
            {%- endif -%}
          </div>
          <span class="custom-header--right-divider" aria-hidden="true"></span>
        {%- endif -%}
        <div class="custom-header--icons">
          {%- if search_block -%}
          <button
            class="custom-header--icon-button custom-header--search-toggle"
            data-search-toggle
            aria-label="{{ search_t }}"
            type="button"
          >
            <img src="{{ 'Frameinvertido.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-search no-filter icon-sticky" width="20" height="20" loading="eager" aria-hidden="true">
            <img src="{{ 'Framedl.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-search no-filter icon-static" width="20" height="20" loading="eager" aria-hidden="true">
          </button>
          {%- else -%}
          <a
            class="custom-header--icon-button custom-header--search-toggle"
            href="{{ routes.search_url }}"
            aria-label="{{ search_t }}"
          >
            <img src="{{ 'Frameinvertido.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-search no-filter icon-sticky" width="20" height="20" loading="eager" aria-hidden="true">
            <img src="{{ 'Framedl.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-search no-filter icon-static" width="20" height="20" loading="eager" aria-hidden="true">
          </a>
          {%- endif -%}

          {%- if shop.customer_accounts_enabled -%}
            <a 
              class="custom-header--icon-button"
              href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
              aria-label="{{ account_t }}"
            >
              <img src="{{ 'Frameinvertido-2.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-account no-filter icon-sticky" width="20" height="23.53" loading="eager" aria-hidden="true">
              <img src="{{ 'Framedl-2.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-account no-filter icon-static" width="20" height="23.53" loading="eager" aria-hidden="true">
            </a>
          {%- endif -%}

          {%- if shop.customer_accounts_enabled -%}
            <a 
              class="custom-header--icon-button custom-header--wishlist"
              href="{{ wishlist_url }}"
              aria-label="Favorites"
            >
              <img src="{{ 'Frameinvertido-1.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-favorite no-filter icon-sticky" width="23" height="20" loading="eager" aria-hidden="true">
              <img src="{{ 'Framedl-1.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-favorite no-filter icon-static" width="23" height="20" loading="eager" aria-hidden="true">
            </a>
          {%- endif -%}

          <button
            class="custom-header--icon-button custom-header--cart"
            data-cart-toggle
            aria-haspopup="menu"
            type="button"
            aria-label="{{ cart_title_t }}"
            data-cart-count="{{ cart.item_count }}"
          >
            <img src="{{ 'Frameinvertido-3.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-cart no-filter icon-sticky" width="22" height="23" loading="eager" aria-hidden="true">
            <img src="{{ 'Framedl-3.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-cart no-filter icon-static" width="22" height="23" loading="eager" aria-hidden="true">
            <span class="custom-header--cart-count" role="status" aria-live="polite" aria-atomic="true" aria-label="{{ cart.item_count }} items in cart" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>{{ cart.item_count }}</span>
          </button>
        </div>
      </div>

      {%- comment -%} Solo Carrito - Mobile {%- endcomment -%}
      <div class="custom-header--mobile-only">
        <button
          class="custom-header--icon-button custom-header--cart"
          data-cart-toggle
          aria-haspopup="menu"
          type="button"
          aria-label="{{ cart_title_t }}"
          data-cart-count="{{ cart.item_count }}"
        >
          <img src="{{ 'Frameinvertido-3.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-cart no-filter icon-sticky" width="22" height="23" loading="eager" aria-hidden="true">
          <img src="{{ 'Framedl-3.svg' | asset_url }}" alt="" class="custom-header--icon custom-header--icon-cart no-filter icon-static" width="22" height="23" loading="eager" aria-hidden="true">
          <span class="custom-header--cart-count" role="status" aria-live="polite" aria-atomic="true" aria-label="{{ cart.item_count }} items in cart" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>
</div>

{%- comment -%} Mega menu panel (desktop) {%- endcomment -%}
{%- assign mega_blocks = section.blocks | where: 'type', 'header_item' -%}
{%- if mega_blocks.size > 0 -%}
  <div class="custom-header--mega-overlay" data-mega-overlay></div>
  <div class="custom-header--mega-guard" data-mega-guard></div>
  {%- for block in mega_blocks -%}
    {%- if block.settings.enable_mega -%}
      <div 
        class="custom-header--mega-panel" 
        data-mega-panel="{{ block.id }}"
        {% if block.settings.mega_full_width %}data-full-width="true"{% endif %}
        style="
          --mega-top-margin: {{ block.settings.mega_top_margin | default: 10 }}px;
          --mega-side-margin: {{ block.settings.mega_side_margin | default: 10 }}px;
        "
      >
        <div class="custom-header--mega-panel-inner" style="
          --mega-padding: {{ block.settings.mega_padding | default: 20 }}px;
          --mega-border-radius: {{ block.settings.mega_border_radius | default: 10 }}px;
          --mega-shadow: {% if block.settings.mega_show_shadow %}{{ block.settings.mega_shadow | default: '0 20px 60px rgba(0, 0, 0, 0.15)' }}{% else %}none{% endif %};
        ">
          <div class="custom-header--mega-panel-content" style="gap: {{ block.settings.mega_content_gap | default: 30 }}px;">
            <nav class="custom-header--mega-nav">
              {%- if block.settings.mega_menu != blank -%}
                <ul class="custom-header--mega-nav-list">
                  {%- for link in linklists[block.settings.mega_menu].links -%}
                    <li class="custom-header--mega-nav-item">
                      <a href="{{ link.url }}" class="custom-header--mega-nav-link">
                        <span>
                          {%- if block.settings.enable_advanced_colors -%}
                            {%- for i in (1..20) -%}
                              {%- assign name_key = 'color_name_' | append: i -%}
                              {%- assign hex_key = 'color_hex_' | append: i -%}
                              {%- assign setting_name = settings[name_key] | downcase | strip -%}
                              {%- assign link_title_lower = link.title | downcase | strip -%}
                              {%- if setting_name != blank and setting_name == link_title_lower -%}
                                <span class="snc-color-swatch" style="--swatch-color: {{ settings[hex_key] }};"></span>
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                          {%- endif -%}
                          {{ link.title }}
                        </span>
                        {%- if link.links.size > 0 -%}
                          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--mega-arrow">
                            <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        {%- endif -%}
                      </a>
                      {%- if link.links.size > 0 -%}
                        <ul class="custom-header--mega-subnav">
                          {%- for child in link.links -%}
                            <li>
                              <a href="{{ child.url }}">
                                {%- if block.settings.enable_advanced_colors -%}
                                  {%- for i in (1..20) -%}
                                    {%- assign name_key = 'color_name_' | append: i -%}
                                    {%- assign hex_key = 'color_hex_' | append: i -%}
                                    {%- assign setting_name = settings[name_key] | downcase | strip -%}
                                    {%- assign child_title_lower = child.title | downcase | strip -%}
                                    {%- if setting_name != blank and setting_name == child_title_lower -%}
                                      <span class="snc-color-swatch" style="--swatch-color: {{ settings[hex_key] }};"></span>
                                      {%- break -%}
                                    {%- endif -%}
                                  {%- endfor -%}
                                {%- endif -%}
                                {{ child.title }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </nav>
            {%- if block.settings.mega_full_width -%}
              <div class="custom-header--mega-panel-text">{{ block.settings.description | escape }}</div>
            {%- endif -%}
          </div>
          {%- if block.settings.mega_full_width -%}
            <div class="custom-header--mega-panel-media">
              <div 
                class="custom-header--mega-panel-image{% if block.settings.image == blank %} is-empty{% endif %}" 
                {% if block.settings.image != blank %}style="background-image:url({{ block.settings.image | image_url: width: 900 }});" {% endif %}
              ></div>
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} Burger Menu Overlay {%- endcomment -%}
  {%- assign default_panel_top_gap = 10 -%}
  {%- assign default_panel_bottom_gap = 20 -%}
  {%- assign default_panel_side_gap = 10 -%}
  {%- assign default_padding_horizontal = 20 -%}
  {%- assign default_padding_top = 0 -%}
  {%- assign default_padding_bottom = 40 -%}
  {%- assign default_border_radius = 10 -%}
  {%- assign mobile_panel_mode = 'below_header' -%}
  {%- assign panel_top_gap = default_panel_top_gap -%}
  {%- assign panel_bottom_gap = default_panel_bottom_gap -%}
  {%- assign panel_side_gap = default_panel_side_gap -%}
  {%- assign panel_padding_horizontal = default_padding_horizontal -%}
  {%- assign panel_padding_top = default_padding_top -%}
  {%- assign panel_padding_bottom = default_padding_bottom -%}
  {%- assign panel_border_radius = default_border_radius -%}
  {%- if mobile_drawer_block -%}
    {%- assign mobile_panel_mode = mobile_drawer_block.settings.panel_height_mode | default: 'below_header' -%}
    {%- assign panel_top_gap = mobile_drawer_block.settings.panel_top_gap | default: default_panel_top_gap -%}
    {%- assign panel_bottom_gap = mobile_drawer_block.settings.panel_bottom_gap | default: default_panel_bottom_gap -%}
    {%- assign panel_side_gap = mobile_drawer_block.settings.panel_side_gap | default: default_panel_side_gap -%}
    {%- assign panel_padding_horizontal = mobile_drawer_block.settings.panel_padding_horizontal | default: default_padding_horizontal -%}
    {%- assign panel_padding_top = mobile_drawer_block.settings.panel_padding_top | default: default_padding_top -%}
    {%- assign panel_padding_bottom = mobile_drawer_block.settings.panel_padding_bottom | default: default_padding_bottom -%}
    {%- assign panel_border_radius = mobile_drawer_block.settings.panel_border_radius | default: default_border_radius -%}
  {%- endif -%}
  {%- if mobile_panel_mode == 'full_viewport' -%}
    {%- assign top_offset_value = '0px' -%}
  {%- else -%}
    {%- assign top_offset_value = panel_top_gap | append: 'px' -%}
  {%- endif -%}
  {%- assign bottom_offset_value = panel_bottom_gap | append: 'px' -%}
  {%- assign side_offset_value = panel_side_gap | append: 'px' -%}
  {%- assign padding_horizontal_value = panel_padding_horizontal | append: 'px' -%}
  {%- assign padding_top_value = panel_padding_top | append: 'px' -%}
  {%- assign padding_bottom_value = panel_padding_bottom | append: 'px' -%}
  {%- assign border_radius_value = panel_border_radius | append: 'px' -%}
  
  {%- comment -%} Estilos dinámicos del menú móvil {%- endcomment -%}
  {%- assign menu_item_color = mobile_drawer_block.settings.menu_item_color | default: '#000000' -%}
  {%- assign menu_item_size = mobile_drawer_block.settings.menu_item_size | default: 18 -%}
  {%- assign menu_item_weight = mobile_drawer_block.settings.menu_item_weight | default: 400 -%}
  {%- assign editorial_color = mobile_drawer_block.settings.editorial_color | default: '#000000' -%}
  {%- assign editorial_size = mobile_drawer_block.settings.editorial_size | default: 18 -%}
  {%- assign editorial_weight = mobile_drawer_block.settings.editorial_weight | default: 400 -%}
  {%- assign social_icon_size = mobile_drawer_block.settings.social_icon_size | default: 26 -%}
  {%- assign social_btn_size = mobile_drawer_block.settings.social_btn_size | default: 40 -%}
  {%- assign social_btn_bg = mobile_drawer_block.settings.social_btn_bg | default: 'transparent' -%}
  {%- assign social_btn_border = mobile_drawer_block.settings.social_btn_border | default: 'transparent' -%}
  {%- assign menu_title_color = mobile_drawer_block.settings.menu_title_color | default: '#000000' -%}
  {%- assign close_icon_color = mobile_drawer_block.settings.close_icon_color | default: '#000000' -%}
  {%- assign menu_title_size = mobile_drawer_block.settings.menu_title_size | default: 16 -%}
  {%- assign menu_title_weight = mobile_drawer_block.settings.menu_title_weight | default: 400 -%}
  {%- assign search_padding_v = mobile_drawer_block.settings.search_padding_v | default: 12 -%}
  {%- assign search_padding_h = mobile_drawer_block.settings.search_padding_h | default: 16 -%}
  {%- assign search_bg_color = mobile_drawer_block.settings.search_bg_color | default: '#F5F5F5' -%}
  {%- assign search_text_color = mobile_drawer_block.settings.search_text_color | default: '#000000' -%}
  {%- assign search_border_radius = mobile_drawer_block.settings.search_border_radius | default: 8 -%}


  {%- capture mobile_panel_style -%}
    --mobile-menu-top-offset: {{ top_offset_value }}; --mobile-menu-bottom-offset: {{ bottom_offset_value }}; --mobile-menu-side-offset: {{ side_offset_value }}; --mobile-menu-padding-horizontal: {{ padding_horizontal_value }}; --mobile-menu-padding-top: {{ padding_top_value }}; --mobile-menu-padding-bottom: {{ padding_bottom_value }}; --mobile-menu-border-radius: {{ border_radius_value }}; --mobile-menu-item-color: {{ menu_item_color }}; --mobile-menu-item-size: {{ menu_item_size }}px; --mobile-menu-item-weight: {{ menu_item_weight }}; --mobile-editorial-color: {{ editorial_color }}; --mobile-editorial-size: {{ editorial_size }}px; --mobile-editorial-weight: {{ editorial_weight }}; --mobile-social-icon-size: {{ social_icon_size }}px; --mobile-social-btn-size: {{ social_btn_size }}px; --mobile-social-btn-bg: {{ social_btn_bg }}; --mobile-social-btn-border: {{ social_btn_border }}; --mobile-menu-title-color: {{ menu_title_color }}; --mobile-close-icon-color: {{ close_icon_color }}; --mobile-menu-title-size: {{ menu_title_size }}px; --mobile-menu-title-weight: {{ menu_title_weight }}; --mobile-search-padding-v: {{ search_padding_v }}px; --mobile-search-padding-h: {{ search_padding_h }}px; --mobile-search-bg: {{ search_bg_color }}; --mobile-search-text: {{ search_text_color }}; --mobile-search-radius: {{ search_border_radius }}px;  {%- endcapture -%}
  {%- if mobile_drawer_menu != blank -%}
    {%- assign overlay_menu = mobile_drawer_menu -%}
  {%- else -%}
    {%- assign overlay_menu = burger_menu -%}
  {%- endif -%}
  <div class="custom-header--burger-overlay" data-burger-overlay>
    <div class="custom-header--burger-backdrop" data-burger-close></div>
  <div class="custom-header--burger-panel" style="{{ mobile_panel_style }}">
    {%- comment -%} Header del panel {%- endcomment -%}
    <div class="custom-header--burger-header">
      <h2 class="custom-header--burger-title">MENU</h2>
      
      <button 
        class="custom-header--burger-close"
        data-burger-close
        aria-label="Close menu"
        type="button"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--burger-close-icon">
          <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- assign search_placeholder = 'Search' -%}
    <div class="custom-header--burger-search-container">
      <form action="{{ routes.search_url }}" method="get" class="custom-header--burger-search-form">
        <button type="submit" class="custom-header--burger-search-submit" aria-label="Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </button>
        <input type="text" name="q" placeholder="{{ search_placeholder | escape }}" class="custom-header--burger-search-input" autocomplete="off">
      </form>
      <div class="custom-header--burger-search-results" data-burger-search-results></div>
    </div>

    {%- comment -%} Contenido del menú {%- endcomment -%}
    <div class="custom-header--burger-content">
      {%- comment -%} Navegación principal configurable por menú {%- endcomment -%}
      <nav class="custom-header--burger-nav">
        <ul class="custom-header--burger-nav-list" style="gap: {{ mobile_drawer_menu_gap }}px;">
          {%- if overlay_menu != blank and overlay_menu.links.size > 0 -%}
            {%- assign enable_advanced_colors = false -%}
            {%- if mobile_drawer_block -%}
              {%- assign enable_advanced_colors = mobile_drawer_block.settings.enable_advanced_colors -%}
            {%- elsif burger_block -%}
              {%- assign enable_advanced_colors = burger_block.settings.enable_advanced_colors -%}
            {%- endif -%}
            {%- for link in overlay_menu.links -%}
              <li class="custom-header--burger-nav-item" data-burger-item>
                <a 
                  href="{{ link.url }}" 
                class="custom-header--burger-nav-link"
                  {% if link.links.size > 0 %}data-burger-submenu-trigger{% endif %}
              >
                  <span>
                    {%- if enable_advanced_colors -%}
                      {%- for i in (1..20) -%}
                        {%- assign name_key = 'color_name_' | append: i -%}
                        {%- assign hex_key = 'color_hex_' | append: i -%}
                        {%- assign setting_name = settings[name_key] | downcase | strip -%}
                        {%- assign link_title_lower = link.title | downcase | strip -%}
                        {%- if setting_name != blank and setting_name == link_title_lower -%}
                          <span class="snc-color-swatch" style="--swatch-color: {{ settings[hex_key] }};"></span>
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {{ link.title }}
                  </span>
                  {%- if link.links.size > 0 -%}
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--burger-arrow">
                  <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {%- endif -%}
                </a>
                
                {%- if link.links.size > 0 -%}
                  <div class="custom-header--burger-submenu">
                  <div class="custom-header--burger-submenu-content">
                      <ul class="custom-header--burger-subnav">
                        {%- for child in link.links -%}
                          <li>
                            <a href="{{ child.url }}">
                              {%- if enable_advanced_colors -%}
                                {%- for i in (1..20) -%}
                                  {%- assign name_key = 'color_name_' | append: i -%}
                                  {%- assign hex_key = 'color_hex_' | append: i -%}
                                  {%- assign setting_name = settings[name_key] | downcase | strip -%}
                                  {%- assign child_title_lower = child.title | downcase | strip -%}
                                  {%- if setting_name != blank and setting_name == child_title_lower -%}
                                    <span class="snc-color-swatch" style="--swatch-color: {{ settings[hex_key] }};"></span>
                                    {%- break -%}
                                  {%- endif -%}
                                {%- endfor -%}
                              {%- endif -%}
                              {{ child.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                  </div>
                </div>
              {%- endif -%}
              </li>
            {%- endfor -%}
          {%- else -%}
            <li class="custom-header--burger-nav-item custom-header--burger-nav-item--empty">
              <span>Assign a side menu from the section settings.</span>
            </li>
          {%- endif -%}
        </ul>

        {%- assign overlay_secondary_menu = blank -%}
        {%- if mobile_drawer_block and mobile_drawer_block.settings.secondary_menu != blank -%}
          {%- assign overlay_secondary_menu = linklists[mobile_drawer_block.settings.secondary_menu] -%}
        {%- endif -%}
        {%- if overlay_secondary_menu != blank and overlay_secondary_menu.links.size > 0 -%}
          <div class="custom-header--burger-nav-divider"></div>
          <ul class="custom-header--burger-nav-list custom-header--burger-nav-list--secondary" style="gap: {{ mobile_drawer_menu_gap }}px;">
            {%- for link in overlay_secondary_menu.links -%}
              <li class="custom-header--burger-nav-item" data-burger-item>
                <a href="{{ link.url }}" class="custom-header--burger-nav-link custom-header--burger-nav-link--secondary">
                  <span>{{ link.title }}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>

      {%- assign show_footer_content = true -%}
      {%- if mobile_drawer_block and mobile_drawer_block.settings.show_footer_content == false -%}
        {%- assign show_footer_content = false -%}
      {%- endif -%}

      {%- if show_footer_content -%}
      {%- comment -%} Bloque editorial {%- endcomment -%}
      {%- if mobile_drawer_block -%}
        {%- assign final_editorial_text = mobile_drawer_block.settings.editorial_text -%}
        {%- if final_editorial_text == blank -%}
          {%- assign final_editorial_text = 'Cada huarache es una historia tejida a mano, un recuerdo que camina con nosotros.' -%}
        {%- endif -%}
      {%- else -%}
        {%- assign final_editorial_text = burger_block.settings.editorial_text -%}
      {%- endif -%}

      {%- if final_editorial_text != blank -%}
        <div class="custom-header--burger-editorial">
          <p class="custom-header--burger-editorial-text">{{ final_editorial_text }}</p>
        </div>
      {%- endif -%}

      {%- comment -%} Redes sociales {%- endcomment -%}
      {%- assign fb_url = mobile_drawer_block.settings.social_facebook_url | default: settings.social_facebook_link -%}
      {%- assign ig_url = mobile_drawer_block.settings.social_instagram_url | default: settings.social_instagram_link -%}
      {%- assign tt_url = mobile_drawer_block.settings.social_tiktok_url | default: settings.social_tiktok_link -%}
      {%- if fb_url != blank or ig_url != blank or tt_url != blank -%}
        <div class="custom-header--burger-social">
          {%- render 'snc-header-social-icons', block: mobile_drawer_block -%}
        </div>
      {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- comment -%} Barra de Búsqueda Overlay {%- endcomment -%}
{%- if search_block -%}
<div class="custom-header--search-overlay" data-search-overlay style="
  --search-result-title-color: {{ search_block.settings.result_title_color | default: '#000000' }};
  --search-result-title-size: {{ search_block.settings.result_title_size | default: 14 }}px;
  --search-result-title-weight: {{ search_block.settings.result_title_weight | default: 700 }};
  --search-result-price-size: {{ search_block.settings.result_price_size | default: 13 }}px;
  --search-result-price-weight: {{ search_block.settings.result_price_weight | default: 400 }};
  --search-result-image-width: {{ search_block.settings.result_image_width | default: 50 }}px;
  --search-result-image-brightness: {{ search_block.settings.result_image_brightness | default: 100 }}%;
  --search-view-all-color: {{ search_block.settings.view_all_color | default: '#000000' }};
  --search-view-all-weight: {{ search_block.settings.view_all_weight | default: 700 }};
  --search-input-weight: {{ search_block.settings.search_input_weight | default: 400 }};
  --search-bar-radius: {{ search_block.settings.search_bar_radius | default: 10 }}px;
  --search-results-radius: {{ search_block.settings.search_results_radius | default: 10 }}px;
">
  <div class="custom-header--search-backdrop" data-search-close></div>
  <div class="custom-header--search-wrapper">
    <div class="custom-header--search-bar-container">
    <form action="{{ routes.search_url }}" method="get" class="custom-header--search-form">
      <img src="{{ 'Framedl.svg' | asset_url }}" alt="" class="custom-header--search-icon no-filter custom-header--search-form-icon" width="18" height="18" loading="eager" aria-hidden="true">
      <input
        type="text"
        name="q"
        placeholder="Search"
        class="custom-header--search-input"
        autocomplete="off"
        aria-label="Search"
      >
      <button
        type="submit"
        class="custom-header--search-submit"
        aria-label="Search"
        style="display:none"
      >
        <img src="{{ 'Framedl.svg' | asset_url }}" alt="" class="custom-header--search-icon no-filter" width="20" height="20" loading="eager" aria-hidden="true">
      </button>
    </form>
    <button type="button" class="custom-header--search-close-btn" aria-label="Close search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    </div>
    
    <div class="custom-header--search-results" data-search-results></div>
    
  </div>
</div>
{%- endif -%}

{%- comment -%} Carrito Lateral Overlay {%- endcomment -%}
{%- if cart_block -%}
<div class="custom-header--cart-overlay{% if cart_full_height %} custom-header--cart-overlay--full-height{% endif %}" data-cart-overlay>
  <div class="custom-header--cart-backdrop" data-cart-close></div>
  <div class="custom-header--cart-panel">
    {%- comment -%} Header del carrito {%- endcomment -%}
    <div class="custom-header--cart-header">
      <div class="custom-header--cart-switch">
        {%- if wishlist_block_count > 0 -%}
          <button type="button" class="custom-header--cart-switch-btn is-active" data-cart-view="cart">
            {{ cart_tab_label }}
          </button>
          <button type="button" class="custom-header--cart-switch-btn" data-cart-view="wishlist">
            {{ wishlist_tab_label }}
          </button>
        {%- else -%}
          <span class="custom-header--cart-title">{{ cart_title_fallback_text }}</span>
        {%- endif -%}
      </div>
      <button 
        class="custom-header--cart-close"
        data-cart-close
        aria-label="Close cart"
        type="button"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="custom-header--cart-close-icon">
          <path d="M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M6 6L18 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    {%- comment -%} Contenido del carrito {%- endcomment -%}
    <div class="custom-header--cart-body" data-lenis-prevent>
      <div id="custom-header--cart-view">
        {%- comment -%} Barra de progreso de envío gratis {%- endcomment -%}
      {%- assign free_shipping_threshold = free_shipping_threshold_val | times: 100 -%}
      {%- assign cart_total = cart.total_price -%}
      {%- assign remaining_amount = free_shipping_threshold | minus: cart_total -%}
      {%- if remaining_amount > 0 -%}
        {%- assign progress_percentage = cart_total | times: 100 | divided_by: free_shipping_threshold | at_least: 0 | at_most: 100 -%}
      {%- else -%}
        {%- assign progress_percentage = 100 -%}
        {%- assign remaining_amount = 0 -%}
      {%- endif -%}

      <div class="custom-header--cart-shipping-bar">
        {%- if cart_total >= free_shipping_threshold -%}
          <div class="custom-header--cart-shipping-text free-shipping-achieved">
            <span class="custom-header--cart-confetti-icon">✦</span>
            {{ free_shipping_success_message }}
          </div>
        {%- else -%}
        <div class="custom-header--cart-shipping-text">
            {{ free_shipping_text_before }} <strong class="custom-header--cart-shipping-amount">{{ remaining_amount | money_without_trailing_zeros }}</strong> {{ free_shipping_text_after }}
        </div>
        {%- endif -%}
        <div class="custom-header--cart-progress-container">
          <div class="custom-header--cart-progress-bar">
            <div 
              class="custom-header--cart-progress-fill"
              style="width: {{ progress_percentage }}%;"
            ></div>
          </div>
          <div class="custom-header--cart-progress-labels">
            <span class="custom-header--cart-progress-label">$0</span>
            <span class="custom-header--cart-progress-label">{{ free_shipping_threshold | money_without_trailing_zeros }}</span>
          </div>
        </div>
      </div>

      {%- comment -%} Lista de productos {%- endcomment -%}
      <div class="custom-header--cart-items">
        {%- if cart.item_count > 0 -%}
          {%- for item in cart.items -%}
          <div class="custom-header--cart-item" data-cart-item-key="{{ item.key }}">
            <div class="custom-header--cart-item-image-container">
              <a href="{{ item.url }}" style="display:block; height:100%;">
                {%- if item.image -%}
                <img 
                  src="{{ item.image | image_url: width: 113 }}" 
                  alt="{{ item.image.alt | escape }}"
                  class="custom-header--cart-item-image"
                  width="113"
                  loading="lazy"
                >
                {%- else -%}
                <div class="custom-header--cart-item-image-placeholder"></div>
                {%- endif -%}
              </a>
            </div>
            <div class="custom-header--cart-item-details">
              <div class="custom-header--cart-item-heading">
                <h3 class="custom-header--cart-item-title"><a href="{{ item.url }}" style="text-decoration: none; color: inherit;">{{ item.product.title }}</a></h3>
                <button 
                  class="custom-header--cart-wishlist"
                  data-cart-wishlist="{{ item.product.handle }}"
                  data-handle="{{ item.product.handle }}"
                  aria-label="Favorites"
                  type="button"
                >
                  <img src="{{ cart_wishlist_icon_url }}" alt="Favorites">
                </button>
              </div>
              {%- if item.variant.title != 'Default Title' -%}
                <div class="custom-header--cart-item-variant">{{ item.variant.title }}</div>
              {%- endif -%}
              <div class="custom-header--cart-item-meta">
                <div class="custom-header--cart-item-price">
                  {%- if item.original_price != item.final_price -%}
                    <span class="custom-header--cart-item-price-original">{{ item.original_price | money }}</span>
                  {%- endif -%}
                  <span class="custom-header--cart-item-price-final">{{ item.final_price | money }}</span>
                </div>
                <div class="custom-header--cart-item-qty">
                  <div class="custom-header--cart-qty-selector">
                    <button type="button" class="custom-header--cart-qty-btn" data-qty-change="-1" data-key="{{ item.key }}" aria-label="Decrease quantity">
                      <img src="{% if settings.global_icon_minus != blank %}{{ settings.global_icon_minus | image_url: width: 20 }}{% else %}{{ 'minus.svg' | asset_url }}{% endif %}" alt="" class="custom-header--cart-qty-icon" loading="lazy">
                    </button>
                    <input type="text" class="custom-header--cart-qty-input" value="{{ item.quantity }}" readonly>
                    <button type="button" class="custom-header--cart-qty-btn" data-qty-change="1" data-key="{{ item.key }}" aria-label="Increase quantity">
                      <img src="{% if settings.global_icon_plus != blank %}{{ settings.global_icon_plus | image_url: width: 20 }}{% else %}{{ 'plus.svg' | asset_url }}{% endif %}" alt="" class="custom-header--cart-qty-icon" loading="lazy">
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {%- endfor -%}
        {%- else -%}
          <div class="custom-header--cart-empty" style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; text-align: center; padding: 40px 20px;">
            {%- if cart_empty_image != blank -%}
              <img 
                src="{{ cart_empty_image | image_url: width: 400 }}" 
                alt="Empty cart"
                class="custom-header--cart-empty-image"
                style="margin-bottom: 20px; opacity: 0.5;"
              >
            {%- endif -%}
            {%- if cart_empty_title != blank -%}
              <h3 class="custom-header--cart-empty-title {{ cart_empty_title_style }}" style="margin: 0 0 10px 0;">{{ cart_empty_title }}</h3>
            {%- endif -%}
            {%- if cart_empty_text != blank -%}
              <div class="custom-header--cart-empty-text {{ cart_empty_text_style }}" style="margin-bottom: 30px; color: #666;">{{ cart_empty_text }}</div>
            {%- endif -%}
            <div class="custom-header--cart-empty-buttons" style="display: flex; flex-direction: column; gap: 10px; width: 100%; max-width: 280px;">
              {%- if cart_empty_btn_1_text != blank -%}
                <a href="{{ cart_empty_btn_1_link }}" class="custom-header--cart-empty-btn" style="background-color: {{ cart_empty_btn_1_bg }}; color: {{ cart_empty_btn_1_text_color }} !important;">{{ cart_empty_btn_1_text }}</a>
              {%- endif -%}
              {%- if cart_empty_btn_2_text != blank -%}
                <a href="{{ cart_empty_btn_2_link }}" class="custom-header--cart-empty-btn secondary" style="background-color: {{ cart_empty_btn_2_bg }}; color: {{ cart_empty_btn_2_text_color }} !important; border-color: {{ cart_empty_btn_2_text_color }};">{{ cart_empty_btn_2_text }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
      
      {%- if upsell_collection != blank and collections[upsell_collection].products_count > 0 -%}
        <div class="custom-header--cart-upsell">
          <div class="custom-header--cart-upsell-header">
            <div>
              {%- if upsell_title != blank -%}
                <h4 class="custom-header--cart-upsell-title">{{ upsell_title }}</h4>
              {%- endif -%}
              {%- if upsell_text != blank -%}
                <p class="custom-header--cart-upsell-text">{{ upsell_text }}</p>
              {%- endif -%}
            </div>
            <div class="custom-header--cart-upsell-nav">
              <button type="button" class="custom-header--cart-upsell-arrow prev" aria-label="Previous"><svg width="6" height="10" viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9L1 5L5 1"/></svg></button>
              <button type="button" class="custom-header--cart-upsell-arrow next" aria-label="Next"><svg width="6" height="10" viewBox="0 0 6 10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 9L5 5L1 1"/></svg></button>
            </div>
          </div>
          <div class="custom-header--cart-upsell-slider">
            {%- for product in collections[upsell_collection].products limit: upsell_limit -%}
              {%- assign variant = product.selected_or_first_available_variant -%}
              <div class="custom-header--cart-upsell-item">
                <div class="custom-header--cart-upsell-image-container"><img src="{{ product.featured_image | image_url: width: 200 }}" alt="{{ product.title }}" loading="lazy"></div>
                <div class="custom-header--cart-upsell-details">
                  <h5 class="custom-header--cart-upsell-product-title">{{ product.title }}</h5>
                  <div class="custom-header--cart-upsell-meta">
                    <span class="custom-header--cart-upsell-price">{{ product.price | money }}</span>
                    <button
                      type="button"
                      class="custom-header--cart-upsell-add"
                      data-upsell-add="{{ variant.id }}"
                      aria-label="{{ upsell_add_button_text }} {{ product.title }}"
                    >
                      {{ upsell_add_button_text }}
                    </button>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      
      <div class="custom-header--cart-summary" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
        <div class="custom-header--cart-summary-row">
          <span>Subtotal</span>
          <span class="custom-header--cart-subtotal-price">{{ cart.total_price | money }}</span>
        </div>
        <div class="custom-header--cart-summary-row">
          <span>Shipping</span>
          <span class="custom-header--cart-shipping-value">Calculated at checkout</span>
        </div>
        <div class="custom-header--cart-summary-row total">
          <span>Total</span>
          <span class="custom-header--cart-total-price">{{ cart.total_price | money }}</span>
        </div>
      </div>
      </div>

      {%- if wishlist_block_count > 0 -%}
      <div id="custom-header--wishlist-view" style="display: none;">
        <div class="custom-header--wishlist-view-inner">
          <div class="custom-header--wishlist-header">
            <h3>{{ wishlist_title_text }}</h3>
            <p>{{ wishlist_description_text }}</p>
          </div>
          <div class="custom-header--wishlist-items custom-header--cart-items" data-wishlist-layout="{{ wishlist_layout }}">
            <!-- Items will be injected here via JS -->
          </div>
        </div>
      </div>
      {%- endif -%}
    </div>
    <div class="custom-header--cart-toast" aria-live="polite"></div>
    
    {%- comment -%} Footer del carrito {%- endcomment -%}
    <div class="custom-header--cart-footer">
      <a 
        href="/checkout" 
        class="custom-header--cart-checkout-button"
        {% if cart.item_count == 0 %}style="display: none;"{% endif %}
      >
        {{ cart_checkout_btn_label }}
      </a>
      <div class="custom-header--cart-payment-info">
        <div class="custom-header--cart-guarantee">
          {%- if cart_block.settings.cart-guarantee-icon != blank -%}
            <img 
              src="{{ cart_block.settings.cart-guarantee-icon | image_url: width: 20 }}" 
              alt=""
              class="custom-header--cart-guarantee-icon"
              width="20"
              height="20"
              loading="lazy"
              aria-hidden="true"
            >
          {%- endif -%}
          <p class="custom-header--cart-guarantee-text">
            {{ cart_block.settings.cart-guarantee-text | default: 'Your purchase is protected by our service policy' }}
          </p>
        </div>
        <div class="custom-header--cart-payment-icons">
          {%- assign payment_icons = cart_block.settings.cart_payment_icons | split: ',' -%}
          {%- for type in payment_icons -%}
            {{ type | strip | payment_type_svg_tag: class: 'icon icon--full-color' }}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>
{%- endif -%}

{%- comment -%} Collection image map — used as fallback when predictive search returns c.image = null {%- endcomment -%}
<script>
window.__dlCollectionImages = {
  {%- for coll in collections -%}
    {{ coll.handle | json }}: {%- if coll.featured_image -%}{{ coll.featured_image | image_url: width: 200 | json }}{%- elsif coll.products.first.featured_image -%}{{ coll.products.first.featured_image | image_url: width: 200 | json }}{%- else -%}null{%- endif -%}{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
};
</script>

{%- comment -%} Script para comportamiento del header {%- endcomment -%}
<script>
(() => {
  const sectionId = '{{ section.id }}';
  const registry = window.__sncHeaderLifecycle = window.__sncHeaderLifecycle || {};
  if (registry[sectionId]) {
    registry[sectionId].cleanup();
  }

  const instance = { listeners: [], intervals: [] };

  const on = (target, event, handler, options) => {
    if (!target) return;
    target.addEventListener(event, handler, options);
    instance.listeners.push({ target, event, handler, options });
  };

  const setIntervalTracked = (fn, delay) => {
    const id = setInterval(fn, delay);
    instance.intervals.push(id);
    return id;
  };

  instance.cleanup = () => {
    instance.listeners.forEach(({ target, event, handler, options }) => {
      target.removeEventListener(event, handler, options);
    });
    instance.intervals.forEach(clearInterval);
    instance.listeners = [];
    instance.intervals = [];
  };

  registry[sectionId] = instance;

  on(document, 'shopify:section:unload', function(event) {
    if (event.detail.sectionId === sectionId) {
      instance.cleanup();
    }
  });

  (function() {
    const sectionId = '{{ section.id }}';
    window.__customHeaderRegistry = window.__customHeaderRegistry || {};

    function cleanup() {
      const instance = window.__customHeaderRegistry[sectionId];
      if (!instance) return;

      if (instance.scrollHandler) {
        window.removeEventListener('scroll', instance.scrollHandler);
      }

      if (instance.scrollTimeout) {
        cancelAnimationFrame(instance.scrollTimeout);
      }

      if (instance.resizeObserver) {
        instance.resizeObserver.disconnect();
      }

      if (instance.resizeHandler) {
        window.removeEventListener('resize', instance.resizeHandler);
      }

      delete window.__customHeaderRegistry[sectionId];
    }

    function init() {
      cleanup();

      const section = document.getElementById(`shopify-section-${sectionId}`);
      if (!section) return;

      const header = section.querySelector('.custom-header--root');
      const announcementBar = section.querySelector('[data-announcement-bar]');
      const marquee = section.querySelector('[data-marquee="true"] .custom-header--announcement-marquee');
      const stickyEnabled = {{ sticky_enabled | json }};

      const getAnnouncementHeight = () => {
        if (!announcementBar) return 0;
        if (announcementBar.classList.contains('custom-header--announcement-hidden')) {
          return 0;
        }
        return announcementBar.offsetHeight;
      };

      const setHeaderOffset = () => {
        if (!header) return;
        const height = getAnnouncementHeight();
        const headerHeight = header.offsetHeight;
        const totalHeight = height + headerHeight;
        header.style.setProperty('--custom-header-announcement-height', `${height}px`);
        document.documentElement.style.setProperty('--custom-header-total-height', `${totalHeight}px`);
        document.body.style.setProperty('--custom-header-total-height', `${totalHeight}px`);
      };

      setHeaderOffset();

      function applyAutoTheme() {
        if (!header) return;
        // Only update data-dl-header-mode on pages that start transparent (homepage,
        // collection pages with dark hero). Solid and always-dark pages are excluded.
        var heroTheme = window.__dlHeroTheme || 'none';
        var canUpdate = heroTheme === 'dark' || heroTheme === 'light';

        // Use elementsFromPoint to find what section is behind the header center
        const hRect = header.getBoundingClientRect();
        const cx = Math.round(window.innerWidth / 2);
        const cy = Math.round(hRect.top + hRect.height / 2);
        const stack = document.elementsFromPoint(cx, cy);
        for (const el of stack) {
          if (header.contains(el) || el === header) continue;
          // Walk up to find data-header-theme
          let node = el;
          while (node && node !== document.body) {
            if (node.dataset && node.dataset.headerTheme) {
              const sectionTheme = node.dataset.headerTheme;
              header.dataset.activeTheme = sectionTheme;
              if (canUpdate) {
                // "light" theme = dark-bg section needs white icons → transparent-dark
                // "dark"  theme = light-bg section needs black icons → transparent-light
                document.documentElement.setAttribute('data-dl-header-mode',
                  sectionTheme === 'light' ? 'transparent-dark' : 'transparent-light');
              }
              return;
            }
            node = node.parentElement;
          }
        }
        delete header.dataset.activeTheme;
        // Fallback: no tagged section found → assume light/white section
        if (canUpdate) {
          document.documentElement.setAttribute('data-dl-header-mode', 'transparent-light');
        }
      }

      let scrollHandler = null;
      let scrollTimeout = null;

      scrollHandler = () => {
        // Run immediately on every scroll tick — no throttle needed, very lightweight
        applyAutoTheme();

        if (scrollTimeout) return;
        scrollTimeout = requestAnimationFrame(() => {
          const scrollY = window.scrollY;
          const scrolled = scrollY > 50;

          if (announcementBar && !{{ section.settings.announcement_sticky | default: false | json }}) {
            announcementBar.classList.toggle('custom-header--announcement-hidden', scrolled);
            setHeaderOffset();
          }

          const isDarkPage = document.body.classList.contains('template-suffix-nft');
          if (header && stickyEnabled && !isDarkPage) {
            header.classList.toggle('is-sticky', scrollY > 10);
          }

          scrollTimeout = null;
        });
      };

      scrollHandler();
      on(window, 'scroll', scrollHandler, { passive: true });

      // Initial detection on page load
      applyAutoTheme();

      let resizeObserver = null;
      let resizeHandler = null;

      if (announcementBar && 'ResizeObserver' in window) {
        resizeObserver = new ResizeObserver(setHeaderOffset);
        resizeObserver.observe(announcementBar);
      } else {
        resizeHandler = () => setHeaderOffset();
        on(window, 'resize', resizeHandler);
      }

      if (marquee) {
        marquee.style.setProperty('--custom-header-marquee-speed', '{{ announcement_speed }}s');
      }

      window.__customHeaderRegistry[sectionId] = {
        scrollHandler,
        scrollTimeout,
        resizeObserver,
        resizeHandler
      };
    }

    if (document.readyState === 'loading') {
      on(document, 'DOMContentLoaded', init);
    } else {
      init();
    }

    on(document, 'shopify:section:load', function(event) {
      if (event.detail.sectionId === sectionId) {
        init();
      }
    });

    on(document, 'shopify:section:unload', function(event) {
      if (event.detail.sectionId === sectionId) {
        cleanup();
      }
    });
  })();

  // Manejar mega menú (desktop)
  (function() {
    const sectionId = '{{ section.id }}';
    let section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) {
      const root = document.querySelector(`.custom-header--root[data-section-id="${sectionId}"]`);
      if (root) section = root.closest('.shopify-section') || root.parentElement;
    }
    if (!section) return;
    const header = section.querySelector('.custom-header--root');

    const nav = section.querySelector('[data-mega-nav]');
    const triggers = nav ? nav.querySelectorAll('[data-mega-trigger]') : [];
    const panels = section.querySelectorAll('[data-mega-panel]');
    const guard = section.querySelector('[data-mega-guard]');
    const overlay = section.querySelector('[data-mega-overlay]');
    if (panels.length === 0 || triggers.length === 0) return;

    const closeDelay = 400;
    let hideTimeout = null;
    let isPanelOpen = false;

    function openPanel(blockId) {
      if (!blockId) return;
      panels.forEach(p => {
        if (p.dataset.megaPanel !== blockId) {
          p.classList.remove('custom-header--mega-panel-open');
        }
      });
      const targetPanel = section.querySelector(`[data-mega-panel="${blockId}"]`);
      if (!targetPanel) return;
      targetPanel.classList.add('is-initialized');
      void targetPanel.offsetWidth;
      targetPanel.classList.add('custom-header--mega-panel-open');
      if (isPanelOpen) return;
      isPanelOpen = true;
      if (guard) guard.classList.add('is-visible');
      if (overlay) {
        overlay.classList.add('is-initialized');
        void overlay.offsetWidth;
        overlay.classList.add('is-visible');
      }
      if (header) header.classList.add('is-modal-active');
    }

    function closePanel() {
      isPanelOpen = false;
      panels.forEach(p => p.classList.remove('custom-header--mega-panel-open'));
      if (guard) guard.classList.remove('is-visible');
      if (overlay) overlay.classList.remove('is-visible');
      if (header) header.classList.remove('is-modal-active');
    }

    function scheduleClose() {
      cancelClose();
      hideTimeout = setTimeout(closePanel, closeDelay);
    }

    function cancelClose() {
      if (hideTimeout) {
        clearTimeout(hideTimeout);
        hideTimeout = null;
      }
    }

    triggers.forEach(trigger => {
      trigger.addEventListener('mouseenter', () => {
        cancelClose();
        openPanel(trigger.dataset.megaTrigger);
      });
      trigger.addEventListener('focus', () => {
        cancelClose();
        openPanel(trigger.dataset.megaTrigger);
      });
    });

    if (nav) {
      nav.addEventListener('mouseenter', cancelClose);
      nav.addEventListener('mouseleave', scheduleClose);
      nav.addEventListener('focusin', cancelClose);
      nav.addEventListener('focusout', (event) => {
        const nextTarget = event.relatedTarget;
        const isInsideAnyPanel = Array.from(panels).some(p => p.contains(nextTarget));
        if (!nav.contains(nextTarget) && !isInsideAnyPanel) {
          scheduleClose();
        }
      });
    }

    panels.forEach(p => {
      p.addEventListener('mouseenter', cancelClose);
      p.addEventListener('mouseleave', scheduleClose);
    });

    if (guard) {
      guard.addEventListener('mouseenter', cancelClose);
      guard.addEventListener('mouseleave', scheduleClose);
    }

    if (overlay) {
      overlay.addEventListener('click', () => {
        cancelClose();
        closePanel();
      });
    }

    on(document, 'keydown', function(event) {
      if (event.key === 'Escape') {
        cancelClose();
        closePanel();
      }
    });

    window.__customHeaderMega = window.__customHeaderMega || {};
    window.__customHeaderMega[sectionId] = {
      close: closePanel
    };

    on(document, 'shopify:section:unload', function(event) {
      if (event.detail.sectionId === sectionId && window.__customHeaderMega) {
        closePanel();
        delete window.__customHeaderMega[sectionId];
      }
    });
  })();

  // Manejar burger menu
  (function() {
    const sectionId = '{{ section.id }}';
    let section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) {
      const root = document.querySelector(`.custom-header--root[data-section-id="${sectionId}"]`);
      if (root) section = root.closest('.shopify-section') || root.parentElement;
    }
    const container = section || document;
    const header = container.querySelector('.custom-header--root');

    const menuToggle = container.querySelector('.custom-header--menu-toggle');
    const overlay = container.querySelector('[data-burger-overlay]');
    const closeButtons = container.querySelectorAll('[data-burger-close]');
    const backdrop = container.querySelector('.custom-header--burger-backdrop');
    const submenuTriggers = container.querySelectorAll('[data-burger-submenu-trigger]');

    if (!menuToggle || !overlay) return;

    function closeMegaPanel() {
      if (window.__customHeaderMega && window.__customHeaderMega[sectionId]) {
        window.__customHeaderMega[sectionId].close();
      }
    }

    function openMenu() {
      overlay.classList.add('is-initialized');
      void overlay.offsetWidth;
      overlay.classList.add('custom-header--burger-overlay-open');
      document.body.style.overflow = 'hidden';
      closeMegaPanel();
      const searchOverlay = container.querySelector('[data-search-overlay]');
      if (searchOverlay && searchOverlay.classList.contains('custom-header--search-overlay-open')) {
        searchOverlay.classList.remove('custom-header--search-overlay-open');
      }
      const cartOverlay = document.querySelector('[data-cart-overlay]');
      if (cartOverlay && cartOverlay.classList.contains('custom-header--cart-overlay-open')) {
        cartOverlay.classList.remove('custom-header--cart-overlay-open');
      }
      if (header) header.classList.add('is-modal-active');
    }

    function closeMenu() {
      overlay.classList.remove('custom-header--burger-overlay-open');
      document.body.style.overflow = '';
      document.body.classList.remove('menu-open');
      const openSubmenus = overlay.querySelectorAll('.custom-header--burger-submenu-open');
      openSubmenus.forEach(item => item.classList.remove('custom-header--burger-submenu-open'));
      if (header) header.classList.remove('is-modal-active');
    }

    menuToggle.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      if (this.hasAttribute('data-burger-inactive')) return;
      openMenu();
    });

    closeButtons.forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeMenu();
      });
    });

    if (backdrop) {
      backdrop.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        closeMenu();
      });
    }

    overlay.addEventListener('click', function(e) {
      if (e.target === overlay || e.target === backdrop) {
        closeMenu();
      }
    });

    submenuTriggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        const navItem = trigger.closest('.custom-header--burger-nav-item');
        if (!navItem) return;
        e.preventDefault();
        const isOpen = navItem.classList.contains('custom-header--burger-submenu-open');
        if (isOpen) {
          navItem.classList.remove('custom-header--burger-submenu-open');
        } else {
          const allItems = overlay.querySelectorAll('.custom-header--burger-nav-item');
          allItems.forEach(item => item.classList.remove('custom-header--burger-submenu-open'));
          navItem.classList.add('custom-header--burger-submenu-open');
        }
      });
    });

    on(document, 'keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('custom-header--burger-overlay-open')) {
        closeMenu();
      }
    });
  })();

  // Manejar barra de búsqueda
  (function() {
    const sectionId = '{{ section.id }}';
    let section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) {
      const root = document.querySelector(`.custom-header--root[data-section-id="${sectionId}"]`);
      if (root) section = root.closest('.shopify-section') || root.parentElement;
    }
    const container = section || document;
    const header = container.querySelector('.custom-header--root');

    const searchToggles = container.querySelectorAll('[data-search-toggle]');
    const searchOverlay = container.querySelector('[data-search-overlay]');
    const searchBackdrop = container.querySelector('.custom-header--search-backdrop');
    const searchInput = container.querySelector('.custom-header--search-input');
    const searchResults = container.querySelector('[data-search-results]');
    const searchTrending = container.querySelector('.custom-header--search-trending');

    if (searchToggles.length === 0 || !searchOverlay) return;

    function closeMegaPanel() {
      if (window.__customHeaderMega && window.__customHeaderMega[sectionId]) {
        window.__customHeaderMega[sectionId].close();
      }
    }

    function openSearch() {
      searchOverlay.classList.add('is-initialized');
      void searchOverlay.offsetWidth;
      searchOverlay.classList.add('custom-header--search-overlay-open');
      document.body.style.overflow = 'hidden';
      const burgerOverlay = container.querySelector('[data-burger-overlay]');
      if (burgerOverlay && burgerOverlay.classList.contains('custom-header--burger-overlay-open')) {
        burgerOverlay.classList.remove('custom-header--burger-overlay-open');
      }
      const cartOverlay = document.querySelector('[data-cart-overlay]');
      if (cartOverlay && cartOverlay.classList.contains('custom-header--cart-overlay-open')) {
        cartOverlay.classList.remove('custom-header--cart-overlay-open');
      }
      closeMegaPanel();
      setTimeout(() => {
        if (searchInput) searchInput.focus();
      }, 300);
      if (header) header.classList.add('is-modal-active');
    }

    function closeSearch() {
      searchOverlay.classList.remove('custom-header--search-overlay-open');
      document.body.style.overflow = '';
      if (header) header.classList.remove('is-modal-active');
    }

    searchToggles.forEach(toggle => {
      toggle.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        openSearch();
      });
    });

    if (searchBackdrop) {
      searchBackdrop.addEventListener('click', closeSearch);
    }

    const searchCloseBtn = container.querySelector('.custom-header--search-close-btn');
    if (searchCloseBtn) {
      searchCloseBtn.addEventListener('click', closeSearch);
    }

    on(document, 'keydown', function(e) {
      if (e.key === 'Escape' && searchOverlay.classList.contains('custom-header--search-overlay-open')) {
        closeSearch();
      }
    });

    let debounceTimer;
    if (searchInput) {
      searchInput.addEventListener('input', function(e) {
        const term = e.target.value.trim();
        clearTimeout(debounceTimer);

        if (term.length === 0) {
          if (searchResults) searchResults.innerHTML = '';
          if (searchTrending) searchTrending.style.display = 'block';
          return;
        }

        debounceTimer = setTimeout(() => {
          fetch(`/search/suggest.json?q=${encodeURIComponent(term)}&resources[type]=product,collection&resources[limit]=5`)
            .then(res => res.json())
            .then(data => {
              const products = data.resources.results.products || [];
              const collections = data.resources.results.collections || [];
              
              if (searchResults) {
                if (products.length > 0 || collections.length > 0) {
                  let html = '';
                  
                  if (collections.length > 0) {
                    html += '<div class="custom-header--search-section-title">Collections</div>';
                    collections.forEach(c => {
                      const imgUrl = c.image || (window.__dlCollectionImages && window.__dlCollectionImages[c.handle]) || null;
                      const img = imgUrl ? `<img src="${imgUrl}" alt="${c.title}" class="custom-header--search-result-image">` : `<div class="custom-header--search-result-image placeholder"></div>`;
                      html += `
                        <a href="${c.url}" class="custom-header--search-result-item">
                          ${img}
                          <div class="custom-header--search-result-info">
                            <p class="custom-header--search-result-title">${c.title}</p>
                          </div>
                        </a>
                      `;
                    });
                  }

                  if (products.length > 0) {
                    if (collections.length > 0) {
                      html += '<div class="custom-header--search-section-title">Products</div>';
                    }
                    products.forEach(p => {
                      const rawPrice = parseFloat(p.price);
                      const fmtPrice = isNaN(rawPrice) ? '' : rawPrice.toLocaleString('en-US', { style: 'currency', currency: '{{ shop.currency }}', minimumFractionDigits: 0, maximumFractionDigits: 0 });
                      html += `
                        <a href="${p.url}" class="custom-header--search-result-item">
                          <img src="${p.image}" alt="${p.title}" class="custom-header--search-result-image">
                          <div class="custom-header--search-result-info">
                            <p class="custom-header--search-result-title">${p.title}</p>
                            <p class="custom-header--search-result-price">${fmtPrice}</p>
                          </div>
                        </a>
                      `;
                    });
                  }
                  
                  html += `
                    <a href="${window.routes ? window.routes.search_url : '/search'}?q=${encodeURIComponent(term)}" class="custom-header--search-view-all">
                      View all results
                    </a>
                  `;
                  searchResults.innerHTML = html;
                  if (searchTrending) searchTrending.style.display = 'none';
                } else {
                  searchResults.innerHTML = `<p class="custom-header--search-no-results">No results found</p>`;
                  if (searchTrending) searchTrending.style.display = 'none';
                }
              }
            });
        }, 300);
      });
    }
  })();

  // ─────────────────────────────────────────────────────────────
  // Mobile burger search — predictive suggestions
  // ─────────────────────────────────────────────────────────────
  (function() {
    const burgerInput = document.querySelector('.custom-header--burger-search-input');
    const burgerResults = document.querySelector('[data-burger-search-results]');
    if (!burgerInput || !burgerResults) return;

    let burgerDebounce;

    function renderBurgerResults(term, products, collections) {
      if (products.length === 0 && collections.length === 0) {
        burgerResults.innerHTML = '<p class="custom-header--search-no-results">No results found</p>';
        return;
      }
      let html = '';
      if (collections.length > 0) {
        html += '<div class="custom-header--search-section-title">Collections</div>';
        collections.forEach(function(c) {
          const imgUrl = c.image || (window.__dlCollectionImages && window.__dlCollectionImages[c.handle]) || null;
          const img = imgUrl
            ? `<img src="${imgUrl}" alt="${c.title}" class="custom-header--search-result-image">`
            : `<div class="custom-header--search-result-image placeholder"></div>`;
          html += `<a href="${c.url}" class="custom-header--search-result-item">${img}<div class="custom-header--search-result-info"><p class="custom-header--search-result-title">${c.title}</p></div></a>`;
        });
      }
      if (products.length > 0) {
        html += '<div class="custom-header--search-section-title">Products</div>';
        products.forEach(function(p) {
          const priceFormatted = p.price ? (p.price / 100).toLocaleString('en-US', { style: 'currency', currency: '{{ shop.currency }}' }) : '';
          html += `<a href="${p.url}" class="custom-header--search-result-item"><img src="${p.image}" alt="${p.title}" class="custom-header--search-result-image"><div class="custom-header--search-result-info"><p class="custom-header--search-result-title">${p.title}</p><p class="custom-header--search-result-price">${priceFormatted}</p></div></a>`;
        });
      }
      const searchUrl = (window.routes && window.routes.search_url) ? window.routes.search_url : '/search';
      html += `<a href="${searchUrl}?q=${encodeURIComponent(term)}&type=product" class="custom-header--search-view-all">View all results</a>`;
      burgerResults.innerHTML = html;
    }

    burgerInput.addEventListener('input', function() {
      const term = burgerInput.value.trim();
      clearTimeout(burgerDebounce);
      if (term.length === 0) {
        burgerResults.innerHTML = '';
        return;
      }
      burgerDebounce = setTimeout(function() {
        fetch(`/search/suggest.json?q=${encodeURIComponent(term)}&resources[type]=product,collection&resources[limit]=5`)
          .then(function(r) { return r.json(); })
          .then(function(data) {
            const products = (data.resources && data.resources.results && data.resources.results.products) || [];
            const collections = (data.resources && data.resources.results && data.resources.results.collections) || [];
            renderBurgerResults(term, products, collections);
          })
          .catch(function() {
            burgerResults.innerHTML = '';
          });
      }, 280);
    });

    // Clear results when drawer closes
    document.addEventListener('click', function(e) {
      const closeTrigger = e.target.closest('[data-burger-overlay-close], .custom-header--burger-close');
      if (closeTrigger) {
        burgerResults.innerHTML = '';
        burgerInput.value = '';
      }
    });
  })();

  // ─────────────────────────────────────────────────────────────
  // NUEVO: Interceptar botón de Favorites del header
  // Al hacer clic en el corazón, abre el modal y activa la pestaña Favorites
  // en lugar de navegar a /pages/wishlist
  // ─────────────────────────────────────────────────────────────
  (function() {
    document.addEventListener('click', function(e) {
      const wishlistBtn = e.target.closest('.custom-header--wishlist');
      if (!wishlistBtn) return;

      e.preventDefault();
      e.stopPropagation();

      if (typeof window.openCartDrawer === 'function') {
        window.openCartDrawer();
      }

      setTimeout(function() {
        const wishlistTab = document.querySelector('[data-cart-view="wishlist"]');
        if (wishlistTab) wishlistTab.click();
      }, 80);
    });
  })();

  // Inicializar contador de wishlist en menú lateral
  (function() {
    const STORAGE_KEY = 'snc_favorites';
    
    function getFavorites() {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        return raw ? JSON.parse(raw) : [];
      } catch (e) {
        return [];
      }
    }
    
    function updateWishlistCounts() {
      const favs = getFavorites();
      const count = favs.length;
      
      const wishlistLinks = document.querySelectorAll('.custom-header--wishlist');
      wishlistLinks.forEach(link => {
        let badge = link.querySelector('.custom-header--wishlist-count');
        if (!badge) {
          badge = document.createElement('span');
          badge.className = 'custom-header--wishlist-count';
          link.appendChild(badge);
        }
        badge.textContent = count;
        badge.style.display = count > 0 ? 'flex' : 'none';
        if (count > 0) {
          badge.classList.remove('is-bumping');
          void badge.offsetWidth;
          badge.classList.add('is-bumping');
        }
      });
    }
    
    if (document.readyState === 'loading') {
      on(document, 'DOMContentLoaded', updateWishlistCounts);
    } else {
      updateWishlistCounts();
    }
    
    on(window, 'storage', function(e) {
      if (e.key === STORAGE_KEY) {
        updateWishlistCounts();
      }
    });
    
    on(window, 'snc:wishlist-updated', updateWishlistCounts);
  })();

  // Manejar slider de anuncios
  (function() {
    const sectionId = '{{ section.id }}';
    const section = document.getElementById(`shopify-section-${sectionId}`);
    if (!section) return;

    const slider = section.querySelector('.custom-header--announcement-slider');
    if (!slider) return;

    const slides = slider.querySelectorAll('.custom-header--announcement-slide');
    if (slides.length < 2) return;

    const prevBtn = section.querySelector('.custom-header--announcement-arrow.prev');
    const nextBtn = section.querySelector('.custom-header--announcement-arrow.next');
    const playPauseBtn = section.querySelector('.custom-header--announcement-play-pause');
    const iconPause = playPauseBtn ? playPauseBtn.querySelector('.icon-pause') : null;
    const iconPlay = playPauseBtn ? playPauseBtn.querySelector('.icon-play') : null;
    
    let currentIndex = 0;
    let isPlaying = true;
    let interval;
    const speed = parseInt(slider.dataset.autoplaySpeed) || 5000;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('active', i === index);
      });
      currentIndex = index;
    }

    function nextSlide() {
      let newIndex = currentIndex + 1;
      if (newIndex >= slides.length) newIndex = 0;
      showSlide(newIndex);
    }

    function prevSlide() {
      let newIndex = currentIndex - 1;
      if (newIndex < 0) newIndex = slides.length - 1;
      showSlide(newIndex);
    }

    function startAutoplay() {
      if (interval) clearInterval(interval);
      interval = setIntervalTracked(nextSlide, speed);
      isPlaying = true;
      if (playPauseBtn) playPauseBtn.dataset.state = 'playing';
      if (iconPause) iconPause.style.display = 'block';
      if (iconPlay) iconPlay.style.display = 'none';
    }

    function stopAutoplay() {
      if (interval) clearInterval(interval);
      isPlaying = false;
      if (playPauseBtn) playPauseBtn.dataset.state = 'paused';
      if (iconPause) iconPause.style.display = 'none';
      if (iconPlay) iconPlay.style.display = 'block';
    }

    if (prevBtn) prevBtn.addEventListener('click', () => { prevSlide(); if (isPlaying) startAutoplay(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { nextSlide(); if (isPlaying) startAutoplay(); });

    if (playPauseBtn) {
      playPauseBtn.addEventListener('click', () => {
        isPlaying ? stopAutoplay() : startAutoplay();
      });
    }

    startAutoplay();
  })();
})();
</script>

