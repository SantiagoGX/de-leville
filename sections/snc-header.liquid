/* ════════════════════════════════════════════════════════════════════════════
   HEADER: ALWAYS TRANSPARENT — ICONS FOLLOW SECTION
   Single source of truth. Overrides everything above.
   Two states:
     default          → dark icons (most sections are light/white)
     data-active-theme="light" → white icons (dark/video sections like hero)
   Sections signal which state via data-header-theme="light"|"dark" on their
   root element. The IntersectionObserver (above) reads this and sets
   data-active-theme on the header root.
   ════════════════════════════════════════════════════════════════════════════ */

/* 1. Background: transparent in every possible state */
.custom-header--root,
.custom-header--root.is-sticky,
.custom-header--root.force-sticky-style,
.custom-header--root.is-modal-active {
  --custom-header-background: transparent !important;
}

/* 2. Default: dark icons — correct for light/white sections */
.custom-header--root .icon-static,
.custom-header--root .logo-static {
  display: none !important;
}
.custom-header--root .icon-sticky,
.custom-header--root .logo-sticky {
  display: block !important;
}

/* 3. Dark section in view (hero, dark video) → white icons.
      Applies in ALL states: sticky, non-sticky, force-sticky.
      opacity overrides here beat the mid-file is-sticky opacity rules
      (same specificity 0,3,0 — last source wins with !important). */
.custom-header--root[data-active-theme="light"] .icon-static,
.custom-header--root[data-active-theme="light"] .logo-static {
  display: block !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}
.custom-header--root[data-active-theme="light"] .icon-sticky,
.custom-header--root[data-active-theme="light"] .logo-sticky {
  display: none !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

/* 4. force-light-theme — HIGHEST PRIORITY OVERRIDE for non-home pages.
      Must come last to beat data-active-theme="light" auto-detect. */
.custom-header--root.force-light-theme,
.custom-header--root.force-light-theme[data-active-theme="light"],
.custom-header--root.force-light-theme[data-active-theme="dark"],
.custom-header--root.force-light-theme.is-sticky {
  background-color: #ffffff !important;
  --custom-header-background: #ffffff !important;
}
.custom-header--root.force-light-theme .logo-sticky,
.custom-header--root.force-light-theme .icon-sticky,
.custom-header--root.force-light-theme[data-active-theme="light"] .logo-sticky,
.custom-header--root.force-light-theme[data-active-theme="light"] .icon-sticky,
.custom-header--root.force-light-theme.is-sticky .logo-sticky,
.custom-header--root.force-light-theme.is-sticky .icon-sticky {
  display: block !important;
}
.custom-header--root.force-light-theme .logo-static,
.custom-header--root.force-light-theme .icon-static,
.custom-header--root.force-light-theme[data-active-theme="light"] .logo-static,
.custom-header--root.force-light-theme[data-active-theme="light"] .icon-static,
.custom-header--root.force-light-theme.is-sticky .logo-static,
.custom-header--root.force-light-theme.is-sticky .icon-static {
  display: none !important;
}
.custom-header--root.force-light-theme .custom-header--nav-link,
.custom-header--root.force-light-theme .custom-header--right-label,
.custom-header--root.force-light-theme .custom-header--menu-toggle,
.custom-header--root.force-light-theme a,
.custom-header--root.force-light-theme[data-active-theme="light"] .custom-header--nav-link,
.custom-header--root.force-light-theme[data-active-theme="light"] .custom-header--right-label,
.custom-header--root.force-light-theme[data-active-theme="light"] a {
  color: #000000 !important;
}
.custom-header--announcement-section:has(+ .custom-header--root.force-light-theme),
.custom-header--root.force-light-theme ~ .custom-header--announcement-section {
  /* Announcement bar stays its own color; no change needed */
}

/* ==========================================================
   De Leville · Header behavior v2 (April 20, 2026)
   Two-state system driven by data-dl-header-mode on <html>:
     "transparent" · white content, no background (over dark hero)
     "solid"       · default white background, dark content
   Sticky at the top always.
   ========================================================== */

/* Header uses position: fixed (not sticky) because the parent
   .shopify-section.section--custom-header has `height: 0 !important`
   which would break sticky positioning. */
.custom-header--root[data-sticky="true"],
.custom-header--root {
  position: fixed !important;
  top: var(--custom-header-announcement-height, 36px) !important;
  left: 0 !important;
  right: 0 !important;
  z-index: 1000 !important;
}
.custom-header--announcement-section {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  max-width: 100vw !important;
  overflow: hidden !important;
  box-sizing: border-box !important;
  z-index: 1002 !important;
}

/* Push body content below the fixed header.
   On transparent-hero pages, the first content section pulls itself
   back up under the header via negative margin (rule below). */
body {
  padding-top: var(--custom-header-total-height, 108px);
}

/* On TRANSPARENT-hero pages, the first content section (the hero itself)
   pulls itself up under the transparent header so the imagery starts at 0. */
html[data-dl-header-mode^="transparent"] body {
  padding-top: 0;
}
html[data-dl-header-mode^="transparent"] body > .shopify-section:not(.shopify-section-group-header-group):not([id*="header"]):not([id*="announcement"]):first-of-type {
  margin-top: 0;
}

/* TRANSPARENT — base (shared by both dark and light variants) */
html[data-dl-header-mode^="transparent"] .custom-header--root {
  background: transparent !important;
  border-bottom: none !important;
}

/* TRANSPARENT · DARK hero — white logo + white icons over dark imagery */
html[data-dl-header-mode="transparent-dark"] .custom-header--root .logo-static,
html[data-dl-header-mode="transparent-dark"] .custom-header--root .icon-static {
  display: block !important;
}
html[data-dl-header-mode="transparent-dark"] .custom-header--root .logo-sticky,
html[data-dl-header-mode="transparent-dark"] .custom-header--root .icon-sticky {
  display: none !important;
}
html[data-dl-header-mode="transparent-dark"] .custom-header--root .custom-header--nav-link,
html[data-dl-header-mode="transparent-dark"] .custom-header--root .custom-header--right-label,
html[data-dl-header-mode="transparent-dark"] .custom-header--root .custom-header--menu-toggle,
html[data-dl-header-mode="transparent-dark"] .custom-header--root a {
  color: #ffffff !important;
}
html[data-dl-header-mode="transparent-dark"] .custom-header--root .icon-static.custom-header--burger-icon,
html[data-dl-header-mode="transparent-dark"] .custom-header--root .icon-static.custom-header--icon {
  filter: brightness(0) invert(1) !important;
}

/* TRANSPARENT · LIGHT hero — black logo + black icons over light imagery */
html[data-dl-header-mode="transparent-light"] .custom-header--root .icon-sticky {
  display: block !important;
}
html[data-dl-header-mode="transparent-light"] .custom-header--root .logo-sticky {
  display: block !important;
  opacity: 1 !important;
  pointer-events: auto !important;
  transition: opacity 0s !important;
}
html[data-dl-header-mode="transparent-light"] .custom-header--root .logo-static,
html[data-dl-header-mode="transparent-light"] .custom-header--root .icon-static {
  display: none !important;
}
html[data-dl-header-mode="transparent-light"] .custom-header--root .custom-header--nav-link,
html[data-dl-header-mode="transparent-light"] .custom-header--root .custom-header--right-label,
html[data-dl-header-mode="transparent-light"] .custom-header--root .custom-header--menu-toggle,
html[data-dl-header-mode="transparent-light"] .custom-header--root a {
  color: #1a1a1a !important;
}
html[data-dl-header-mode="transparent-light"] .custom-header--root .custom-header--burger-icon,
html[data-dl-header-mode="transparent-light"] .custom-header--root .custom-header--icon {
  filter: none !important;
}

/* SOLID MODE — default */
html[data-dl-header-mode="solid"] .custom-header--root,
.custom-header--root:not([data-dl-header-mode]) {
  background: #ffffff !important;
  transition: background-color 300ms ease;
}
html[data-dl-header-mode="solid"] .custom-header--root .logo-sticky,
html[data-dl-header-mode="solid"] .custom-header--root .icon-sticky {
  display: block !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}
html[data-dl-header-mode="solid"] .custom-header--root .logo-static,
html[data-dl-header-mode="solid"] .custom-header--root .icon-static {
  display: none !important;
  opacity: 0 !important;
  pointer-events: none !important;
}
html[data-dl-header-mode="solid"] .custom-header--root .custom-header--nav-link,
html[data-dl-header-mode="solid"] .custom-header--root .custom-header--right-label,
html[data-dl-header-mode="solid"] .custom-header--root .custom-header--menu-toggle,
html[data-dl-header-mode="solid"] .custom-header--root a {
  color: #1a1a1a !important;
}

/* Smooth transition between modes */
.custom-header--root,
.custom-header--root a,
.custom-header--root .custom-header--nav-link,
.custom-header--root .custom-header--burger-icon,
.custom-header--root .custom-header--icon {
  transition: background-color 300ms ease, color 300ms ease, filter 300ms ease, border-color 300ms ease, top 600ms ease-out;
}

/* Cart badge must always be legible: white number on black bubble */
.custom-header--root .custom-header--cart-count {
  background-color: #000000 !important;
  color: #ffffff !important;
}

</style>

