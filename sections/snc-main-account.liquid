{%- comment -%}
  SNC Main Account Section
  Replica la estructura de "Mi cuenta" solicitada.
{%- endcomment -%}

<style>
  .snc-account--wrapper {
    max-width: 1512px;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    margin-top: var(--MT);
    margin-bottom: var(--MB);
    box-sizing: border-box;
  }
  
  .snc-account--header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 0;
  }
  
  .snc-account--title {
    font-size: 24px;
    font-weight: 500;
    margin: 0;
    font-family: var(--font-main, sans-serif);
    color: {{ section.settings.main_color | default: '#000000' }};
  }
  
  .snc-account--logout {
    text-decoration: none;
    color: inherit;
    font-size: 14px;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    transition: opacity 0.2s;
  }
  .snc-account--logout:hover { opacity: 0.7; }
  
  .snc-account--hr {
    border: 0;
    border-top: 1px solid #e5e5e5;
    margin: 0 0 30px 0;
    height: 1px;
    display: block;
  }
  
  .snc-account--grid {
    display: flex;
    flex-wrap: wrap;
    margin-left: -20px;
    margin-top: 12px;
  }
  
  .snc-account--col {
    padding-left: 20px;
    box-sizing: border-box;
  }
  
  .snc-account--col-main {
    width: 66.666%;
  }
  
  .snc-account--col-sidebar {
    width: 33.333%;
  }
  
  .snc-account--subtitle {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 15px;
    margin-top: 8px;
    font-family: var(--font-main, sans-serif);
    color: {{ section.settings.main_color | default: '#000000' }};
    text-align: left;
  }
  
  .snc-account--address {
    font-style: normal;
    line-height: 1.6;
    margin-bottom: 15px;
    color: #333;
  }
  
  .snc-account--link {
    text-decoration: none;
    color: inherit;
    font-weight: 600;
    font-size: 14px;
    margin-top: 6px;
    display: inline-block;
  }
  .snc-account--link:hover { text-decoration: underline; }
  
  @media (max-width: 768px) {
    .snc-account--col-main,
    .snc-account--col-sidebar {
      width: 100%;
    }
    .snc-account--col-sidebar {
      margin-top: 40px;
    }
  }
</style>

<div class="snc-account--wrapper" style="--MT: {{ section.settings.margin_top }}px; --MB: {{ section.settings.margin_bottom }}px;">

  <header class="snc-account--header">
    <h1 class="snc-account--title">{{ section.settings.title | default: 'My account' }}</h1>
    <div class="account-header__right">
      <a href="{{ routes.account_logout_url }}" class="snc-account--logout">{{ section.settings.log_out_text | default: 'Log out' }}</a>
    </div>
  </header>

  <hr class="snc-account--hr">

  <div class="snc-account--grid">

    <div class="snc-account--col snc-account--col-main">
      <h2 class="snc-account--subtitle">{{ section.settings.orders_title | default: 'Order history' }}</h2>

      {% paginate customer.orders by 20 %}
        {% if customer.orders.size > 0 %}
          <p>You have {{ customer.orders.size }} orders.</p>
        {% else %}
          <p>{{ section.settings.no_orders_text | default: "You haven't placed any orders yet." }}</p>
        {% endif %}

        {%- if paginate.pages > 1 -%}
          {{ paginate | default_pagination }}
        {%- endif -%}
      {% endpaginate %}
    </div>

    <div class="snc-account--col snc-account--col-sidebar">
      <h2 class="snc-account--subtitle">{{ section.settings.account_details_title | default: 'Account details' }}</h2>

      <div class="snc-account--address">
        {{ customer.default_address | format_address }}
      </div>

      <p><a class="snc-account--link" href="{{ routes.account_addresses_url }}">{{ section.settings.view_addresses_text | default: 'View addresses' }} ({{ customer.addresses_count }})</a></p>
    </div>

  </div>

</div>

{% schema %}
{
  "name": "SNC Account",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "main_color",
      "label": "Main color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Texts"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Main title",
      "default": "My account"
    },
    {
      "type": "text",
      "id": "log_out_text",
      "label": "Log out text",
      "default": "Log out"
    },
    {
      "type": "text",
      "id": "orders_title",
      "label": "Order history title",
      "default": "Order history"
    },
    {
      "type": "text",
      "id": "no_orders_text",
      "label": "No orders text",
      "default": "You haven't placed any orders yet."
    },
    {
      "type": "text",
      "id": "account_details_title",
      "label": "Account details title",
      "default": "Account details"
    },
    {
      "type": "text",
      "id": "view_addresses_text",
      "label": "View addresses text",
      "default": "View addresses"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Top margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Bottom margin",
      "default": 40
    }
  ]
}
{% endschema %}