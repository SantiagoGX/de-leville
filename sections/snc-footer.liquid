{%- comment -%}
  SNC Footer - Footer personalizado según diseño Figma
  Estructura:
  - Bloques reordenables: Newsletter+Social, Navegación, Firma.
{%- endcomment -%}
<style>
  .snc-footer {
    width: 100%;
    padding: 20px;
    letter-spacing: -0.04em;
    transition: background-color 0.3s ease;
  }
  .snc-footer.full-width {
    display: grid;
    grid-template-columns: var(--content-grid);
    padding-left: 0;
    padding-right: 0;
  }
  .snc-footer.full-width > .snc-footer--container {
    grid-column: 1 / -1;
    padding-left: 20px;
    padding-right: 20px;
  }
  .snc-footer--no-outer {
    padding: 0;
  }
  .snc-footer--container {
    width: 100%;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  .snc-footer--main {
    width: 100%;
    margin: 0;
    padding: 35px 40px 25px;
    box-sizing: border-box;
    transition: background-color 0.3s ease, border-radius 0.3s ease;
  }
  .snc-footer--top-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 30px;
    margin-bottom: 0;
  }
  .snc-footer--logo-newsletter {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .snc-footer--logo {
    display: block;
    text-decoration: none;
  }
  .snc-footer--logo.is-inverted {
    filter: invert(1);
  }
  .snc-footer--logo img,
  .snc-footer--logo-img {
    width: var(--logo-width, 200px);
    max-width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .snc-footer--newsletter-block {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .snc-footer--newsletter-header {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .snc-footer--newsletter-title {
    line-height: 1.2;
    margin: 0;
  }
  .snc-footer--newsletter-paragraph,
  .snc-footer--newsletter-paragraph p {
    line-height: 1.5;
    margin: 0;
    font-weight: inherit;
    font-size: inherit;
    color: inherit;
  }
  .snc-footer--payment-icons {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .snc-footer--payment-icons .icon {
    height: 24px;
    width: auto;
    display: block;
  }
  .snc-footer--newsletter {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    flex-wrap: nowrap;
    position: relative;
    border-bottom: 1px solid rgba(0, 0, 0, 0.3);
    transition: border-color 0.2s ease;
  }
  .snc-footer--newsletter:focus-within {
    border-bottom-color: #000000;
  }
  .snc-footer--newsletter.snc-footer--newsletter--inside {
    position: relative;
    width: var(--newsletter-input-width, 150px);
    gap: 0;
  }
  .snc-footer--newsletter.snc-footer--newsletter--inside .snc-footer--newsletter-fields {
    flex: 1;
    min-width: 0;
    position: relative;
  }
  .snc-footer--newsletter.snc-footer--newsletter--inside .snc-footer--newsletter-input {
    width: 100%;
    padding-right: 40px;
  }
  .snc-footer--newsletter.snc-footer--newsletter--inside .snc-footer--newsletter-btn {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    margin: auto;
    width: 32px;
    height: 32px;
    padding: 0;
  }
  .snc-footer--newsletter-input {
    font-family: var(--font-body-family);
    font-size: 15px;
    color: #000000;
    border: none;
    background: transparent;
    padding: 10px 0;
    width: var(--newsletter-input-width, 150px);
    outline: none !important;
    box-shadow: none !important;
  }
  .snc-footer--newsletter-input:focus,
  .snc-footer--newsletter-input:focus-visible {
    outline: none !important;
    box-shadow: none !important;
  }
  .snc-footer--newsletter-input::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }
  .snc-footer--newsletter-btn {
    width: 32px;
    height: auto;
    padding: 10px 0;
    background-color: transparent;
    border: none;
    outline: none !important;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease;
    flex-shrink: 0;
    color: #000000;
  }
  .snc-footer--newsletter-btn:focus,
  .snc-footer--newsletter-btn:focus-visible {
    outline: none !important;
  }
  .snc-footer--newsletter-btn:hover {
    transform: scale(1.1);
  }
  .snc-footer--newsletter-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #000000;
    stroke-width: 2;
  }
  /* Loading state */
  .snc-footer--newsletter.is-submitting .snc-footer--newsletter-btn {
    opacity: 0.25;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .snc-footer--newsletter.is-submitting .snc-footer--newsletter-input {
    opacity: 0.5;
    transition: opacity 0.3s ease;
  }
  /* Success fade-in */
  @keyframes sncSuccessFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0);   }
  }
  .snc-footer--newsletter-success {
    animation: sncSuccessFadeIn 0.45s cubic-bezier(.22,.61,.36,1) both;
  }
  /* Error — muted, refined */
  .snc-footer--newsletter-error {
    font-size: 11px !important;
    letter-spacing: 0.04em !important;
    color: rgba(160, 55, 55, 0.82) !important;
  }
  .snc-footer--social {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .snc-footer--social.align-bottom {
    align-self: flex-end;
  }
  .snc-footer--social-link {
    width: var(--social-container-size, 50px);
    height: var(--social-container-size, 50px);
    border-radius: 50%;
    border: 1.5px solid #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease, transform 0.2s ease;
    text-decoration: none;
  }
  .snc-footer--social-link:hover {
    background-color: rgba(0, 0, 0, 0.06);
    transform: scale(1.05);
  }
  .snc-footer--social-icon {
    width: var(--social-icon-size, 26px);
    height: var(--social-icon-size, 26px);
    object-fit: contain;
  }
  .snc-footer--divider {
    width: 100%;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.06);
    margin: 0;
  }
  .snc-footer--menus {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 30px;
    margin-bottom: 0;
    width: 100%;
  }
  .snc-footer--menu-items {
    display: flex;
    justify-content: center;
    width: 100%;
    flex-wrap: wrap;
    gap: var(--menu-gap-desktop, 30px);
  }
  .snc-footer--menu-column {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .snc-footer--menu-column.is-empty {
    display: none;
  }
  .snc-footer--menu-title {
    font-family: var(--font-body-family);
    font-size: 13px;
    font-weight: var(--menu-title-weight, 400);
    color: var(--menu-title-color, rgba(0, 0, 0, 0.4));
    text-transform: none;
    letter-spacing: -0.04em;
    margin: 0;
  }
  .snc-footer--menu-title-btn {
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    cursor: pointer;
    text-align: left;
  }
  .snc-footer--menu-title-btn:focus-visible {
    outline: 2px solid rgba(0, 0, 0, 0.4);
    outline-offset: 2px;
  }
  .snc-footer--menu-toggle-icon {
    display: none;
    margin-left: 8px;
    transition: transform 0.3s ease;
  }
  .snc-footer--menu-toggle-icon svg {
    width: 16px;
    height: 16px;
  }
  .snc-footer--menu-column.is-open .snc-footer--menu-toggle-icon {
    transform: rotate(180deg);
  }
  .snc-footer--menu-column .snc-footer--menu-links {
    transition: max-height 0.3s ease, opacity 0.3s ease;
  }
  .snc-footer--menu-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .snc-footer--menu-link {
    font-size: 16px;
    font-weight: var(--menu-link-weight, 400);
    color: var(--menu-link-color, #000000);
    text-decoration: none;
    transition: opacity 0.2s ease;
    display: block;
  }
  .snc-footer--menu-link:hover {
    opacity: 0.7;
  }
  .snc-footer--contact-item {
    font-family: var(--font-heading-family);
    font-size: 16px;
    font-weight: 400;
    color: #000000;
    text-decoration: none;
    display: block;
    margin-bottom: 8px;
    transition: opacity 0.2s ease;
  }
  .snc-footer--contact-item:hover {
    opacity: 0.7;
  }
  .snc-footer--contact-item:last-child {
    margin-bottom: 0;
  }
  .snc-footer--bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    padding-top: 0;
    border-top: none;
  }
  .snc-footer--newsletter-column {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }
  .snc-footer--credits-left {
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: var(--font-body-family);
    font-size: 12px;
    font-weight: var(--credits-font-weight, 600);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.4);
  }
  .snc-footer--credits-dash {
    width: 30px;
    height: 1px;
    background-color: rgba(0, 0, 0, 0.15);
  }
  .snc-footer--credits-link {
    color: rgba(0, 0, 0, 0.4);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .snc-footer--credits-link:hover {
    color: #000000;
  }
  .snc-footer--credits-right {
    font-size: 12px;
    font-family: var(--font-body-family);
    font-weight: var(--credits-font-weight, 600);
    text-transform: uppercase;
    color: rgba(0, 0, 0, 0.4);
  }
  .snc-footer--logo-text-block {
    display: flex;
    flex-direction: column;
    width: 100%;
  }
  .snc-footer--logo-text-image {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }
  /* ── Tablet (≤900px) ── */
  @media (max-width: 900px) {
    .snc-footer--top-row { flex-direction: column; align-items: flex-start; }
    .snc-footer--logo-newsletter { flex-direction: column; align-items: flex-start; gap: 12px; }
    .snc-footer--social { width: 100%; justify-content: flex-start; gap: 8px; }
    .snc-footer--social-link { width: 34px; height: 34px; }
    .snc-footer--social-icon { width: 17px; height: 17px; }
    .snc-footer--main { padding: 20px 18px 14px; }
    .snc-footer--menus { flex-direction: column; }
    .snc-footer--menu-items {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 0;
    }
    .snc-footer--menu-column {
      overflow: hidden;
      border-bottom: 1px solid rgba(0,0,0,0.07);
      padding-bottom: 0;
      margin-bottom: 0;
    }
    /* Remove border from last 4 children — covers the last visible column (HELP)
       and the 3 empty/hidden columns after it */
    .snc-footer--menu-column:nth-last-child(-n+4) { border-bottom: none; }
    .snc-footer--menu-title-btn { padding: 10px 0; }
    .snc-footer--menu-title { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
    .snc-footer--menu-toggle-icon { display: inline-flex; }
    .snc-footer--menu-toggle-icon svg { width: 11px; height: 11px; }
    .snc-footer--menu-column .snc-footer--menu-links {
      max-height: 0; opacity: 0; overflow: hidden; pointer-events: none;
    }
    .snc-footer--menu-column.is-open .snc-footer--menu-links {
      max-height: 400px; opacity: 1; pointer-events: auto;
    }
    .snc-footer--menu-links { gap: 4px; padding: 4px 0 10px; }
    .snc-footer--menu-link { font-size: 13px; line-height: 1.4; }
    .snc-footer--menu-column.is-empty { display: none; }

    /* Block-level divider: reduce inline-style margin override */
    .snc-footer--divider { margin-top: 14px !important; margin-bottom: 14px !important; }
  }

  /* ── Mobile (≤600px) ── */
  @media (max-width: 600px) {
    .snc-footer { padding: 8px 0; }
    .snc-footer--no-outer { padding: 0; }
    .snc-footer--container { padding: 0 16px; }
    .snc-footer--main { padding: 18px 22px 12px; }

    /* Logo in logo_text block: cap size on mobile */
    .snc-footer--logo-text-image { max-width: 110px !important; width: 110px !important; }

    /* Social — very compact */
    .snc-footer--social { gap: 7px; }
    .snc-footer--social-link { width: 30px; height: 30px; border-width: 1px; }
    .snc-footer--social-icon { width: 14px; height: 14px; }

    /* Newsletter */
    .snc-footer--newsletter { flex-direction: column; align-items: flex-start; gap: 6px; width: 100%; }
    .snc-footer--newsletter.snc-footer--newsletter--inside { width: 100%; }
    .snc-footer--newsletter-input { width: 100%; box-sizing: border-box; font-size: 13px; padding: 7px 0; }

    /* Nav menus — single column */
    .snc-footer--menu-items { grid-template-columns: 1fr; }
    .snc-footer--menu-title-btn { padding: 9px 0; }
    .snc-footer--menu-link { font-size: 12px; }
    .snc-footer--menu-links { gap: 3px; padding: 3px 0 8px; }

    /* Block divider: minimal on mobile */
    .snc-footer--divider { margin-top: 10px !important; margin-bottom: 10px !important; }

    /* Bottom row */
    .snc-footer--bottom-row { flex-direction: column; align-items: flex-start; gap: 4px; }
    .snc-footer--credits-left { font-size: 10px; gap: 6px; }
    .snc-footer--credits-right { font-size: 10px; text-align: left; }
    .snc-footer--credits-dash { width: 14px; }
  }
</style>
{%- assign show_outer = section.settings.show_outer_bg -%}
{%- assign main_bg = section.settings.main_bg_color | default: '#ffffff' -%}
{%- assign outer_bg = section.settings.outer_bg_color | default: '#F1F1F1' -%}
{%- if section.settings.rounded_corners -%}
  {%- assign border_radius = section.settings.border_radius | default: 10 | append: 'px' -%}
{%- else -%}
  {%- assign border_radius = '0px' -%}
{%- endif -%}
<footer
  class="snc-footer full-width{% unless show_outer %} snc-footer--no-outer{% endunless %}"
  data-section-id="{{ section.id }}"
  data-section-type="snc-footer"
  style="background-color: {% if show_outer %}{{ outer_bg }}{% else %}transparent{% endif %};"
>
  <div class="snc-footer--container">
    <div class="snc-footer--main" style="background-color: {{ main_bg }}; border-radius: {{ border_radius }};">
      {%- for block in section.blocks -%}
        <div class="snc-footer--block-wrapper" {{ block.shopify_attributes }}>
          {%- case block.type -%}
            {%- when 'newsletter_social' -%}
              {%- assign social_position = block.settings.social_position | default: 'top' -%}
              <div class="snc-footer--top-row" style="--social-icon-size: {{ block.settings.social_icon_size | default: 26 }}px; --social-container-size: {{ block.settings.social_container_size | default: 50 }}px;">
                <div class="snc-footer--logo-newsletter">
                  {%- if block.settings.show_payment_icons -%}
                    <div class="snc-footer--payment-icons">
                      {%- for type in shop.enabled_payment_types -%}
                        {{ type | payment_type_svg_tag: class: 'icon icon--full-color', height: block.settings.payment_icon_height }}
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>
                <div class="snc-footer--social {% if social_position == 'bottom' %}align-bottom{% endif %}">
                  {%- if settings.social_facebook_link != blank -%}
                    <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener noreferrer" class="snc-footer--social-link" aria-label="Facebook">
                      {%- if settings.social_facebook_icon != blank -%}
                        <img src="{{ settings.social_facebook_icon | image_url: width: 52 }}" alt="Facebook" class="snc-footer--social-icon">
                      {%- else -%}
                        <img src="{{ 'ic_baseline-facebook.svg' | asset_url }}" alt="Facebook" class="snc-footer--social-icon">
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                  {%- if settings.social_instagram_link != blank -%}
                    <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener noreferrer" class="snc-footer--social-link" aria-label="Instagram">
                      {%- if settings.social_instagram_icon != blank -%}
                        <img src="{{ settings.social_instagram_icon | image_url: width: 52 }}" alt="Instagram" class="snc-footer--social-icon">
                      {%- else -%}
                        <img src="{{ 'mingcute_instagram-fill.svg' | asset_url }}" alt="Instagram" class="snc-footer--social-icon">
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                  {%- if settings.social_tiktok_link != blank -%}
                    <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener noreferrer" class="snc-footer--social-link" aria-label="TikTok">
                      {%- if settings.social_tiktok_icon != blank -%}
                        <img src="{{ settings.social_tiktok_icon | image_url: width: 52 }}" alt="TikTok" class="snc-footer--social-icon">
                      {%- else -%}
                        <img src="{{ 'lineicons_tiktok-alt.svg' | asset_url }}" alt="TikTok" class="snc-footer--social-icon">
                      {%- endif -%}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            {%- when 'navigation' -%}
              <div class="snc-footer--menus" style="--menu-title-color: {{ block.settings.menu_title_color }}; --menu-link-color: {{ block.settings.menu_link_color | default: '#000000' }}; --menu-title-weight: {{ block.settings.menu_title_weight | default: 400 }}; --menu-link-weight: {{ block.settings.menu_link_weight | default: 400 }};">
                <div class="snc-footer--menu-items" style="--menu-gap-desktop: {{ block.settings.menu_gap_desktop | default: 30 }}px; --menu-gap-mobile: {{ block.settings.menu_gap_mobile | default: 20 }}px;">
                  {%- for i in (1..6) -%}
                    {%- assign title_key = 'menu' | append: i | append: '_title' -%}
                    {%- assign menu_key = 'menu' | append: i -%}
                    {%- assign menu_id = 'snc-footer-menu-' | append: section.id | append: '-' | append: forloop.index -%}
                    {%- assign menu_handle = block.settings[menu_key] -%}
                    {%- assign has_menu_links = false -%}
                    {%- if menu_handle != blank and linklists[menu_handle] != blank and linklists[menu_handle].links.size > 0 -%}
                      {%- assign has_menu_links = true -%}
                    {%- endif -%}
                    <div class="snc-footer--menu-column{% unless has_menu_links %} is-empty{% endunless %}" data-mobile-collapse>
                      <button type="button" class="snc-footer--menu-title-btn" aria-expanded="false" aria-controls="{{ menu_id }}">
                        <span class="snc-footer--menu-title">{{ block.settings[title_key] }}</span>
                        <span class="snc-footer--menu-toggle-icon" aria-hidden="true">
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 9l6 6 6-6"/>
                          </svg>
                        </span>
                      </button>
                      {%- if block.settings[menu_key] != blank -%}
                        <ul class="snc-footer--menu-links" id="{{ menu_id }}">
                          {%- for link in linklists[block.settings[menu_key]].links -%}
                            <li>
                              <a href="{{ link.url }}" class="snc-footer--menu-link">{{ link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- when 'signature_logo' -%}
              <div class="snc-footer--bottom-row" style="--credits-font-weight: {{ block.settings.credits_font_weight | default: 600 }};">
                {%- if block.settings.credits_name != blank or block.settings.credits_text != blank -%}
                <div class="snc-footer--credits-left">
                  {%- if block.settings.credits_text != blank -%}
                    <span>{{ block.settings.credits_text }}</span>
                  {%- endif -%}
                  {%- if block.settings.credits_text != blank and block.settings.credits_name != blank -%}
                    <span class="snc-footer--credits-dash"></span>
                  {%- endif -%}
                  {%- if block.settings.credits_name != blank -%}
                    {%- if block.settings.credits_link != blank -%}
                      <a href="{{ block.settings.credits_link }}" target="_blank" rel="noopener noreferrer" class="snc-footer--credits-link">
                        {{ block.settings.credits_name }}
                      </a>
                    {%- else -%}
                      <span>{{ block.settings.credits_name }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
                {%- endif -%}
                {%- if block.settings.show_logo -%}
                  {%- assign logo = block.settings.logo -%}
                  {%- assign logo_width = block.settings.logo_width | default: 260 -%}
                  {%- if logo != blank -%}
                    <a href="{{ routes.root_url }}" class="snc-footer--logo {% if block.settings.invert_logo_color %}is-inverted{% endif %}" aria-label="{{ shop.name }}" style="--logo-width: {{ logo_width }}px;">
                      {%- assign logo_width_2x = logo_width | times: 2 -%}
                      {{- logo | image_url: width: logo_width_2x | image_tag: alt: logo.alt | default: shop.name, loading: 'lazy', width: logo_width, height: nil, class: 'snc-footer--logo-img' -}}
                    </a>
                  {%- else -%}
                    <a href="{{ routes.root_url }}" class="snc-footer--logo {% if block.settings.invert_logo_color %}is-inverted{% endif %}" aria-label="{{ shop.name }}">
                      <span style="font-family: var(--font-typos); font-size: 28px; color: {{ block.settings.default_logo_color | default: '#000000' }}; font-weight: 500;">{{ shop.name }}</span>
                    </a>
                  {%- endif -%}
                {%- endif -%}
                <div class="snc-footer--credits-right">
                  {%- assign current_year = 'now' | date: '%Y' -%}
                  {{ block.settings.copyright_text | default: 'TODOS LOS DERECHOS RESERVADOS' }} | {{ current_year }} ©️ {{ block.settings.brand_name | default: shop.name | upcase }}.
                </div>
              </div>
            {%- when 'signature_cards' -%}
              <div class="snc-footer--bottom-row" style="--credits-font-weight: {{ block.settings.credits_font_weight | default: 600 }};">
                {%- if block.settings.credits_text != blank or block.settings.credits_name != blank -%}
                  <div class="snc-footer--credits-left" style="color: {{ block.settings.text_color }};">
                    {%- if block.settings.credits_text != blank -%}
                      <span>{{ block.settings.credits_text }}</span>
                    {%- endif -%}
                    {%- if block.settings.credits_text != blank and block.settings.credits_name != blank -%}
                      <span class="snc-footer--credits-dash" style="background-color: {{ block.settings.text_color }}; opacity: 0.5;"></span>
                    {%- endif -%}
                    {%- if block.settings.credits_name != blank -%}
                      {%- if block.settings.credits_link != blank -%}
                        <a href="{{ block.settings.credits_link }}" target="_blank" rel="noopener noreferrer" class="snc-footer--credits-link" style="color: {{ block.settings.text_color }};">
                          {{ block.settings.credits_name }}
                        </a>
                      {%- else -%}
