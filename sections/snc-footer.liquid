                      </div>
                      <div class="snc-footer--newsletter-error" style="display:none; position:absolute; top:100%; left:0; font-family:var(--font-body-family, sans-serif); font-size:12px; color:#DA4B4B; margin-top:4px; width:100%;" aria-live="polite"></div>
                    </form>
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        </div>
        {%- if block.settings.show_divider and forloop.last == false -%}
