  </div>
</footer>
<script>
(function() {
  function initKlaviyoNewsletterForms() {
    var forms = document.querySelectorAll('[data-klaviyo-newsletter]');
    if (!forms.length) return;

    function getKlaviyoCompanyId(form) {
      // 1. data-company-id on the form (set via theme editor — most reliable)
      if (form && form.dataset.companyId) return form.dataset.companyId;
      // 2. Klaviyo SDK v3+ exposes it on window.klaviyo
      if (window.klaviyo && window.klaviyo.companyId) return window.klaviyo.companyId;
      // 3. Script tag (Klaviyo Shopify app injects klaviyo.js or static-tracking CDN)
      var script = document.querySelector('script[src*="klaviyo.js"], script[src*="static-tracking.klaviyo.com"]');
      if (script) {
        try {
          var id = new URL(script.src).searchParams.get('company_id');
          if (id) return id;
        } catch(e) {}
      }
      return null;
    }

    forms.forEach(function(form) {
      if (form._klaviyoInit) return;
      form._klaviyoInit = true;

      var listId = form.dataset.listId;
      var fieldsEl = form.querySelector('.snc-footer--newsletter-fields');
      var successEl = form.querySelector('.snc-footer--newsletter-success');
      var errorEl = form.querySelector('.snc-footer--newsletter-error');
      var inputEl = form.querySelector('input[type="email"]');
      var btnEl = form.querySelector('button[type="submit"]');

      form.addEventListener('submit', function(e) {
        e.preventDefault();
        var email = inputEl.value.trim();
        if (!email) return;

        btnEl.disabled = true;
        form.classList.add('is-submitting');
        errorEl.style.display = 'none';

        var companyId = getKlaviyoCompanyId(form);

        if (!companyId) {
          if (window._learnq) {
            window._learnq.push(['identify', { '$email': email }]);
            window._learnq.push(['subscribe', { '$email': email, '$list_id': listId }]);
            showSuccess();
          } else {
            showError('Subscription unavailable. Please try again later.');
          }
          return;
        }

        fetch('https://a.klaviyo.com/client/subscriptions/?company_id=' + encodeURIComponent(companyId), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'revision': '2024-02-15' },
          body: JSON.stringify({
            data: {
              type: 'subscription',
              attributes: {
                profile: {
                  data: {
                    type: 'profile',
                    attributes: { email: email }
                  }
                },
                custom_source: 'Footer'
              },
              relationships: {
                list: {
                  data: { type: 'list', id: listId }
                }
              }
            }
          })
        })
        .then(function(res) {
          if (res.ok || res.status === 202) { showSuccess(); return; }
          return res.json().catch(function() { return {}; }).then(function(body) {
            console.error('[De Leville Newsletter] Klaviyo error ' + res.status + ':', JSON.stringify(body));
            throw new Error(res.status);
          });
        })
        .catch(function(err) {
          console.error('[De Leville Newsletter] Submit error:', err);
          showError('Something went wrong. Please try again.');
        });

        function showSuccess() {
          form.classList.remove('is-submitting');
          fieldsEl.style.display = 'none';
          successEl.style.display = 'flex';
        }
        function showError(msg) {
          form.classList.remove('is-submitting');
          errorEl.textContent = msg;
          errorEl.style.display = 'block';
          btnEl.disabled = false;
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKlaviyoNewsletterForms);
  } else {
    initKlaviyoNewsletterForms();
  }
  document.addEventListener('shopify:section:load', initKlaviyoNewsletterForms);
})();
</script>

