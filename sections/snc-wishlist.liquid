<div data-section-type="snc-wishlist" style="margin-top: {{ section.settings.section_margin_top }}px; margin-bottom: {{ section.settings.section_margin_bottom }}px;">
  <h1>{{ section.settings.title }}</h1>
</div>

{% schema %}
{
  "name": "SNC Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "My Favorites"
    },
    {
      "type": "range",
      "id": "section_margin_top",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Margin top",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_margin_bottom",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Margin bottom",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "SNC Wishlist"
    }
  ]
}
{% endschema %}
