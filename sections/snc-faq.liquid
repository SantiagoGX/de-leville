{% schema %}
{
  "name": "SNC FAQ",
  "class": "section--snc-faq",
  "settings": [
    {
      "type": "header",
      "content": "Section Header"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "color",
      "id": "section_title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "section_title_size",
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_title_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Title weight",
      "default": 700
    },
    {
      "type": "range",
      "id": "section_title_margin_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Title bottom margin",
      "default": 20
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Paragraph"
    },
    {
      "type": "color",
      "id": "section_desc_color",
      "label": "Paragraph color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "section_desc_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Paragraph size",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_desc_weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "label": "Paragraph weight",
      "default": 400
    },
    {
      "type": "range",
      "id": "section_desc_margin_bottom",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Paragraph bottom margin",
      "default": 40
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section background color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Maximum accordion width",
      "default": 800
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top margin",
      "default": 40
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom margin",
      "default": 40
    },
    {
      "type": "header",
      "content": "Accordion Style"
    },
    {
      "type": "range",
      "id": "item_padding_vertical",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Inner vertical padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "item_padding_horizontal",
      "min": 5,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Inner horizontal padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Gap between questions",
      "default": 0
    },
    {
      "type": "header",
      "content": "Bottom border"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E5E5E5"
    },
    {
      "type": "header",
      "content": "Typography and Colors"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color (Question)",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Title font size",
      "default": 18
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "min": 300,
      "max": 900,
      "step": 100,
      "label": "Title font weight",
      "default": 600
    },
    {
      "type": "color",
      "id": "content_color",
      "label": "Content color (Answer)",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "content_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Content font size",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Question",
          "default": "Frequently asked question?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Answer",
          "default": "<p>Answer to the frequently asked question.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC FAQ",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item" },
        { "type": "faq_item" }
      ]
    }
  ]
}
{% endschema %}

<style>
  /* Color de fondo aplicado al section real de Shopify */
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_background_color }};
  }

  .snc-faq-section {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
    padding: 0 20px;
  }

  .snc-faq-header {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .snc-faq-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.gap }}px;
  }

  /* Solo borde inferior — sin border-radius ni bordes laterales */
  .snc-faq-item {
    background-color: transparent;
    border: none;
    border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .snc-faq-summary {
    padding: {{ section.settings.item_padding_vertical }}px {{ section.settings.item_padding_horizontal }}px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    color: {{ section.settings.title_color }};
  }

  .snc-faq-summary::-webkit-details-marker {
    display: none;
  }

  .snc-faq-title {
    font-family: var(--font-main);
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    line-height: 1.3;
  }

  .snc-faq-icon {
    transition: transform 0.3s ease;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: 15px;
    color: {{ section.settings.title_color }};
  }

  .snc-faq-item[open] .snc-faq-icon {
    transform: rotate(180deg);
  }

  .snc-faq-content {
    padding: 0 {{ section.settings.item_padding_horizontal }}px {{ section.settings.item_padding_vertical }}px;
    color: {{ section.settings.content_color }};
    font-family: var(--font-main);
    font-size: {{ section.settings.content_font_size }}px;
    line-height: 1.6;
  }

  .snc-faq-content p {
    margin: 0;
  }

  .snc-faq-content p + p {
    margin-top: 10px;
  }

  /* Forzar color sobre estilos del tema */
  .snc-faq-content,
  .snc-faq-content .rte,
  .snc-faq-content .rte p,
  .snc-faq-content .rte a,
  .snc-faq-content .rte li,
  .snc-faq-content p,
  .snc-faq-content a {
    color: {{ section.settings.content_color }} !important;
  }
</style>

<div class="snc-faq-section" data-section-id="{{ section.id }}" data-section-type="snc-faq">
  <div class="snc-faq-header" style="text-align: {{ section.settings.header_alignment }};">
    {%- if section.settings.title != blank -%}
      <h2 class="snc-faq-section-title" style="
        color: {{ section.settings.section_title_color }};
        font-size: {{ section.settings.section_title_size }}px;
        font-weight: {{ section.settings.section_title_weight }};
        margin-bottom: {{ section.settings.section_title_margin_bottom }}px;
        font-family: var(--font-main);
        margin-top: 0;
      ">{{ section.settings.title }}</h2>
    {%- endif -%}
    {%- if section.settings.description != blank -%}
      <div class="snc-faq-section-desc" style="
        color: {{ section.settings.section_desc_color }};
        font-size: {{ section.settings.section_desc_size }}px;
        font-weight: {{ section.settings.section_desc_weight }};
        margin-bottom: {{ section.settings.section_desc_margin_bottom }}px;
        font-family: var(--font-main);
      ">{{ section.settings.description }}</div>
    {%- endif -%}
  </div>
  <div class="snc-faq-container">
    {%- for block in section.blocks -%}
      <details class="snc-faq-item" {{ block.shopify_attributes }}>
        <summary class="snc-faq-summary">
          <span class="snc-faq-title">{{ block.settings.title }}</span>
          <span class="snc-faq-icon">
            <svg width="14" height="9" viewBox="0 0 14 9" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1.5L7 7.5L13 1.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </summary>
        <div class="snc-faq-content">
          <div class="rte">{{ block.settings.content }}</div>
        </div>
      </details>
    {%- endfor -%}
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq_item' -%}
    {
      "@type": "Question",
      "name": {{ block.settings.title | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.content | strip_html | json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
