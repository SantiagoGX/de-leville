<style>
  .snc-contact-form--root {
    --contact-max-width: {{ section.settings.max_width | default: 759 }}px;
    --contact-margin-top: {{ section.settings.margin_top | default: 60 }}px;
    --contact-margin-bottom: {{ section.settings.margin_bottom | default: 60 }}px;
    --contact-padding-x: {{ section.settings.padding_horizontal | default: 20 }}px;
    --contact-text-gap: {{ section.settings.text_gap | default: 40 }}px;
    --contact-subtitle-color: {{ section.settings.subtitle_color | default: '#000000' }};
    --contact-title-color: {{ section.settings.title_color | default: '#000000' }};
    --contact-paragraph-color: {{ section.settings.paragraph_color | default: '#333333' }};
    --contact-form-gap: {{ section.settings.form_gap | default: 15 }}px;
    --contact-field-padding-vertical: {{ section.settings.field_padding_vertical | default: 30 }}px;
    --contact-field-padding-horizontal: {{ section.settings.field_padding_horizontal | default: 25 }}px;
    --contact-field-background: {{ section.settings.field_background | default: '#ffffff' }};
    --contact-field-border-radius: {{ section.settings.field_border_radius | default: 11 }}px;
    --contact-field-border-color: {{ section.settings.field_border_color | default: '#e6e6e6' }};
    --contact-field-focus-border-color: {{ section.settings.field_focus_border_color | default: '#000000' }};
    --contact-button-bg: {{ section.settings.button_bg_color | default: '#000000' }};
    --contact-button-text: {{ section.settings.button_text_color | default: '#ffffff' }};
    --contact-button-radius: {{ section.settings.button_border_radius | default: 8 }}px;
    --contact-separator-color: {{ section.settings.separator_color | default: 'rgba(0, 0, 0, 0.12)' }};
    --contact-info-bg: {{ section.settings.info_background | default: '#ffffff' }};
    --contact-info-gap: {{ section.settings.info_gap | default: 20 }}px;
    --contact-info-subtitle-color: {{ section.settings.info_subtitle_color | default: '#000000' }};
    --contact-info-title-color: {{ section.settings.info_title_color | default: '#000000' }};
    max-width: var(--contact-max-width);
    margin: var(--contact-margin-top) auto var(--contact-margin-bottom);
    padding: 0 var(--contact-padding-x);
    text-align: center;
  }

  .snc-contact-form--text-content {
    margin-bottom: var(--contact-text-gap);
  }

  .snc-contact-form--subtitle {
    color: var(--contact-subtitle-color);
    margin: 0 0 10px 0;
  }

  .snc-contact-form--title {
    color: var(--contact-title-color);
    margin: 0 0 15px 0;
  }

  .snc-contact-form--paragraph {
    color: var(--contact-paragraph-color);
  }

  .snc-contact-form--paragraph p {
    margin: 0;
  }

  .snc-contact-form--form-wrapper .form-errors {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
    border-radius: 8px;
    padding: 15px;
    margin-bottom: 20px;
  }

  .snc-contact-form--form-wrapper form {
    display: flex;
    flex-direction: column;
    gap: var(--contact-form-gap);
  }

  .snc-contact-form--field {
    margin-bottom: 0;
  }

  .snc-contact-form--row {
    display: flex;
    gap: 15px;
    margin-bottom: 0;
  }

  .snc-contact-form--row .snc-contact-form--field {
    flex: 1;
    margin-bottom: 0;
  }

  .snc-contact-form--field label {
    display: none;
  }

  .snc-contact-form--field input,
  .snc-contact-form--field textarea {
    width: 100%;
    padding: var(--contact-field-padding-vertical) var(--contact-field-padding-horizontal);
    background-color: var(--contact-field-background);
    border-radius: var(--contact-field-border-radius);
    border: 1px solid var(--contact-field-border-color);
    font-family: var(--font-body-family);
    font-size: 1.6rem;
    box-sizing: border-box;
    transition: border-color 0.2s ease;
    margin: 0 !important;
  }

  .snc-contact-form--field input:focus,
  .snc-contact-form--field textarea:focus {
    outline: none;
    border-color: var(--contact-field-focus-border-color);
  }

  .snc-contact-form--submit {
    text-align: right;
    margin-top: 0;
  }

  .snc-contact-form--button {
    background-color: var(--contact-button-bg);
    color: var(--contact-button-text);
    border: none;
    padding: 14px 30px;
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    cursor: pointer;
    border-radius: var(--contact-button-radius);
    transition: opacity 0.2s ease;
  }

  .snc-contact-form--button:hover {
    opacity: 0.85;
  }

  .snc-contact-form--separator {
    height: 1px;
    background-color: var(--contact-separator-color);
    margin: 30px 0;
    width: 100%;
  }

  .snc-contact-form--info-bar {
    background-color: var(--contact-info-bg);
    border-radius: 10px;
    padding: 36px 45px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    text-align: left;
    gap: var(--contact-info-gap);
  }

  .snc-contact-form--info-col {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .snc-contact-form--info-subtitle {
    color: var(--contact-info-subtitle-color);
  }

  .snc-contact-form--info-title {
    color: var(--contact-info-title-color);
  }

  @media (max-width: 768px) {
    
    .snc-contact-form--row {
      flex-direction: column;
    }
    
    .snc-contact-form--info-bar {
      flex-direction: column;
      padding: 20px;
      gap: 30px;
    }
  }
</style>

<div class="snc-contact-form--root color-{{ section.settings.color_scheme }}">
  <div class="snc-contact-form--text-content">
    {%- if section.settings.subtitle != blank -%}
      <p class="snc-contact-form--subtitle {{ section.settings.subtitle_style }}">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="snc-contact-form--title {{ section.settings.title_style }}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="snc-contact-form--paragraph {{ section.settings.text_style }}">{{ section.settings.text }}</div>
    {%- endif -%}
  </div>

  <div class="snc-contact-form--form-wrapper">
    {%- form 'contact' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-success">Thank you for contacting us! We will get back to you soon.</p>
      {%- endif -%}
      {{ form.errors | default_errors }}

      <div class="snc-contact-form--row">
        <div class="snc-contact-form--field">
          <label for="ContactForm-name-{{ section.id }}">Name</label>
          <input type="text" id="ContactForm-name-{{ section.id }}" name="contact[name]" value="{{ form.name }}" placeholder="Name" required>
        </div>

        <div class="snc-contact-form--field">
          <label for="ContactForm-email-{{ section.id }}">Email</label>
          <input type="email" id="ContactForm-email-{{ section.id }}" name="contact[email]" value="{{ form.email }}" placeholder="Email" required>
        </div>
      </div>

      <div class="snc-contact-form--field">
        <label for="ContactForm-body-{{ section.id }}">Message</label>
        <textarea rows="5" id="ContactForm-body-{{ section.id }}" name="contact[body]" placeholder="Message" required>{{ form.body }}</textarea>
      </div>

      <div class="snc-contact-form--submit">
        <button type="submit" class="snc-contact-form--button">Send</button>
      </div>
    {%- endform -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="snc-contact-form--separator"></div>
    <div class="snc-contact-form--info-bar">
      {%- for block in section.blocks -%}
        <div class="snc-contact-form--info-col" {{ block.shopify_attributes }}>
          {%- if block.settings.subtitle != blank -%}
            <div class="snc-contact-form--info-subtitle {{ section.settings.info_subtitle_style }}">{{ block.settings.subtitle | escape }}</div>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <div class="snc-contact-form--info-title {{ section.settings.info_title_style }}">{{ block.settings.title | escape }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "SNC Contact Form",
  "class": "snc-contact-form",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "CONTACT US"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "We are here to help"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text / Paragraph",
      "default": "<p>If you have any questions, don't hesitate to contact us. Fill out the form and we will get back to you as soon as possible.</p>"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "subtitle_style",
      "label": "Subtitle style",
      "options": [
        { "value": "h1", "label": "Main title" },
        { "value": "h2", "label": "Secondary title" },
        { "value": "h3", "label": "Small title" },
        { "value": "body", "label": "Paragraph" },
        { "value": "small", "label": "Small paragraph" },
        { "value": "emphasis", "label": "Emphasis" }
      ],
      "default": "emphasis"
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "Title style",
      "options": [
        { "value": "h1", "label": "Main title" },
        { "value": "h2", "label": "Secondary title" },
        { "value": "h3", "label": "Small title" }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "text_style",
      "label": "Text style",
      "options": [
        { "value": "body", "label": "Paragraph" },
        { "value": "small", "label": "Small paragraph" },
        { "value": "h3", "label": "Small title" }
      ],
      "default": "body"
    },
    {
      "type": "header",
      "content": "Styles"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Max block width",
      "min": 480,
      "max": 1200,
      "step": 8,
      "unit": "px",
      "default": 760
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Top margin",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Bottom margin",
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Top text gap",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "form_gap",
      "label": "Form gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "Paragraph color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "field_padding_vertical",
      "label": "Fields vertical padding",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "field_padding_horizontal",
      "label": "Fields horizontal padding",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 25
    },
    {
      "type": "color",
      "id": "field_background",
      "label": "Fields background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "field_border_radius",
      "label": "Fields border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "color",
      "id": "field_border_color",
      "label": "Fields border color",
      "default": "#e6e6e6"
    },
    {
      "type": "color",
      "id": "field_focus_border_color",
      "label": "Fields focus border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Button background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Button border radius",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator color",
      "default": "rgba(42, 68, 50, 0.2)"
    },
    {
      "type": "color",
      "id": "info_background",
      "label": "Info bar background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "info_gap",
      "label": "Info columns gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "info_subtitle_color",
      "label": "Info subtitle color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "info_title_color",
      "label": "Info title color",
      "default": "#000000"
    },
    {
      "type": "select",
      "id": "info_subtitle_style",
      "label": "Info subtitle style",
      "options": [
        { "value": "body", "label": "Paragraph" },
        { "value": "small", "label": "Small paragraph" },
        { "value": "h3", "label": "Small title" }
      ],
      "default": "body"
    },
    {
      "type": "select",
      "id": "info_title_style",
      "label": "Info title style",
      "options": [
        { "value": "h3", "label": "Small title" },
        { "value": "body", "label": "Paragraph" },
        { "value": "emphasis", "label": "Emphasis" }
      ],
      "default": "h3"
    }
  ],
  "blocks": [
    {
      "type": "info_column",
      "name": "Info column",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Subtitle"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC Contact Form",
      "blocks": [
        {
          "type": "info_column",
          "settings": {
            "subtitle": "Call us",
            "title": "+52 123 456 7890"
          }
        },
        {
          "type": "info_column",
          "settings": {
            "subtitle": "Email us",
            "title": "hello@deleville.com"
          }
        },
        {
          "type": "info_column",
          "settings": {
            "subtitle": "Visit us",
            "title": "Michoacan, Mexico"
          }
        }
      ]
    }
  ]
}
{% endschema %}
