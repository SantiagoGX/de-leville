<style>
  .snc-waitlist--root {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background-color: {{ section.settings.background_color }};
  }

  /* ── Hero mode (with image) ── */
  .snc-waitlist--root.has-image {
    min-height: {{ section.settings.height_vh }}vh;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
  }

  .snc-waitlist--bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .snc-waitlist--bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ section.settings.image_position }};
    display: block;
  }

  .snc-waitlist--overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.30) 0%,
      transparent 35%,
      rgba(0, 0, 0, 0.40) 60%,
      rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }}) 100%
    );
  }

  /* ── Content ── */
  .snc-waitlist--content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .snc-waitlist--root.has-image .snc-waitlist--content {
    padding: 0 24px {{ section.settings.padding_bottom }}px;
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--content {
    padding: {{ section.settings.padding_top }}px 24px {{ section.settings.padding_bottom }}px;
  }

  .snc-waitlist--inner {
    max-width: 560px;
    margin: 0 auto;
  }

  /* ── Typography ── */
  .snc-waitlist--overline {
    font-family: 'Futura PT', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    margin: 0 0 20px;
  }

  .snc-waitlist--root.has-image .snc-waitlist--overline {
    color: rgba(255, 255, 255, 0.65);
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--overline {
    color: {{ section.settings.muted_color }};
  }

  .snc-waitlist--title {
    font-family: 'Futura PT', sans-serif;
    font-size: {{ section.settings.title_size }}px;
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    text-wrap: balance;
  }

  .snc-waitlist--root.has-image .snc-waitlist--title {
    color: #ffffff;
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--title {
    color: {{ section.settings.title_color }};
  }

  .snc-waitlist--description {
    font-family: 'Futura PT', sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: -0.02em;
    max-width: 400px;
    margin: 0 auto 36px;
  }

  .snc-waitlist--root.has-image .snc-waitlist--description {
    color: rgba(255, 255, 255, 0.72);
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--description {
    color: {{ section.settings.muted_color }};
  }

  /* ── Form ── */
  .snc-waitlist--form {
    display: flex;
    gap: 8px;
    max-width: 460px;
    margin: 0 auto;
  }

  .snc-waitlist--input {
    flex: 1;
    height: 50px;
    padding: 0 22px;
    font-family: 'Futura PT', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    border-radius: 999px;
    outline: none;
    transition: border-color 0.2s ease;
    -webkit-appearance: none;
    appearance: none;
    box-sizing: border-box;
  }

  .snc-waitlist--root.has-image .snc-waitlist--input {
    background: rgba(255, 255, 255, 0.10);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }

  .snc-waitlist--root.has-image .snc-waitlist--input::placeholder {
    color: rgba(255, 255, 255, 0.50);
  }

  .snc-waitlist--root.has-image .snc-waitlist--input:focus {
    border-color: rgba(255, 255, 255, 0.80);
    background: rgba(255, 255, 255, 0.15);
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--input {
    background: {{ section.settings.input_bg }};
    border: 1px solid {{ section.settings.input_border_color }};
    color: {{ section.settings.title_color }};
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--input::placeholder {
    color: {{ section.settings.muted_color }};
    opacity: 0.6;
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--input:focus {
    border-color: {{ section.settings.title_color }};
  }

  .snc-waitlist--btn {
    flex-shrink: 0;
    height: 50px;
    padding: 0 28px;
    font-family: 'Futura PT', sans-serif;
    font-size: 12px;
    font-weight: 100;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .snc-waitlist--root.has-image .snc-waitlist--btn {
    background: #ffffff;
    color: #111111;
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--btn {
    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
  }

  .snc-waitlist--btn:hover {
    opacity: 0.78;
  }

  /* ── Disclaimer / success / error ── */
  .snc-waitlist--disclaimer {
    margin-top: 14px;
    font-family: 'Futura PT', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.06em;
  }

  .snc-waitlist--root.has-image .snc-waitlist--disclaimer {
    color: rgba(255, 255, 255, 0.38);
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--disclaimer {
    color: {{ section.settings.muted_color }};
    opacity: 0.55;
  }

  .snc-waitlist--success {
    font-family: 'Futura PT', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.06em;
    padding: 16px 0;
  }

  .snc-waitlist--root.has-image .snc-waitlist--success {
    color: rgba(255, 255, 255, 0.80);
  }

  .snc-waitlist--root:not(.has-image) .snc-waitlist--success {
    color: {{ section.settings.muted_color }};
  }

  .snc-waitlist--error-msg {
    margin-top: 10px;
    font-family: 'Futura PT', sans-serif;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: #e05555;
    min-height: 16px;
  }

  /* ─────────────────────────────────────────
     MOBILE — primary breakpoint
     font-size: 16px on inputs prevents iOS zoom-on-focus
     100svh = small viewport height (excludes browser chrome on mobile)
  ───────────────────────────────────────── */
  @media (max-width: 767px) {
    .snc-waitlist--root.has-image {
      min-height: 100vh;
      min-height: 100svh;
    }

    .snc-waitlist--root.has-image .snc-waitlist--content {
      padding: 0 20px 52px;
    }

    .snc-waitlist--bg img {
      object-position: {{ section.settings.mobile_image_position }};
    }

    .snc-waitlist--overline {
      margin-bottom: 14px;
    }

    .snc-waitlist--title {
      font-size: {{ section.settings.title_size | times: 0.65 | round }}px;
      letter-spacing: -0.01em;
    }

    .snc-waitlist--description {
      font-size: 14px;
      max-width: 100%;
      margin-bottom: 28px;
    }

    .snc-waitlist--form {
      flex-direction: column;
      gap: 10px;
      max-width: 100%;
    }

    .snc-waitlist--input {
      height: 54px;
      font-size: 16px;
      text-align: center;
    }

    .snc-waitlist--btn {
      width: 100%;
      height: 54px;
      font-size: 13px;
    }

    .snc-waitlist--disclaimer {
      margin-top: 12px;
    }
  }
</style>

{%- assign has_image = false -%}
{%- if section.settings.image != blank -%}
  {%- assign has_image = true -%}
{%- endif -%}

<div class="snc-waitlist--root{% if has_image %} has-image{% endif %}"{% if has_image %} data-header-theme="light"{% endif %}>

  {%- if has_image -%}
    <div class="snc-waitlist--bg">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000',
          sizes: '100vw'
      }}
    </div>
    <div class="snc-waitlist--overlay"></div>
  {%- endif -%}

  <div class="snc-waitlist--content">
    <div class="snc-waitlist--inner">

      {%- if section.settings.overline != blank -%}
        <p class="snc-waitlist--overline">{{ section.settings.overline | escape }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h2 class="snc-waitlist--title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="snc-waitlist--description">{{ section.settings.description | escape }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'snc-waitlist-{{ section.id }}' -%}
        {%- if form.posted_successfully? -%}
          <p class="snc-waitlist--success">{{ section.settings.success_message | escape }}</p>
        {%- else -%}
          <div class="snc-waitlist--form">
            <input type="hidden" name="contact[tags]" value="newsletter,leather-waitlist">
            <input
              type="email"
              name="contact[email]"
              id="snc-waitlist-email-{{ section.id }}"
              class="snc-waitlist--input"
              placeholder="{{ section.settings.placeholder | escape }}"
              autocomplete="email"
              required
              aria-label="{{ section.settings.placeholder | escape }}"
            >
            <button type="submit" class="snc-waitlist--btn">
              {{ section.settings.button_label | escape }}
            </button>
          </div>

          {%- if form.errors -%}
            <p class="snc-waitlist--error-msg">
              {%- for field in form.errors -%}
                {{ form.errors.messages[field] }}{% unless forloop.last %}, {% endunless %}
              {%- endfor -%}
            </p>
          {%- endif -%}

          {%- if section.settings.disclaimer != blank -%}
            <p class="snc-waitlist--disclaimer">{{ section.settings.disclaimer | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "SNC Waitlist",
  "class": "snc-waitlist",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "bottom center", "label": "Bottom" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" }
      ],
      "default": "center center"
    },
    {
      "type": "select",
      "id": "mobile_image_position",
      "label": "Image position (mobile)",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "top center", "label": "Top" },
        { "value": "center left", "label": "Left" },
        { "value": "center right", "label": "Right" },
        { "value": "60% center", "label": "Right-center" },
        { "value": "40% center", "label": "Left-center" }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "height_vh",
      "label": "Hero height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay darkness",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 55
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "overline",
      "label": "Overline",
      "default": "Leather Goods"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "First Access, Yours."
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 24,
      "max": 72,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Be among the first to discover De Leville leather — crafted in Italy, arriving soon."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the Waitlist"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "You are on the list. We will be in touch."
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "No spam, ever."
    },
    {
      "type": "header",
      "content": "Colors (no-image mode)"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#767676"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "Input background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input border",
      "default": "#d8d8d8"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (no-image mode)",
      "min": 40,
      "max": 200,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "SNC Waitlist"
    }
  ]
}
{% endschema %}
