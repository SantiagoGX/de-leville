{%- liquid
  assign show_arrows = section.settings.show_arrows
  assign show_dots = section.settings.show_dots
  assign autoplay = section.settings.autoplay
  assign autoplay_speed = section.settings.autoplay_speed | default: 5000
  assign full_width = section.settings.full_width
  assign animation_type = section.settings.animation_type
-%}

<style>
  .snc-hero-slider--full-bleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }

  .snc-hero-slider--root {
    --slider-height-desktop: {{ section.settings.height_desktop | default: 80 }}vh;
    --slider-height-mobile: {{ section.settings.height_mobile | default: 60 }}vh;
    position: relative;
    width: 100%;
    height: var(--slider-height-desktop);
    overflow: hidden;
  }

  .snc-hero-slider--track-wrapper {
    width: 100%;
    height: 100%;
  }

  .snc-hero-slider--track {
    display: flex;
    height: 100%;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .snc-hero-slider--slide {
    width: 100%;
    height: 100%;
    flex-shrink: 0;
    position: relative;
    background-color: #f5f5f5;
    display: flex;
    flex-direction: column;
  }

  .snc-hero-slider--media {
    position: relative;
    width: 100%;
    height: var(--slider-height-desktop);
    flex-shrink: 0;
  }

  .snc-hero-slider--image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }

  .snc-hero-slider--content-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    padding: 40px;
    box-sizing: border-box;
    text-align: var(--text-align);
    color: var(--text-color);
  }

  /* Overlay Mode */
  .snc-hero-slider--slide[data-content-position="overlay"] .snc-hero-slider--content-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
  }

  /* Below Mode */
  .snc-hero-slider--slide[data-content-position="below"] .snc-hero-slider--content-wrapper {
    position: relative;
    height: auto;
    background-color: var(--bg-color, #ffffff);
    flex: 1;
  }

  .snc-hero-slider--content-wrapper[data-vertical="top"] { justify-content: flex-start; }
  .snc-hero-slider--content-wrapper[data-vertical="middle"] { justify-content: center; }
  .snc-hero-slider--content-wrapper[data-vertical="bottom"] { justify-content: flex-end; }
  .snc-hero-slider--content-wrapper[data-horizontal="left"] { align-items: flex-start; --text-align: left; }
  .snc-hero-slider--content-wrapper[data-horizontal="center"] { align-items: center; --text-align: center; }
  .snc-hero-slider--content-wrapper[data-horizontal="right"] { align-items: flex-end; --text-align: right; }

  .snc-hero-slider--heading {
    font-size: 48px;
    color: #fff;
    color: inherit;
    margin: 0 0 15px 0;
  }

  .snc-hero-slider--subheading {
    font-size: 18px;
    color: #fff;
    color: inherit;
    margin: 0;
    max-width: 600px;
  }

  .snc-hero-slider--button {
    text-decoration: none;
    display: inline-block;
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: var(--btn-border-width) solid var(--btn-border-color);
    padding: var(--btn-padding-y) var(--btn-padding-x);
    margin-top: var(--btn-margin-top);
    border-radius: 50px;
    transition: opacity 0.2s ease;
  }

  .snc-hero-slider--button:hover {
    opacity: 0.8;
  }

  .snc-hero-slider--nav {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .snc-hero-slider--dots {
    display: flex;
    gap: 10px;
  }

  .snc-hero-slider--dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.5);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 0.3s;
  }

  .snc-hero-slider--dot.is-active {
    background: #fff;
  }

  .snc-hero-slider--arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.7);
    border: none;
    border-radius: 50%;
    width: 44px;
    height: 44px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .snc-hero-slider--arrow:hover {
    background: #fff;
  }
  .snc-hero-slider--arrow.prev { left: 30px; }
  .snc-hero-slider--arrow.next { right: 30px; }
  .snc-hero-slider--arrow svg {
    width: 20px;
    height: 20px;
    stroke: #333;
  }

  @media (max-width: 768px) {
    .snc-hero-slider--root {
      height: var(--slider-height-mobile);
    }
    .snc-hero-slider--media {
      height: var(--slider-height-mobile);
    }
    .snc-hero-slider--heading { font-size: 32px; }
    .snc-hero-slider--subheading { font-size: 16px; }
    .snc-hero-slider--content-wrapper { padding: 20px; }
    .snc-hero-slider--arrow { display: none; }
  }

  /* Animación Fade */
  .snc-hero-slider--root[data-animation="fade"] .snc-hero-slider--track {
    display: block;
    position: relative;
    display: grid;
    grid-template-areas: "stack";
    transform: none !important;
  }

  .snc-hero-slider--root[data-animation="fade"] .snc-hero-slider--slide {
    position: absolute;
    top: 0;
    left: 0;
    grid-area: stack;
    position: relative;
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
    z-index: 1;
    pointer-events: none;
  }

  .snc-hero-slider--root[data-animation="fade"] .snc-hero-slider--slide.is-active {
    opacity: 1;
    z-index: 2;
    pointer-events: auto;
  }

  .snc-hero-slider--overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }
</style>

<div class="{% if full_width %}snc-hero-slider--full-bleed{% endif %}">
<div class="snc-hero-slider--root" data-section-id="{{ section.id }}" data-section-type="snc-hero-slider" data-autoplay="{{ autoplay }}" data-speed="{{ autoplay_speed }}" data-animation="{{ animation_type }}">
  <div class="snc-hero-slider--track-wrapper">
    <div class="snc-hero-slider--track">
      {%- for block in section.blocks -%}
        <div class="snc-hero-slider--slide" {{ block.shopify_attributes }} data-content-position="{{ block.settings.content_position | default: 'overlay' }}">
          <div class="snc-hero-slider--media">
            {%- assign image_desktop = block.settings.image_desktop -%}
            {%- assign image_mobile = block.settings.image_mobile -%}
            {%- if image_desktop != blank or image_mobile != blank -%}
              <picture>
                {%- if image_mobile != blank -%}
                  <source media="(max-width: 768px)" srcset="{{ image_mobile | image_url: width: 768 }}">
                {%- endif -%}
                {%- assign image_to_render = image_desktop | default: image_mobile -%}
                {%- assign image_height = 1080 -%}
                {%- if image_to_render.aspect_ratio != 0 and image_to_render.aspect_ratio != nil -%}
                  {%- assign image_height = 1920 | divided_by: image_to_render.aspect_ratio | round -%}
                {%- endif -%}
                <img src="{{ image_to_render | image_url: width: 1920 }}" alt="{{ block.settings.heading | escape }}" class="snc-hero-slider--image" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="1920" height="{{ image_height }}" style="filter: brightness({{ block.settings.image_brightness | default: 100 }}%);">
              </picture>
            {%- endif -%}
            {%- if block.settings.overlay_type != 'none' -%}
              <div class="snc-hero-slider--overlay" style="
                {%- if block.settings.overlay_type == 'solid' -%}
                  background-color: {{ block.settings.overlay_color }};
                  opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
                {%- elsif block.settings.overlay_type == 'gradient' -%}
                  background: linear-gradient({{ block.settings.gradient_direction }}, {{ block.settings.overlay_color }} 0%, transparent 100%);
                  opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
                {%- endif -%}
              "></div>
            {%- endif -%}
          </div>

          <div 
            class="snc-hero-slider--content-wrapper" 
            data-vertical="{{ block.settings.content_vertical_alignment }}"
            data-horizontal="{{ block.settings.content_horizontal_alignment }}"
            style="--text-color: {{ block.settings.text_color }}; --bg-color: {{ block.settings.bg_color }};"
          >
            {%- if block.settings.heading != blank -%}
              <h2 class="snc-hero-slider--heading">{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.subheading != blank -%}
              <div class="snc-hero-slider--subheading">{{ block.settings.subheading }}</div>
            {%- endif -%}
            {%- if block.settings.button_text != blank and block.settings.button_link != blank -%}
              <a 
                href="{{ block.settings.button_link }}" 
                class="snc-hero-slider--button"
                style="
                  --btn-bg: {{ block.settings.button_bg_color }};
                  --btn-text: {{ block.settings.button_text_color }};
                  --btn-border-color: {{ block.settings.button_border_color }};
                  --btn-border-width: {{ block.settings.button_border_width }}px;
                  --btn-padding-x: {{ block.settings.button_padding_x }}px;
                  --btn-padding-y: {{ block.settings.button_padding_y }}px;
                  --btn-margin-top: {{ block.settings.button_margin_top }}px;
                "
              >
                {{ block.settings.button_text | escape }}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if section.blocks.size > 1 -%}
    {%- if show_arrows -%}
      <button class="snc-hero-slider--arrow prev" aria-label="Anterior">
        <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <button class="snc-hero-slider--arrow next" aria-label="Siguiente">
        <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    {%- endif -%}

    {%- if show_dots -%}
      <div class="snc-hero-slider--nav">
        <div class="snc-hero-slider--dots">
          {%- for block in section.blocks -%}
            <button class="snc-hero-slider--dot{% if forloop.first %} is-active{% endif %}" data-slide-to="{{ forloop.index0 }}"></button>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>
</div>


{% schema %}
{
  "name": "SNC Hero Slider",
  "tag": "section",
  "class": "snc-hero-slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Ancho completo",
      "default": true
    },
    {
      "type": "header",
      "content": "Dimensiones"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Altura en desktop",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 80
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height on mobile",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 60
    },
    {
      "type": "header",
      "content": "Navegación y Autoplay"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show navigation dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Velocidad de Autoplay",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms",
      "default": 5000
    },
    {
      "type": "select",
      "id": "animation_type",
      "label": "Animation type",
      "options": [
        { "value": "slide", "label": "Slide" },
        { "value": "fade", "label": "Fade" }
      ],
      "default": "slide"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "limit": 5,
      "settings": [
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Imagen (Desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (Mobile)",
          "info": "Opcional. Si se deja vacía, se usará la imagen de desktop."
        },
        {
          "type": "range",
          "id": "image_brightness",
          "label": "Brillo de la imagen",
          "min": 50,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 100
        },
        {
          "type": "header",
          "content": "Superposición (Overlay)"
        },
        {
          "type": "select",
          "id": "overlay_type",
          "label": "Overlay type",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "solid", "label": "Solid" },
            { "value": "gradient", "label": "Gradient" }
          ],
          "default": "none"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay opacity",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 30
        },
        {
          "type": "select",
          "id": "gradient_direction",
          "label": "Gradient direction",
          "options": [
            { "value": "to bottom", "label": "Downward" },
            { "value": "to top", "label": "Upward" },
            { "value": "to right", "label": "To the right" },
            { "value": "to left", "label": "To the left" }
          ],
          "default": "to bottom",
          "info": "Solo aplica si el tipo es 'Degradado'"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            { "value": "overlay", "label": "Over the image" },
            { "value": "below", "label": "Below the image" }
          ],
          "default": "overlay"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Background color (only if below)",
          "default": "#FFFFFF"
        },
        {
          "type": "header",
          "content": "Contenido"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Title",
          "default": "Hero Title"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Color del texto",
          "default": "#FFFFFF"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subtitle",
          "default": "<p>Describe your slide here. Use concise, compelling text.</p>"
        },
        {
          "type": "select",
          "id": "content_horizontal_alignment",
          "label": "Horizontal content alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "content_vertical_alignment",
          "label": "Vertical content alignment",
          "options": [
            { "value": "top", "label": "Top" },
            { "value": "middle", "label": "Middle" },
            { "value": "bottom", "label": "Bottom" }
          ],
          "default": "middle"
        },
        {
          "type": "header",
          "content": "Botón"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "View more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "Button background color",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button text color",
          "default": "#000000"
        },
        {
          "type": "color",
          "id": "button_border_color",
          "label": "Button border color",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "button_border_width",
          "label": "Ancho del borde",
          "min": 0,
          "max": 5,
          "step": 1,
          "unit": "px",
          "default": 1
        },
        {
          "type": "range",
          "id": "button_padding_y",
          "label": "Padding vertical (arriba/abajo)",
          "min": 5,
          "max": 30,
          "step": 1,
          "unit": "px",
          "default": 12
        },
        {
          "type": "range",
          "id": "button_padding_x",
          "label": "Padding horizontal (lados)",
          "min": 10,
          "max": 50,
          "step": 1,
          "unit": "px",
          "default": 24
        },
        {
          "type": "range",
          "id": "button_margin_top",
          "label": "Margen superior (distancia del texto)",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "px",
          "default": 30
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SNC Hero Slider",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
